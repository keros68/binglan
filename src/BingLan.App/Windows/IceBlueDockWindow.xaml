<Window x:Class="BingLan.App.Windows.IceBlueDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="冰蓝 Dock"
        Width="180"
        Height="104"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        AllowDrop="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="DockItemButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="HoverPlate"
                                        CornerRadius="11"
                                        BorderThickness="1"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource DockItemHoverBrush}"/>
                                <Setter TargetName="HoverPlate" Property="BorderBrush" Value="{DynamicResource DockItemHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource DockItemPressedBrush}"/>
                                <Setter TargetName="HoverPlate" Property="BorderBrush" Value="{DynamicResource DockItemHoverBorderBrush}"/>
                                <Setter TargetName="Shell" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="DockSurface"
            VerticalAlignment="Bottom"
            Padding="0"
            ClipToBounds="False"
            Background="{DynamicResource DockSurfaceBrush}"
            BorderBrush="{DynamicResource DockSurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            AllowDrop="True"
            MouseRightButtonUp="OnDockSurfaceRightClick">
        <Grid ClipToBounds="False">
            <!-- 玻璃质感 1：极淡对角反光渐变（冻结画刷，零 Effect） -->
            <Border x:Name="DockDiagonalSheen"
                    IsHitTestVisible="False"
                    CornerRadius="17"
                    Background="{DynamicResource DockDiagonalSheenBrush}"/>
            <!-- 玻璃质感 2：内侧极淡内阴影 / 下沿暗边 -->
            <Border x:Name="DockInnerShadow"
                    IsHitTestVisible="False"
                    CornerRadius="17"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DockInnerShadowBrush}"/>
            <!-- 玻璃质感 3：顶部 1px 镜面高光（上亮下透线性渐变描边） -->
            <Border x:Name="DockSpecularRim"
                    IsHitTestVisible="False"
                    CornerRadius="17"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DockSpecularRimBrush}"/>
            <Border x:Name="DockContentHost"
                    Padding="14,5"
                    ClipToBounds="False">
                <ScrollViewer x:Name="ItemScroller"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ItemPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
