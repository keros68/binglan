<local:WidgetWindowBase x:Class="BingLan.App.Windows.FileBoxWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:BingLan.App.Windows"
                        Title="桌面分组盒"
                        Width="366"
                        Height="306"
                        MinWidth="226"
                        MinHeight="166"
                        WindowStyle="None"
                        ResizeMode="CanResize"
                        AllowsTransparency="True"
                        Background="Transparent"
                        ShowInTaskbar="False"
                        AllowDrop="True"
                        DragOver="Window_DragOver"
                        Drop="Window_Drop"
                        FontFamily="{StaticResource UiFont}"
                        Foreground="{DynamicResource PrimaryTextBrush}">
    <local:WidgetWindowBase.Resources>
        <ItemsPanelTemplate x:Key="FileTilePanelTemplate">
            <local:TileGridPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="FileListPanelTemplate">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <!-- Shared by every tile; the menu targets whichever tile right-clicked it, and a
             right click inside a multi-selection swaps in the batch menu instead. -->
        <ContextMenu x:Key="FileTileContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="FileTileContextMenu_Opened">
            <MenuItem Header="打开" Click="OpenFile_Click"/>
            <MenuItem Header="打开所在位置" Click="OpenFileLocation_Click"/>
            <MenuItem Header="复制" InputGestureText="Ctrl+C" Click="CopyFile_Click"/>
            <MenuItem Header="刷新图标" Click="RefreshIcon_Click"/>
            <Separator/>
            <MenuItem Header="上移" Click="MoveMappingUp_Click"/>
            <MenuItem Header="下移" Click="MoveMappingDown_Click"/>
            <Separator/>
            <MenuItem Header="修改显示名称…" Click="RenameMapping_Click"/>
            <MenuItem Header="转移到其他分组盒"/>
            <MenuItem Header="重新定位…">
                <MenuItem Header="选择文件…" Click="RelinkFile_Click"/>
                <MenuItem Header="选择文件夹…" Click="RelinkFolder_Click"/>
            </MenuItem>
            <MenuItem Header="移除映射" Click="RemoveMapping_Click"/>
            <Separator Tag="DeleteOriginal"/>
            <MenuItem Header="删除到回收站…" Tag="DeleteOriginal" Click="DeleteOriginal_Click"/>
        </ContextMenu>

        <!-- Acts on the whole selection; headers are filled in when the menu opens. -->
        <ContextMenu x:Key="FileTileBatchContextMenu"
                     Opened="FileTileBatchContextMenu_Opened">
            <MenuItem Header="复制" InputGestureText="Ctrl+C" Click="BatchCopyFiles_Click"/>
            <MenuItem Header="移除映射" Tag="BatchRemove" Click="BatchRemoveMappings_Click"/>
            <MenuItem Header="转移到其他分组盒" Tag="BatchTransfer"/>
            <Separator Tag="DeleteOriginal"/>
            <MenuItem Header="删除到回收站…" Tag="DeleteOriginal" Click="BatchDeleteOriginals_Click"/>
            <Separator/>
            <MenuItem Header="取消选中" Click="ClearSelection_Click"/>
        </ContextMenu>

        <!-- 图标视图：大图标在上、名称在下，按宽度折行。 -->
        <DataTemplate x:Key="FileTileTemplate">
            <Button Height="92"
                    Margin="3"
                    Padding="0"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.HelpText="{Binding Path}"
                    Background="Transparent"
                    BorderThickness="0"
                    PreviewMouseLeftButtonDown="FileTile_PreviewMouseLeftButtonDown"
                    PreviewMouseRightButtonDown="FileTile_PreviewMouseRightButtonDown"
                    PreviewMouseMove="FileTile_PreviewMouseMove"
                    Click="FileTile_Click"
                    ContextMenu="{StaticResource FileTileContextMenu}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileSurface"
                                Tag="Interactive"
                                Height="92"
                                Padding="6"
                                Background="Transparent"
                                BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                                BorderThickness="{DynamicResource WidgetTileBorderThickness}"
                                CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileSurface" Property="Background" Value="{DynamicResource CardInteractiveHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileSurface" Property="Background" Value="{DynamicResource CardInteractivePressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileSurface" Property="BorderBrush" Value="{DynamicResource CardFocusBorderBrush}"/>
                                <Setter TargetName="TileSurface" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 选中高亮垫在内容之下，与悬停/焦点背景互不争用同一属性。 -->
                    <Border x:Name="SelectionHighlight"
                            Grid.RowSpan="2"
                            Background="{DynamicResource CardInteractiveSelectedBrush}"
                            BorderBrush="{DynamicResource CardSelectionBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                    <Image x:Name="TileIcon"
                           Width="43"
                           Height="43"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Icon}"
                           Stretch="Uniform"/>
                    <StackPanel Grid.Row="1" Margin="1,3,1,0">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                   FontSize="{StaticResource CardFont.Body}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}">
                            <TextBlock.ToolTip>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}&#x0a;{1}">
                                            <Binding Path="Name"/>
                                            <Binding Path="Path"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="InvalidLabel"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WidgetSecondaryTextBrush}"
                                   FontSize="{StaticResource CardFont.Caption}"
                                   Text="已失效"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="TileIcon" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="InvalidLabel" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="SelectionHighlight" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 列表视图：小图标与名称同行，每行一个映射，纵向占用更小。 -->
        <DataTemplate x:Key="FileRowTemplate">
            <Button Height="32"
                    Margin="4,1"
                    Padding="0"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.HelpText="{Binding Path}"
                    Background="Transparent"
                    BorderThickness="0"
                    PreviewMouseLeftButtonDown="FileTile_PreviewMouseLeftButtonDown"
                    PreviewMouseRightButtonDown="FileTile_PreviewMouseRightButtonDown"
                    PreviewMouseMove="FileTile_PreviewMouseMove"
                    Click="FileTile_Click"
                    ContextMenu="{StaticResource FileTileContextMenu}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowSurface"
                                Tag="Interactive"
                                Height="32"
                                Padding="10,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                                BorderThickness="{DynamicResource WidgetTileBorderThickness}"
                                CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource CardInteractiveHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource CardInteractivePressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource CardFocusBorderBrush}"/>
                                <Setter TargetName="RowSurface" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <!-- 选中高亮垫在内容之下，与悬停/焦点背景互不争用同一属性。 -->
                    <Border x:Name="SelectionHighlight"
                            Background="{DynamicResource CardInteractiveSelectedBrush}"
                            BorderBrush="{DynamicResource CardSelectionBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                    <DockPanel>
                        <Image x:Name="RowIcon"
                               DockPanel.Dock="Left"
                               Width="20"
                               Height="20"
                               Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding Icon}"
                               Stretch="Uniform"/>
                        <TextBlock x:Name="RowInvalidLabel"
                                   DockPanel.Dock="Right"
                                   Foreground="{DynamicResource WidgetSecondaryTextBrush}"
                                   FontSize="{StaticResource CardFont.Caption}"
                                   Text="已失效"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="Collapsed"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                   FontSize="{StaticResource CardFont.Body}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}">
                            <TextBlock.ToolTip>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}&#x0a;{1}">
                                            <Binding Path="Name"/>
                                            <Binding Path="Path"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </DockPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="RowIcon" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="RowInvalidLabel" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="SelectionHighlight" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </local:WidgetWindowBase.Resources>

    <Grid x:Name="BodySurface"
          Background="{Binding WidgetBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
          ClipToBounds="True">
        <Grid x:Name="BoxLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarSurface"
                    Height="48"
                    Margin="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    CornerRadius="{Binding HeaderCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                <Grid>
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TitleAccentTag"
                                    Width="4"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{Binding WidgetHeaderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                            <TextBox x:Name="TitleEditor"
                                     Grid.Column="1"
                                     AutomationProperties.Name="分组盒标题"
                                     Style="{StaticResource DesktopContentTitleStyle}"
                                     Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                     FontFamily="{Binding WidgetTitleFontFamily, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                     FontWeight="{Binding WidgetTitleFontWeight, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                     FontStyle="{Binding WidgetTitleFontStyle, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                     Text="{Binding Title, Mode=OneTime}"/>
                        </Grid>
                    <TextBlock x:Name="CollapsedSummaryText"
                               Grid.Column="1"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               FontSize="{StaticResource CardFont.Meta}"
                               Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                    <Button x:Name="SettingsButton"
                            Grid.Column="2"
                            AutomationProperties.Name="打开分组盒设置"
                            Style="{StaticResource WidgetSettingsButtonStyle}"
                            Width="30"
                            Height="28"
                            Margin="0,0,2,0"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="{StaticResource CardFont.Subhead}"
                            Content="•••"
                            ToolTip="设置"
                            Click="Settings_Click"/>
                    <Button x:Name="AddButton"
                            Style="{StaticResource WidgetHeaderToolButtonStyle}"
                            AutomationProperties.Name="添加文件或文件夹映射"
                            Grid.Column="3"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="{StaticResource CardFont.Title}"
                            Content="+"
                            ToolTip="添加文件、文件夹或桌面项目"
                            Click="AddButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="选择文件…" Click="AddFiles_Click"/>
                                <MenuItem Header="选择文件夹…" Click="AddFolder_Click"/>
                                <Separator/>
                                <MenuItem Header="导入桌面项目（用户与公共桌面）"
                                          Click="ImportDesktop_Click"/>
                                <MenuItem Header="添加系统入口">
                                    <MenuItem Header="此电脑" Click="AddSystemEntryMyComputer_Click"/>
                                    <MenuItem Header="回收站" Click="AddSystemEntryRecycleBin_Click"/>
                                    <MenuItem Header="下载" Click="AddSystemEntryDownloads_Click"/>
                                    <MenuItem Header="桌面" Click="AddSystemEntryDesktop_Click"/>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SortButton"
                            Style="{StaticResource WidgetHeaderToolButtonStyle}"
                            AutomationProperties.Name="排序文件映射"
                            Grid.Column="4"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="{StaticResource CardFont.Subhead}"
                            Content="↕"
                            ToolTip="排序映射"
                            Click="SortButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="手动调整（保留当前顺序）" Click="SortManual_Click"/>
                                <MenuItem Header="按名称" Click="SortName_Click"/>
                                <MenuItem Header="按类型" Click="SortType_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="PinOpenButton"
                            Style="{StaticResource WidgetHeaderToolButtonStyle}"
                            Grid.Column="5"
                            Visibility="Collapsed"
                            AutomationProperties.Name="暂时保持分组盒展开"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="{StaticResource CardFont.Meta}"
                            Content="&#xE718;"
                            ToolTip="暂时保持展开（鼠标移开不自动收起）"
                            Click="PinOpenButton_Click"/>
                    <Button x:Name="CollapseButton"
                            Style="{StaticResource WidgetHeaderToolButtonStyle}"
                            Grid.Column="6"
                            AutomationProperties.Name="折叠或展开分组盒"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="{StaticResource CardFont.Meta}"
                            Content="&#xE70E;"
                            ToolTip="折叠成标题条"
                            Click="CollapseButton_Click"/>
                    </Grid>
                    <Border x:Name="TitleDivider"
                            Height="1"
                            Margin="16,0,16,0"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Background="{Binding WidgetDividerBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer Margin="14,6,6,2"
                              Style="{StaticResource CardScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FileList"
                                  Focusable="False"
                                  IsTabStop="False"/>
                </ScrollViewer>
                <StackPanel x:Name="FileBoxEmptyState"
                            Margin="{StaticResource CardSpace.EmptyMargin}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                    <TextBlock x:Name="FileBoxEmptyTitleText"
                               FontSize="{StaticResource CardFont.Subhead}"
                               FontWeight="SemiBold"
                               Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                               Text="还没有收纳项目"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="FileBoxEmptyGuideText"
                               Margin="{StaticResource CardSpace.TightGap}"
                               FontSize="{StaticResource CardFont.Meta}"
                               Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                               Text="拖入文件或文件夹，或点击右上角 + 添加"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Canvas x:Name="FileBoxMotionOverlay"
                        ClipToBounds="True"
                        IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Row="2" Margin="17,0,17,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CountText"
                               Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                               FontSize="{StaticResource CardFont.Caption}"/>
                    <TextBlock x:Name="StatusText"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0,1,8,0"
                               Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                               FontSize="{StaticResource CardFont.Caption}"
                               Text=""
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="AutoOrganizeButton"
                        AutomationProperties.Name="自动整理桌面映射"
                        Grid.Column="1"
                        MinWidth="68"
                        Padding="{StaticResource CardSpace.CompactPadding}"
                        VerticalAlignment="Center"
                        Content="自动整理"
                        Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                        Background="{DynamicResource WidgetControlBrush}"
                        BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                        FontSize="{StaticResource CardFont.Caption}"
                        ToolTip="把桌面项目放进分类盒，并清除已失效项"
                        Click="AutoOrganize_Click"/>
            </Grid>
        </Grid>
        <Border x:Name="Surface"
                Background="Transparent"
                BorderBrush="{Binding WidgetBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                BorderThickness="{Binding WidgetBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                CornerRadius="{Binding SurfaceCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                IsHitTestVisible="False"/>
    </Grid>
</local:WidgetWindowBase>
