<Window x:Class="BingLan.App.Windows.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="顶部信息条"
        Width="800"
        Height="32"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="TopBarInkBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TopBarMutedInkBrush" Color="#B8FFFFFF"/>
        <SolidColorBrush x:Key="TopBarHoverBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TopBarPressedBrush" Color="#46FFFFFF"/>
        <SolidColorBrush x:Key="TopBarSearchBackgroundBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TopBarSearchHoverBrush" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="TopBarSearchBorderBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TopBarBadgeBackgroundBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="TopBarAttentionBrush" Color="#FFA500"/>
        <Style x:Key="ModuleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource TopBarHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchEntryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TopBarSearchBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TopBarSearchBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TopBarInkBrush}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource TopBarSearchHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource TopBarPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#2BFFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFF"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel x:Name="ModuleHeader" LastChildFill="False">
                <StackPanel x:Name="RightModules"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"/>
                <StackPanel x:Name="LeftModules"
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"/>
            </DockPanel>
            <!--The search layer spans the whole bar and centres its content on the bar
                itself: the box stays at the screen's top centre whatever the side
                modules measure, at any resolution.-->
            <Grid x:Name="CenterHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
            <Grid x:Name="CapsuleHeader" Visibility="Collapsed"/>
            <Border x:Name="CapsuleBody" Grid.Row="1" Visibility="Collapsed"
                    Margin="18,0,18,16"/>
        </Grid>
    </Border>
</Window>
