<Window x:Class="BingLan.App.Windows.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="顶部信息条"
        Width="800"
        Height="32"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="TopBarSpecularRimBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TopBarInnerShadowBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TopBarDiagonalSheenBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TopBarModuleHoverBrush" Color="#1EFFFFFF"/>
        <SolidColorBrush x:Key="TopBarModulePressedBrush" Color="#28000000"/>
        <SolidColorBrush x:Key="TopBarSearchFillBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TopBarSearchBorderBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TopBarSearchHoverBrush" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="TopBarSearchPressedBrush" Color="#46FFFFFF"/>
        <Style x:Key="ModuleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource TopBarModuleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource TopBarModulePressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchEntryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TopBarSearchFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TopBarSearchBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource TopBarSearchHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource TopBarSearchPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 静态玻璃质感层（冻结画刷，零 Effect，高对比度/无底板下自动透明） -->
            <Border x:Name="SurfaceDiagonalSheen"
                    Grid.RowSpan="2"
                    IsHitTestVisible="False"
                    CornerRadius="0"
                    Background="{DynamicResource TopBarDiagonalSheenBrush}"/>
            <Border x:Name="SurfaceInnerShadow"
                    Grid.RowSpan="2"
                    IsHitTestVisible="False"
                    CornerRadius="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource TopBarInnerShadowBrush}"/>
            <Border x:Name="SurfaceSpecularRim"
                    Grid.RowSpan="2"
                    IsHitTestVisible="False"
                    CornerRadius="0"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource TopBarSpecularRimBrush}"/>
            <DockPanel x:Name="ModuleHeader" LastChildFill="False">
                <StackPanel x:Name="RightModules"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"/>
                <StackPanel x:Name="LeftModules"
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"/>
            </DockPanel>
            <!--The search layer spans the whole bar and centres its content on the bar
                itself: the box stays at the screen's top centre whatever the side
                modules measure, at any resolution.-->
            <Grid x:Name="CenterHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
            <Grid x:Name="CapsuleHeader" Visibility="Collapsed"/>
            <Border x:Name="CapsuleBody" Grid.Row="1" Visibility="Collapsed"
                    Margin="18,0,18,16"/>
        </Grid>
    </Border>
</Window>
