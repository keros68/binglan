<Window x:Class="BingLan.App.Windows.AppearancePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BingLan.App.Windows"
        Title="试选卡片外观" Width="1000" Height="740" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource IcePageBrush}" Foreground="{DynamicResource IceInkBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="试选卡片外观" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="确认后应用到所有卡片。" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>
        <Grid x:Name="PickerBody" Grid.Row="1" SizeChanged="PickerBody_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="272"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="PreviewPanel" Margin="0,0,24,0" ClipToBounds="True">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="示例预览" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PreviewBackgroundSelector" DockPanel.Dock="Right" HorizontalAlignment="Right"
                              Width="132" AutomationProperties.Name="示例背景" SelectionChanged="PreviewBackground_Changed">
                        <ComboBoxItem Content="深色背景"/>
                        <ComboBoxItem Content="浅色背景"/>
                    </ComboBox>
                </DockPanel>
                <local:AppearanceSampleView x:Name="SamplePreview" MaxHeight="380" VerticalAlignment="Top"/>
                <TextBlock x:Name="PreviewStatusText" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}"/>
                <TextBlock Text="固定示例内容，玻璃为静态示意。" Style="{StaticResource CaptionStyle}"/>
            </StackPanel>
            <ScrollViewer x:Name="ParameterScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,0">
                <TextBlock Text="材质" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox x:Name="MaterialSelector" AutomationProperties.Name="试选材质" SelectionChanged="Draft_Changed">
                    <ComboBoxItem Content="浅色玻璃"/>
                    <ComboBoxItem Content="深色玻璃"/>
                    <ComboBoxItem Content="无底板"/>
                </ComboBox>
                <TextBlock Text="配色" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel x:Name="PalettePanel"/>
                <TextBlock Text="玻璃浓度" Style="{StaticResource SectionHeaderStyle}"/>
                <DockPanel>
                    <TextBlock x:Name="DensityText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"/>
                    <Slider x:Name="DensitySlider" Minimum="0.05" Maximum="0.96" SmallChange="0.02" LargeChange="0.1"
                            AutomationProperties.Name="试选玻璃浓度" ValueChanged="Density_Changed"/>
                </DockPanel>
                <TextBlock Text="文字颜色" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel>
                    <ComboBox x:Name="TextInkSelector" Width="170" Margin="0,0,10,8"
                              AutomationProperties.Name="试选文字颜色" SelectionChanged="Draft_Changed">
                        <ComboBoxItem Content="跟随外观"/>
                        <ComboBoxItem Content="白色"/>
                        <ComboBoxItem Content="深色"/>
                        <ComboBoxItem Content="自定义"/>
                    </ComboBox>
                    <Button x:Name="CustomColorButton" Content="选色…" Margin="0,0,0,8"
                            AutomationProperties.Name="选择试选文字颜色" Click="CustomColor_Click"/>
                </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CompareButton" Content="查看原效果" HorizontalAlignment="Left"
                    AutomationProperties.Name="查看原效果" Click="Compare_Click"/>
            <Button x:Name="ApplyButton" Grid.Column="1" Content="应用" MinWidth="80" Margin="10,0,0,0"
                    IsDefault="True" AutomationProperties.Name="应用试选外观" Click="Apply_Click"/>
            <Button x:Name="CancelButton" Grid.Column="2" Content="取消" MinWidth="80" Margin="10,0,0,0"
                    IsCancel="True" AutomationProperties.Name="取消试选" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
