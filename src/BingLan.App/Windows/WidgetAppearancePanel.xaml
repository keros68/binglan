<UserControl x:Class="BingLan.App.Windows.WidgetAppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BingLan.App.Windows"
             FontFamily="{StaticResource UiFont}"
             Foreground="{DynamicResource IceInkBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The panel keeps its own copy so it renders identically outside the
                     settings window (appearance preview host). -->
                <ResourceDictionary Source="SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Margin="6,2,0,7"
                   Style="{StaticResource SectionHeaderStyle}"
                   Text="外观与尺寸"/>
        <local:SettingsGroup>
            <local:SettingsRow Header="快速配色">
                <WrapPanel x:Name="PaletteSwatchPanel"/>
            </local:SettingsRow>
            <local:SettingsRow Header="这张卡片的外观">
                <Border Style="{StaticResource SegmentHostStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="CardLookLightRadio"
                                     GroupName="CardLook"
                                     Style="{StaticResource SegmentRadioStyle}"
                                     Tag="Light"
                                     Content="浅色玻璃"
                                     AutomationProperties.Name="卡片外观浅色玻璃"
                                     Checked="CardLook_Changed"/>
                        <RadioButton x:Name="CardLookDarkRadio"
                                     GroupName="CardLook"
                                     Style="{StaticResource SegmentRadioStyle}"
                                     Tag="Dark"
                                     Content="深色玻璃"
                                     AutomationProperties.Name="卡片外观深色玻璃"
                                     Checked="CardLook_Changed"/>
                        <RadioButton x:Name="CardLookClearRadio"
                                     GroupName="CardLook"
                                     Style="{StaticResource SegmentRadioStyle}"
                                     Tag="Clear"
                                     Content="无底板"
                                     AutomationProperties.Name="卡片外观无底板"
                                     Checked="CardLook_Changed"/>
                    </StackPanel>
                </Border>
            </local:SettingsRow>
            <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="主体颜色">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="BackgroundColorChip"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                            BorderThickness="1"/>
                    <TextBox x:Name="BackgroundColorEditor"
                             Width="110"
                             Margin="8,0,0,0"
                             AutomationProperties.Name="主体颜色"
                             LostFocus="BackgroundColorEditor_LostFocus"
                             KeyDown="ColorEditor_KeyDown"/>
                    <Button x:Name="BackgroundColorButton"
                            Margin="8,0,0,0"
                            Content="选择颜色…"
                            AutomationProperties.Name="选择主体颜色"
                            Click="BackgroundColorButton_Click"/>
                </StackPanel>
            </local:SettingsRow>
            <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="标题栏颜色">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="HeaderColorChip"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                            BorderThickness="1"/>
                    <TextBox x:Name="HeaderColorEditor"
                             Width="110"
                             Margin="8,0,0,0"
                             AutomationProperties.Name="标题栏颜色"
                             LostFocus="HeaderColorEditor_LostFocus"
                             KeyDown="ColorEditor_KeyDown"/>
                    <Button x:Name="HeaderColorButton"
                            Margin="8,0,0,0"
                            Content="选择颜色…"
                            AutomationProperties.Name="选择标题栏颜色"
                            Click="HeaderColorButton_Click"/>
                </StackPanel>
            </local:SettingsRow>
            <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="卡片文字">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="TextColorChip"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                            BorderThickness="1"/>
                    <TextBox x:Name="TextColorEditor"
                             Width="110"
                             Margin="8,0,0,0"
                             AutomationProperties.Name="卡片文字颜色"
                             LostFocus="TextColorEditor_LostFocus"
                             KeyDown="ColorEditor_KeyDown"/>
                    <Button x:Name="TextColorButton"
                            Margin="8,0,0,0"
                            Content="选择颜色…"
                            AutomationProperties.Name="选择卡片文字颜色"
                            Click="TextColorButton_Click"/>
                    <Button x:Name="WhiteTextColorButton"
                            Margin="6,0,0,0"
                            Content="白"
                            Tag="#FFFFFF"
                            AutomationProperties.Name="卡片文字颜色设为白色"
                            Click="QuickTextColorButton_Click"/>
                    <Button x:Name="BlackTextColorButton"
                            Margin="6,0,0,0"
                            Content="黑"
                            Tag="#000000"
                            AutomationProperties.Name="卡片文字颜色设为黑色"
                            Click="QuickTextColorButton_Click"/>
                </StackPanel>
            </local:SettingsRow>
            <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="玻璃浓度">
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="BackgroundOpacitySlider"
                            Width="190"
                            Minimum="0"
                            Maximum="1"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            TickFrequency="0.01"
                            AutomationProperties.Name="玻璃浓度"
                            ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                    <TextBlock x:Name="BackgroundOpacityText" Style="{StaticResource ValueTextStyle}"/>
                </StackPanel>
            </local:SettingsRow>
            <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="标题栏不透明度">
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="HeaderOpacitySlider"
                            Width="190"
                            Minimum="0"
                            Maximum="1"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            TickFrequency="0.01"
                            AutomationProperties.Name="标题栏不透明度"
                            ValueChanged="HeaderOpacitySlider_ValueChanged"/>
                    <TextBlock x:Name="HeaderOpacityText" Style="{StaticResource ValueTextStyle}"/>
                </StackPanel>
            </local:SettingsRow>
            <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="圆角">
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="CornerRadiusSlider"
                            Width="190"
                            Minimum="0"
                            Maximum="32"
                            SmallChange="1"
                            LargeChange="4"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="卡片圆角"
                            ValueChanged="CornerRadiusSlider_ValueChanged"/>
                    <TextBlock x:Name="CornerRadiusText" Style="{StaticResource ValueTextStyle}"/>
                </StackPanel>
            </local:SettingsRow>
        </local:SettingsGroup>

        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="卡片尺寸与标题字体"/>
        <local:SettingsGroup>
            <local:SettingsRow Header="卡片尺寸">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="宽"/>
                    <TextBox x:Name="WidthEditor"
                             Width="80"
                             AutomationProperties.Name="卡片宽度"
                             TextChanged="SizeEditor_TextChanged"
                             LostFocus="SizeEditor_LostFocus"
                             KeyDown="SizeEditor_KeyDown"/>
                    <TextBlock Margin="14,0,6,0" VerticalAlignment="Center" Text="高"/>
                    <TextBox x:Name="HeightEditor"
                             Width="80"
                             AutomationProperties.Name="卡片高度"
                             TextChanged="SizeEditor_TextChanged"
                             LostFocus="SizeEditor_LostFocus"
                             KeyDown="SizeEditor_KeyDown"/>
                </StackPanel>
            </local:SettingsRow>
            <local:SettingsRow Header="标题字体">
                <ComboBox x:Name="TitleFontFamilyPicker"
                          Width="240"
                          AutomationProperties.Name="标题字体"
                          IsTextSearchEnabled="True"
                          MaxDropDownHeight="280"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="TitleFontFamilyPicker_SelectionChanged"/>
            </local:SettingsRow>
            <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="字体样式">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="TitleFontBoldToggle"
                              Content="粗体"
                              AutomationProperties.Name="标题字体粗体"
                              Click="TitleFontStyleToggle_Click"/>
                    <CheckBox x:Name="TitleFontItalicToggle"
                              Margin="18,0,0,0"
                              Content="斜体"
                              AutomationProperties.Name="标题字体斜体"
                              Click="TitleFontStyleToggle_Click"/>
                </StackPanel>
            </local:SettingsRow>
            <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}"
                               Header="恢复默认外观"
                               Description="把这张卡片的外观、圆角和尺寸恢复为冰蓝默认">
                <Button Content="恢复冰蓝默认"
                        AutomationProperties.Name="恢复冰蓝默认外观"
                        Click="ResetButton_Click"/>
            </local:SettingsRow>
        </local:SettingsGroup>
    </StackPanel>
</UserControl>
