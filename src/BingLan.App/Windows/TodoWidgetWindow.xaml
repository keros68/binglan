<local:WidgetWindowBase x:Class="BingLan.App.Windows.TodoWidgetWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:BingLan.App.Windows"
                        Title="待办便签"
                        Width="286"
                        Height="336"
                        MinWidth="226"
                        MinHeight="166"
                        WindowStyle="None"
                        ResizeMode="CanResize"
                        AllowsTransparency="True"
                        Background="Transparent"
                        ShowInTaskbar="False"
                        FontFamily="{DynamicResource TodoContentFont}"
                        Foreground="{DynamicResource PrimaryTextBrush}">
    <local:WidgetWindowBase.Resources>
        <!-- Full entry row for the day peek popup: dwell 300 ms to lift and drag to
             reorder, double-click the text to edit in place, right-click for move-to-day. -->
        <DataTemplate x:Key="DayPeekItemTemplate">
            <Border x:Name="PeekRowBorder"
                    Tag="Interactive"
                    Margin="0,1"
                    Padding="4,3"
                    CornerRadius="4"
                    Background="Transparent"
                    ContextMenuOpening="PeekRow_ContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="上移" Click="MoveUp_Click"/>
                        <MenuItem Header="下移" Click="MoveDown_Click"/>
                        <Separator/>
                        <MenuItem Header="删除" Click="DeleteTodo_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCompleted}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.HideCompleted, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Width="12"
                              Height="12"
                              VerticalAlignment="Top"
                              Margin="0,2,5,0"
                              AutomationProperties.Name="切换待办完成状态"
                              IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="Completion_Changed"
                              Unchecked="Completion_Changed"/>
                    <TextBox x:Name="PeekText"
                             Grid.Column="1"
                             AutomationProperties.Name="待办内容"
                             FontFamily="{DynamicResource TodoContentFont}"
                             FontSize="{DynamicResource TodoFont.PeekItem}"
                             TextWrapping="Wrap"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="1,0"
                             IsReadOnly="True"
                             Focusable="False"
                             Cursor="Arrow"
                             CaretBrush="#FF3E77B5"
                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseLeftButtonDown="PeekText_PreviewMouseDown"
                             PreviewKeyDown="PeekText_PreviewKeyDown"
                             LostFocus="PeekText_LostFocus">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Foreground" Value="#FF22303E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Foreground" Value="#FF8A98A8"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="2"
                            AutomationProperties.Name="删除待办"
                            Width="18"
                            Height="18"
                            Margin="2,-2,-4,-2"
                            Padding="0"
                            VerticalAlignment="Top"
                            Foreground="#FF8A98A8"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Content="×"
                            ToolTip="删除待办"
                            Click="DeleteTodo_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="WeekItemRowTemplate">
            <Border Tag="Interactive"
                    Margin="0,0,0,2"
                    Padding="4,2"
                    CornerRadius="5"
                    MinHeight="17"
                    Background="{DynamicResource WidgetItemSurfaceBrush}"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    ContextMenuOpening="PeekRow_ContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="上移" Click="MoveUp_Click"/>
                        <MenuItem Header="下移" Click="MoveDown_Click"/>
                        <Separator/>
                        <MenuItem Header="删除" Click="DeleteTodo_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCompleted}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.HideCompleted, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Width="12"
                              Height="12"
                              VerticalAlignment="Top"
                              Margin="0,2,5,0"
                              AutomationProperties.Name="切换待办完成状态"
                              IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="Completion_Changed"
                              Unchecked="Completion_Changed"/>
                    <TextBlock Grid.Column="1"
                               AutomationProperties.Name="{Binding Text}"
                               VerticalAlignment="Top"
                               FontSize="{DynamicResource TodoFont.CellItem}"
                               LineHeight="{DynamicResource TodoFont.CellLineHeight}"
                               LineStackingStrategy="BlockLineHeight"
                               MaxHeight="{DynamicResource TodoFont.CellTwoLines}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Text, Mode=OneWay}"
                               ToolTip="{Binding Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Style.Triggers>
                                    <!-- A cell too short for a two-line entry shows one line per entry. -->
                                    <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}" Value="True">
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Foreground" Value="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </local:WidgetWindowBase.Resources>
    <Grid x:Name="BodySurface"
          Background="{Binding WidgetBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
          ClipToBounds="True">
        <Grid x:Name="TodoLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarSurface"
                    Height="50"
                    Margin="10,10,10,0"
                    VerticalAlignment="Top"
                    Background="{Binding WidgetHeaderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                    CornerRadius="{Binding HeaderCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                <Grid Margin="17,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleEditor"
                             AutomationProperties.Name="待办组件标题"
                             Style="{StaticResource DesktopContentTitleStyle}"
                             Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                             FontFamily="{Binding WidgetTitleFontFamily, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                             FontWeight="{Binding WidgetTitleFontWeight, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                             FontStyle="{Binding WidgetTitleFontStyle, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                             Text="{Binding Title, Mode=OneTime}"/>
                    <Button x:Name="ViewModeButton"
                            Grid.Column="1"
                            AutomationProperties.Name="切换列表与周历视图"
                            Width="30"
                            Height="28"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="{DynamicResource WidgetSubtleControlBrush}"
                            BorderBrush="{DynamicResource WidgetSubtleControlBorderBrush}"
                            FontSize="11"
                            Content="列表"
                            ToolTip="切换到周历"
                            Click="ToggleViewMode_Click"/>
                    <Button x:Name="CollapseButton"
                            Grid.Column="2"
                            AutomationProperties.Name="折叠或展开待办卡片"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="12"
                            Content="&#xE70E;"
                            ToolTip="收起成标题条"
                            Click="CollapseButton_Click"/>
                    <Button Grid.Column="3"
                            AutomationProperties.Name="打开待办组件设置"
                            Style="{StaticResource WidgetSettingsButtonStyle}"
                            Width="30"
                            Height="28"
                            Margin="3,0,0,0"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            Content="•••"
                            ToolTip="设置"
                            Click="Settings_Click"/>
                    <Button x:Name="AddTodoButton"
                            Grid.Column="4"
                            AutomationProperties.Name="新增待办"
                            Width="30"
                            Height="28"
                            Margin="3,0,0,0"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="{DynamicResource WidgetSubtleControlBrush}"
                            BorderBrush="{DynamicResource WidgetSubtleControlBorderBrush}"
                            FontSize="20"
                            Content="+"
                            ToolTip="新增待办"
                            Click="Add_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ListHost"
                              Margin="10,9,6,4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MouseLeave="WeekPeekOverlay_MouseLeave"
                              PreviewMouseWheel="WeekPeekOverlay_PreviewMouseWheel">
                    <ItemsControl x:Name="TodoList"
                                  Focusable="False"
                                  IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="Interactive"
                                    Margin="2,2,6,3"
                                    Padding="8,8"
                                    CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                    Background="{DynamicResource WidgetItemSurfaceBrush}">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="上移" Click="MoveUp_Click"/>
                                        <MenuItem Header="下移" Click="MoveDown_Click"/>
                                        <Separator/>
                                        <MenuItem Header="删除" Click="DeleteTodo_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="27"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              AutomationProperties.Name="切换待办完成状态"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Checked="Completion_Changed"
                                              Unchecked="Completion_Changed"/>
                                    <TextBox Grid.Column="1"
                                             AutomationProperties.Name="待办内容"
                                             MinHeight="24"
                                             VerticalContentAlignment="Center"
                                             FontFamily="{DynamicResource TodoContentFont}"
                                             FontSize="{DynamicResource TodoFont.ListItem}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="TodoText_GotKeyboardFocus"
                                             LostKeyboardFocus="TodoText_LostKeyboardFocus"
                                             KeyDown="TodoText_KeyDown">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Foreground"
                                                        Value="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Grid.Column="1"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource TodoFont.ListItem}"
                                               IsHitTestVisible="False"
                                               Text="输入待办…"
                                               Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- The negative margin gives a 32 DIP target without making the row taller. -->
                                    <Button Grid.Column="2"
                                            AutomationProperties.Name="删除待办"
                                            Width="32"
                                            Height="32"
                                            Margin="2,-4,-4,-4"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="16"
                                            Content="×"
                                            ToolTip="删除待办"
                                            Click="DeleteTodo_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- Weekly view: month-aligned calendar grid, Monday first, paged one week at a time. -->
                <Grid x:Name="WeekHost"
                      SizeChanged="DayPeek_SizeChanged"
                      Margin="10,4,6,0"
                      Visibility="Collapsed"
                      UseLayoutRounding="True"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="ClearType">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,2,0">
                        <Button x:Name="WeekPrevButton"
                                DockPanel.Dock="Left"
                                AutomationProperties.Name="上一周"
                                Width="28"
                                Height="26"
                                Padding="0"
                                Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                Background="{DynamicResource WidgetControlBrush}"
                                BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                                FontSize="13"
                                Content="←"
                                ToolTip="上一周"
                                Click="WeekPrev_Click"/>
                        <Button x:Name="WeekTodayButton"
                                DockPanel.Dock="Right"
                                AutomationProperties.Name="回到本周"
                                Margin="4,0,4,0"
                                Padding="6,2"
                                Content="回到本周"
                                Visibility="Collapsed"
                                Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                Background="{DynamicResource WidgetControlBrush}"
                                BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                                FontSize="11"
                                Click="WeekToday_Click"/>
                        <Button x:Name="WeekNextButton"
                                DockPanel.Dock="Right"
                                AutomationProperties.Name="下一周"
                                Width="28"
                                Height="26"
                                Padding="0"
                                Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                Background="{DynamicResource WidgetControlBrush}"
                                BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                                FontSize="13"
                                Content="→"
                                ToolTip="下一周"
                                Click="WeekNext_Click"/>
                        <TextBlock x:Name="WeekRange"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource TodoFont.WeekRange}"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="2,3,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="周一" FontSize="{DynamicResource TodoFont.Weekday}" FontWeight="Bold" TextAlignment="Left" Margin="6,0,0,0"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock Grid.Column="1" Text="周二" FontSize="{DynamicResource TodoFont.Weekday}" FontWeight="Bold" TextAlignment="Left" Margin="6,0,0,0"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock Grid.Column="2" Text="周三" FontSize="{DynamicResource TodoFont.Weekday}" FontWeight="Bold" TextAlignment="Left" Margin="6,0,0,0"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock Grid.Column="3" Text="周四" FontSize="{DynamicResource TodoFont.Weekday}" FontWeight="Bold" TextAlignment="Left" Margin="6,0,0,0"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock Grid.Column="4" Text="周五" FontSize="{DynamicResource TodoFont.Weekday}" FontWeight="Bold" TextAlignment="Left" Margin="6,0,0,0"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock Grid.Column="5" Text="周六" FontSize="{DynamicResource TodoFont.Weekday}" TextAlignment="Left" Margin="6,0,0,0"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock Grid.Column="6" Text="周日" FontSize="{DynamicResource TodoFont.Weekday}" TextAlignment="Left" Margin="6,0,0,0"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                    </Grid>

                    <!-- Month-aligned rows: the row count varies with month breaks, so
                         the panel's row count follows the rendered list. -->
                    <ItemsControl x:Name="WeekRows"
                                  Grid.Row="2"
                                  Margin="0,2,0,2"
                                  ClipToBounds="True"
                                  Focusable="False"
                                  IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding Count, FallbackValue=5}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="1,1,1,2"
                                                            Padding="5,3,5,3"
                                                            CornerRadius="4"
                                                            Background="Transparent"
                                                            Tag="Interactive"
                                                            MouseLeftButtonDown="WeekCellSurface_Click"
                                                            PreviewMouseLeftButtonDown="WeekCellSurface_Preview">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#FF7FA8D9"/>
                                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#D9A441"/>
                                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFiller}" Value="True">
                                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <!-- Fill layer: every day reads as one card; weekdays carry
                                                                 the schedule so they stay at full strength, weekends fade. -->
                                                            <Border CornerRadius="3" IsHitTestVisible="False">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource WidgetSubtleControlBrush}"/>
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.4"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFiller}" Value="True">
                                                                                <Setter Property="Background" Value="{x:Null}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <Grid>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFiller}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Background="Transparent">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DayNumber}"
                                                                                   FontSize="{DynamicResource TodoFont.DayNumber}"
                                                                                   FontWeight="Medium"
                                                                                   FontFamily="pack://application:,,,/BingLan;component/Assets/Fonts/#Jost, Microsoft YaHei UI"
                                                                                   VerticalAlignment="Top">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding LunarText}"
                                                                                   FontSize="{DynamicResource TodoFont.Lunar}"
                                                                                   Margin="4,0,0,1.5"
                                                                                   VerticalAlignment="Bottom"
                                                                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                                                    </StackPanel>
                                                                    <!-- Overflow chip: entries that do not fit the cell; opens the day peek popup. -->
                                                                    <Border Grid.Column="1"
                                                                            VerticalAlignment="Top"
                                                                            Padding="5,0"
                                                                            CornerRadius="7"
                                                                            Background="{DynamicResource WidgetItemSurfaceBrush}"
                                                                            BorderBrush="#66FFFFFF"
                                                                            BorderThickness="1"
                                                                            Cursor="Hand"
                                                                            Tag="Interactive"
                                                                            ToolTip="查看当天全部待办"
                                                                            MouseLeftButtonDown="WeekOverflow_Click">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasOverflow}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock FontSize="{DynamicResource TodoFont.Overflow}" Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                                                                            <Run Text="+"/><Run Text="{Binding OverflowCount, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </Grid>
                                                                <!-- Per-cell scroll: wheel over the cell rolls the day's
                                                                     entries without opening the day editor. -->
                                                                <!-- Focusable=False：ScrollViewer 默认把鼠标按下标记为已处理以抢焦点，
                                                                     这会吞掉格身全部点击（并画出虚线焦点框）；点击分派改由
                                                                     WeekCellSurface_Preview 在其上以 handledEventsToo 挂载。 -->
                                                                <ScrollViewer Grid.Row="1"
                                                                              Focusable="False"
                                                                              Margin="0,2,0,0"
                                                                              VerticalScrollBarVisibility="Hidden"
                                                                              HorizontalScrollBarVisibility="Disabled"
                                                                              ScrollChanged="WeekCellScroll_Changed">
                                                                    <ItemsControl ItemsSource="{Binding PreviewItems}"
                                                                                  ItemTemplate="{StaticResource WeekItemRowTemplate}"
                                                                                  Focusable="False"
                                                                                  IsTabStop="False"/>
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    <!-- Day peek popup: the full day list, opened from a cell's overflow chip.
                         No background: a click beside the panel reaches the cell under it,
                         and OnPreviewMouseLeftButtonDown closes the popup first. -->
                    <Canvas x:Name="WeekPeekOverlay"
                            Grid.Row="0" Grid.RowSpan="3"
                            Visibility="Collapsed"
                            MouseLeave="WeekPeekOverlay_MouseLeave"
                            PreviewMouseWheel="WeekPeekOverlay_PreviewMouseWheel">
                        <Border x:Name="WeekPeekPanel"
                                SizeChanged="DayPeek_SizeChanged"
                                Width="320"
                                CornerRadius="8"
                                Background="#FFF4F6FB"
                                BorderBrush="#FFC9D2E6"
                                BorderThickness="1"
                                MouseLeftButtonDown="WeekPeekPanel_Click">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" Color="#FF3A4560"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Padding="12,8"
                                        CornerRadius="8,8,0,0"
                                        Background="#FFB8C4EA">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="WeekPeekPrevDay"
                                                    AutomationProperties.Name="前一天"
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Content="◀"
                                                    Foreground="#FF243146"
                                                    Click="WeekPeekPrevDay_Click"/>
                                            <TextBlock x:Name="WeekPeekTitle"
                                                       Margin="6,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource TodoFont.PeekTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF243146"/>
                                            <Button x:Name="WeekPeekNextDay"
                                                    AutomationProperties.Name="后一天"
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Content="▶"
                                                    Foreground="#FF243146"
                                                    Click="WeekPeekNextDay_Click"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                AutomationProperties.Name="关闭当日浮层"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="12"
                                                Content="✕"
                                                Foreground="#FF243146"
                                                Click="WeekPeekClose_Click"/>
                                    </Grid>
                                </Border>
                                <ScrollViewer x:Name="WeekPeekListScroller"
                                              Grid.Row="1"
                                              MaxHeight="264"
                                              Margin="8,6,8,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="WeekPeekList"
                                                  Margin="0,0,2,0"
                                                  ItemTemplate="{StaticResource DayPeekItemTemplate}"
                                                  Focusable="False"
                                                  IsTabStop="False"/>
                                </ScrollViewer>
                                <Border Grid.Row="2"
                                        Margin="8,6,8,8"
                                        Padding="6,4"
                                        CornerRadius="6"
                                        Background="#FFFFFFFF"
                                        BorderBrush="#FFD8DEEC"
                                        BorderThickness="1">
                                    <TextBox x:Name="WeekPeekInput"
                                             AutomationProperties.Name="添加当日待办"
                                             FontFamily="{DynamicResource TodoContentFont}"
                                             FontSize="{DynamicResource TodoFont.PeekItem}"
                                             MinHeight="18"
                                             Padding="2,0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             CaretBrush="#FF3E77B5"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="False"
                                             KeyDown="WeekPeekInput_KeyDown">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="#FF22303E"/>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Border>
                            </Grid>
                        </Border>
                                        <!-- Move toast: transient feedback with undo. -->
                    <Border x:Name="MoveToast"
                            Grid.Row="0" Grid.RowSpan="3"
                            Margin="0,40,0,0"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#FFDCE4F7"
                            BorderBrush="#FFB8C4EA"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MoveToastText"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource TodoFont.Status}"
                                       Foreground="#FF243146"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1"
                                    AutomationProperties.Name="撤销移动"
                                    Margin="10,0,0,0"
                                    Padding="6,2"
                                    Content="撤销"
                                    FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#FF243146"
                                    Click="ToastUndo_Click"/>
                        </Grid>
                    </Border>
                </Canvas>
                    </Grid>
                </Grid>

            <Grid Grid.Row="2" Margin="17,0,17,7">
                <TextBlock x:Name="SummaryText"
                           AutomationProperties.LiveSetting="Polite"
                           VerticalAlignment="Center"
                           Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                           FontSize="{DynamicResource TodoFont.Status}"/>
                <!-- The two footer buttons appear only under the mouse or with keyboard focus. -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button x:Name="ClearCompletedButton"
                            AutomationProperties.Name="清理已完成的待办"
                            Margin="0,0,6,0"
                            Padding="9,3"
                            Content="清理已完成"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="{DynamicResource WidgetControlBrush}"
                            BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                            FontSize="11"
                            Click="ClearCompleted_Click"/>
                    <Button x:Name="CompletedVisibilityButton"
                            AutomationProperties.Name="切换已完成待办的显示状态"
                            Padding="9,3"
                            Content="隐藏已完成"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="{DynamicResource WidgetControlBrush}"
                            BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                            FontSize="11"
                            Click="ToggleCompletedVisibility_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border x:Name="Surface"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="{Binding SurfaceCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                IsHitTestVisible="False"/>
    </Grid>
</local:WidgetWindowBase>
