<local:WidgetWindowBase x:Class="BingLan.App.Windows.InformationWidgetWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:BingLan.App.Windows"
                        Title="桌面信息"
                        Width="300"
                        Height="420"
                        MinWidth="250"
                        MinHeight="330"
                        WindowStyle="None"
                        ResizeMode="CanResize"
                        AllowsTransparency="True"
                        Background="Transparent"
                        ShowInTaskbar="False"
                        FontFamily="{StaticResource UiFont}"
                        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid x:Name="BodySurface"
          Background="{Binding WidgetBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
          ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="ClockPanel" Margin="17,8,17,0">
                <Grid x:Name="ClockLayoutGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeText"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               FontSize="{StaticResource CardFont.DisplayClock}"
                               FontWeight="Bold"
                               Effect="{StaticResource NakedTextContrastShadow}"
                               Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                    <DockPanel x:Name="DateMetaPanel"
                               Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               LastChildFill="True">
                        <TextBlock x:Name="TimePeriodText"
                                   DockPanel.Dock="Left"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource CardFont.Body}"
                                   Effect="{StaticResource NakedTextContrastShadow}"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock x:Name="DateText"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource CardFont.Body}"
                                   Effect="{StaticResource NakedTextContrastShadow}"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                    </DockPanel>
                </Grid>
                <!-- An optional line under the date that fades out at both ends. -->
                <Rectangle x:Name="ClockDivider"
                           Height="1"
                           Margin="24,16,24,4"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="GreetingText"
                           Margin="0,3,0,0"
                           FontSize="{StaticResource CardFont.Subhead}"
                           Effect="{StaticResource NakedTextContrastShadow}"
                           Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
            </StackPanel>

            <Border x:Name="PerformanceCard"
                    Grid.Row="1"
                    Margin="10,10,10,0"
                    Padding="12,9"
                    Background="{DynamicResource WidgetItemSurfaceBrush}"
                    CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="CpuLabelText" Tag="Secondary" Text="CPU" FontSize="{StaticResource CardFont.Caption}" FontWeight="Medium"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock x:Name="CpuValueText" Typography.NumeralAlignment="Tabular" Text="--" FontSize="{StaticResource CardFont.Title}" FontWeight="SemiBold"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <!-- A thin bar that follows the value, as in the original desktop theme. -->
                        <Grid Height="3" Margin="0,5,8,0">
                            <Rectangle RadiusX="{StaticResource CardRadius.BarValue}" RadiusY="{StaticResource CardRadius.BarValue}" Opacity="0.22"
                                       Fill="{Binding Foreground, ElementName=CpuValueText}"/>
                            <Rectangle x:Name="CpuBar" RadiusX="{StaticResource CardRadius.BarValue}" RadiusY="{StaticResource CardRadius.BarValue}"
                                       Fill="{DynamicResource PerformanceAccentBrush}"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="CpuBarScale" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Width="1" Margin="0,3,10,3" Opacity="0.2"
                               Fill="{Binding Foreground, ElementName=CpuValueText}"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="RamLabelText" Tag="Secondary" Text="RAM" FontSize="{StaticResource CardFont.Caption}" FontWeight="Medium"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock x:Name="RamValueText" Typography.NumeralAlignment="Tabular" Text="--" FontSize="{StaticResource CardFont.Title}" FontWeight="SemiBold"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <!-- A thin bar that follows the value, as in the original desktop theme. -->
                        <Grid Height="3" Margin="0,5,8,0">
                            <Rectangle RadiusX="{StaticResource CardRadius.BarValue}" RadiusY="{StaticResource CardRadius.BarValue}" Opacity="0.22"
                                       Fill="{Binding Foreground, ElementName=RamValueText}"/>
                            <Rectangle x:Name="RamBar" RadiusX="{StaticResource CardRadius.BarValue}" RadiusY="{StaticResource CardRadius.BarValue}"
                                       Fill="{DynamicResource PerformanceAccentBrush}"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RamBarScale" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Width="1" Margin="0,3,10,3" Opacity="0.2"
                               Fill="{Binding Foreground, ElementName=CpuValueText}"/>
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,3" x:Name="NetworkLabelText" Tag="Secondary" Text="NETWORK" FontSize="{StaticResource CardFont.Caption}" FontWeight="Medium"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock Grid.Row="1" Margin="0,0,6,0" x:Name="UploadLabelText" Text="↑" FontSize="{StaticResource CardFont.Meta}" FontWeight="Bold"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock x:Name="UploadValueText" Typography.NumeralAlignment="Tabular" Grid.Row="1" Grid.Column="1" Text="--" FontSize="{StaticResource CardFont.Meta}"
                                   FontWeight="Bold" Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock Grid.Row="2" Margin="0,0,6,0" x:Name="DownloadLabelText" Text="↓" FontSize="{StaticResource CardFont.Meta}" FontWeight="Bold"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock x:Name="DownloadValueText" Typography.NumeralAlignment="Tabular" Grid.Row="2" Grid.Column="1" Text="--" FontSize="{StaticResource CardFont.Meta}"
                                   FontWeight="Bold" Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="WeatherCard"
                    Grid.Row="2"
                    Margin="10,8,10,6"
                    Padding="12,7"
                    VerticalAlignment="Top"
                    Background="{DynamicResource WidgetItemSurfaceBrush}"
                    CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- A thin rule over the city, as in the original desktop theme. -->
                    <Rectangle Height="1" Margin="0,0,0,7" Opacity="0.2" Fill="{Binding Foreground, ElementName=WeatherCityText}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WeatherCityText"
                                   FontSize="{StaticResource CardFont.Subhead}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock x:Name="WeatherUpdatedText"
                                   Tag="Secondary"
                                   Grid.Column="1"
                                   Margin="8,0,2,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource CardFont.Meta}"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <Button x:Name="WeatherRefreshButton"
                                Grid.Column="2"
                                Width="24"
                                Height="22"
                                Padding="0"
                                Opacity="0.7"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="{StaticResource CardFont.Subhead}"
                                Content="↻"
                                ToolTip="立即刷新天气"
                                AutomationProperties.Name="刷新天气"
                                Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                Click="WeatherRefresh_Click"/>
                    </Grid>
                    <!-- A large light temperature with the sky and the day's range beside it. -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WeatherTempText"
                                   Text="--"
                                   FontSize="{StaticResource CardFont.DisplayWeather}"
                                   FontWeight="Light"
                                   Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="WeatherIconPath"
                                  Width="24"
                                  Height="24"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  StrokeThickness="1.75"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stroke="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                            <TextBlock x:Name="WeatherConditionText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource CardFont.Title}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        </Grid>
                    </Grid>
                    <local:WholeCellRowPanel x:Name="WeatherDetailsPanel"
                                             Grid.Row="3"
                                             Margin="0,2,0,0"
                                             Gap="12"
                                             ClipToBounds="True">
                        <TextBlock x:Name="WeatherHighText"
                                   Tag="Secondary"
                                   FontSize="{StaticResource CardFont.Meta}"
                                   TextWrapping="NoWrap"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock x:Name="WeatherLowText"
                                   Tag="Secondary"
                                   FontSize="{StaticResource CardFont.Meta}"
                                   TextWrapping="NoWrap"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                        <TextBlock x:Name="WeatherHumidityText"
                                   Tag="Secondary"
                                   FontSize="{StaticResource CardFont.Meta}"
                                   TextWrapping="NoWrap"
                                   Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                    </local:WholeCellRowPanel>
                    <TextBlock Grid.Row="4"
                               x:Name="WeatherStatusText"
                               Margin="0,1,0,0"
                               FontSize="{StaticResource CardFont.Caption}"
                               TextWrapping="Wrap"
                               Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="Surface"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="{Binding SurfaceCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                IsHitTestVisible="False"/>
        <Button x:Name="SettingsButton"
                AutomationProperties.Name="打开桌面信息设置"
                Style="{StaticResource WidgetSelectedOnlySettingsButtonStyle}"
                Width="30"
                Height="28"
                Margin="0,6,6,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                FontSize="{StaticResource CardFont.Subhead}"
                Content="•••"
                ToolTip="设置"
                Click="Settings_Click"/>
    </Grid>
</local:WidgetWindowBase>
