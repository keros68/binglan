                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="QuickPlacesSettingsCard"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="Kind:QuickLaunch"
                                            local:SettingsSearch.Title="快捷入口">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="快捷入口内容"/>
                                    <Border Style="{StaticResource SettingsPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,10"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="选中一项后可换图标、改名称和位置；位置可以是文件夹、程序或文件。最多 12 个。"/>
                                            <ListBox x:Name="QuickPlaceList"
                                                     MaxHeight="210"
                                                     AutomationProperties.Name="快捷入口列表"
                                                     SelectionChanged="QuickPlaceList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="16"
                                                                       VerticalAlignment="Center" Text="{Binding Glyph}"/>
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Target}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource IceMutedInkBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="添加" Click="QuickPlaceAdd_Click"/>
                                                <Button Margin="8,0,0,0" Content="删除" Click="QuickPlaceRemove_Click"/>
                                                <Button Margin="8,0,0,0" Content="上移" Click="QuickPlaceUp_Click"/>
                                                <Button Margin="8,0,0,0" Content="下移" Click="QuickPlaceDown_Click"/>
                                                <Button Margin="8,0,0,0" Content="恢复默认" Click="QuickPlaceReset_Click"/>
                                            </WrapPanel>
                                            <Grid x:Name="QuickPlaceEditor" Margin="0,14,0,0" IsEnabled="False">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="图标"/>
                                                <ComboBox x:Name="QuickPlaceIconPicker"
                                                          Grid.Column="1"
                                                          AutomationProperties.Name="快捷入口图标"
                                                          SelectionChanged="QuickPlaceIcon_SelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Width="26" FontFamily="{StaticResource SettingsIconFont}"
                                                                           FontSize="15" VerticalAlignment="Center" Text="{Binding Glyph}"/>
                                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="名称"/>
                                                <TextBox x:Name="QuickPlaceNameEditor"
                                                         Grid.Row="1"
                                                         Grid.Column="1"
                                                         Margin="0,8,0,0"
                                                         MaxLength="20"
                                                         AutomationProperties.Name="快捷入口名称"
                                                         LostFocus="QuickPlaceName_Commit"
                                                         KeyDown="QuickPlaceEditor_KeyDown"/>
                                                <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="位置"/>
                                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="QuickPlaceTargetEditor"
                                                             AutomationProperties.Name="快捷入口位置"
                                                             ToolTip="文件夹、程序或文件的路径；按回车或离开输入框后生效"
                                                             LostFocus="QuickPlaceTarget_Commit"
                                                             KeyDown="QuickPlaceEditor_KeyDown"/>
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="选文件夹…" Click="QuickPlaceChooseFolder_Click"/>
                                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="选程序或文件…" Click="QuickPlaceChooseFile_Click"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 所有待办卡片都走内置组件分支，周历设置只在选中待办时显示。 -->
                                <StackPanel x:Name="TodoSettingsPanel"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="Todo"
                                            local:SettingsSearch.Title="待办便签">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="周历"/>
