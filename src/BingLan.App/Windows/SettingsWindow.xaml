                                    <ComboBoxItem Content="紧凑（8）" Tag="8"/>
                                    <ComboBoxItem Content="标准（16）" Tag="16"/>
                                    <ComboBoxItem Content="宽松（24）" Tag="24"/>
                                </ComboBox>
                            </local:SettingsRow>
                            <local:SettingsRow Header="网格对齐"
                                               Description="拖动卡片时显示网格并对齐到格点，代替就近卡片对齐；按住 Alt 拖动可临时自由移动"
                                               local:SettingsSearch.Keywords="吸附 对齐">
                                <CheckBox x:Name="GridSnapCheckBox"
                                          AutomationProperties.Name="网格对齐"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="GridSnapCheckBox_Changed"
                                          Unchecked="GridSnapCheckBox_Changed"/>
                            </local:SettingsRow>
                            <local:SettingsRow Header="标题栏按钮仅在鼠标移上时显示"
                                               Description="待办和文件收纳盒的按钮在悬停或键盘选中时显示，位置保持不变"
                                               local:SettingsSearch.Keywords="悬停 隐藏按钮 桌面分组盒 分组盒 文件盒 文件收纳盒 围栏 Fences">
                                <CheckBox x:Name="HeaderToolsOnHoverCheckBox"
                                          AutomationProperties.Name="标题栏按钮仅在鼠标移上时显示"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="HeaderToolsOnHoverCheckBox_Changed"
                                          Unchecked="HeaderToolsOnHoverCheckBox_Changed"/>
                            </local:SettingsRow>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AppearanceLayoutFold"
                              Margin="0,12,0,4"
                              Style="{StaticResource SettingsFoldStyle}"
                              AutomationProperties.Name="布局预设与主题">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FoldTitleStyle}" Text="布局预设与主题"/>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="布局预设 · 主题包 · 从 Rainmeter 导入"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <local:SettingsRow Header="布局预设"
                                               Description="改变桌面卡片的摆放位置，选好后点击“应用布局”"
                                               local:SettingsSearch.Keywords="布局 摆放">
                                <Button x:Name="ApplyLayoutButton"
                                        MinWidth="110"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="应用布局"
                                        Click="ApplyLayout_Click"/>
                            </local:SettingsRow>
                            <Border Padding="18,0,18,14">
                                <StackPanel>
                                    <Border Height="230"
                                            Margin="0,0,0,12"
                                            Background="{DynamicResource SettingsPreviewBrush}"
                                            BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Image x:Name="PresetPreviewImage" Stretch="Uniform"/>
                                    </Border>
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="QuietInformationPresetRadio"
                                                     AutomationProperties.Name="静谧信息层布局"
                                                     Margin="0,0,6,0"
                                                     GroupName="LayoutPreset"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="QuietInformation"
                                                     Checked="PresetRadio_Checked">
                                            <StackPanel>
                                                <Border Height="80" CornerRadius="6" ClipToBounds="True">
                                                    <Image x:Name="QuietPresetThumb" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Text="静谧信息层"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="GlacierWorkbenchPresetRadio"
                                                     AutomationProperties.Name="冰川工作台布局"
                                                     Margin="3,0"
                                                     GroupName="LayoutPreset"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="GlacierWorkbench"
                                                     Checked="PresetRadio_Checked">
                                            <StackPanel>
                                                <Border Height="80" CornerRadius="6" ClipToBounds="True">
                                                    <Image x:Name="GlacierPresetThumb" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Text="冰川工作台"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TransparentApplePresetRadio"
                                                     AutomationProperties.Name="通透苹果桌面布局"
                                                     Margin="3,0"
                                                     GroupName="LayoutPreset"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="TransparentApple"
                                                     Checked="PresetRadio_Checked">
                                            <StackPanel>
                                                <Border Height="80" CornerRadius="6" ClipToBounds="True">
                                                    <Image x:Name="ApplePresetThumb" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Text="通透苹果桌面"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="CenterClockPresetRadio"
                                                     AutomationProperties.Name="居中时钟布局"
                                                     Margin="6,0,0,0"
                                                     GroupName="LayoutPreset"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="CenterClock"
                                                     Checked="PresetRadio_Checked">
                                            <StackPanel>
                                                <Border Height="80" CornerRadius="6" ClipToBounds="True">
                                                    <Image x:Name="CenterClockPresetThumb" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Text="居中时钟"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock x:Name="LayoutStatusText"
                                               Margin="2,10,0,0"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                            </Border>
                            <local:SettingsRow Header="主题包"
                                               Description="包含颜色、材质、圆角、字号、相对布局和 Dock 应用槽位；不含姓名、城市、待办和文件映射"
                                               local:SettingsSearch.Keywords="导出 导入 分享">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导出主题…" Click="ExportTheme_Click"/>
                                    <Button Margin="8,0,0,0" Content="导入主题…" Click="ImportTheme_Click"/>
                                </StackPanel>
                            </local:SettingsRow>
                            <TextBlock x:Name="ThemeStatusText"
                                       Margin="18,0,18,10"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionStyle}"/>
                            <local:SettingsRow Header="从 Rainmeter 皮肤导入"
                                               Description="只读取字体、颜色和圆角，导入后不保持关联"
                                               local:SettingsSearch.Keywords="雨滴 皮肤">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RainmeterImportStatusText"
                                               MaxWidth="220"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource CaptionStyle}"/>
                                    <Button Content="选择皮肤…"
                                            AutomationProperties.Name="从 Rainmeter 皮肤导入外观"
                                            Click="ImportRainmeterLook_Click"/>
                                </StackPanel>
                            </local:SettingsRow>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- 桌面卡片 -->
            <Grid x:Name="ComponentsPage"
                  Margin="36,28,36,24"
                  Visibility="Collapsed"
                  local:SettingsSearch.Keywords="桌面组件 组件">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="桌面卡片"/>
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="选择一张卡片，在右侧调整显示、内容和外观；修改立即生效。"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,6" Orientation="Horizontal">
                        <Button x:Name="AddTodoButton" AutomationProperties.Name="新建待办便签" Click="AddTodo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonGlyphStyle}" Text="&#xE710;"/>
                                <TextBlock Text="待办便签"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddNoteButton" Margin="8,0,0,0" AutomationProperties.Name="新建普通便签" Click="AddNote_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonGlyphStyle}" Text="&#xE710;"/>
                                <TextBlock Text="普通便签"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddFileBoxButton" Margin="8,0,0,0" AutomationProperties.Name="新建文件收纳盒" Click="AddFileBox_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonGlyphStyle}" Text="&#xE710;"/>
                                <TextBlock Text="文件收纳盒"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="DesktopComponentList"
                                 VerticalAlignment="Stretch"
                                 AutomationProperties.Name="桌面卡片列表"
                                 Padding="6"
                                 Background="{DynamicResource SettingsSurfaceBrush}"
                                 BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                                 ItemContainerStyle="{StaticResource ComponentListItemStyle}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="DesktopComponentList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="Medium"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="7,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SettingsBadgeBrush}"
                                                CornerRadius="8">
                                            <TextBlock FontSize="11"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource SettingsBadgeTextBrush}"
                                                       Text="{Binding Status}"/>
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   FontWeight="Normal"
                                                   Text="{Binding TypeName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SettingsSelectedTextBrush}"/>
                                                            <Setter Property="Opacity" Value="0.78"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="ComponentListOverflowFade"
                                Height="22"
                                Margin="1,0,1,1"
                                VerticalAlignment="Bottom"
                                CornerRadius="0,0,7,7"
                                Background="{DynamicResource SettingsSurfaceBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#E6000000"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border x:Name="ComponentListOverflowBar"
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                Padding="10,5"
                                CornerRadius="8"
                                Background="{DynamicResource SettingsSurfaceBrush}"
                                BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                ToolTip="点击向下滚动查看更多卡片"
                                MouseLeftButtonUp="ComponentListOverflowBar_MouseLeftButtonUp">
                            <TextBlock x:Name="ComponentListOverflowText"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="BuiltInComponentHeaderBar"
                                Style="{StaticResource SettingsPanelStyle}"
                                Padding="16,12"
                                Margin="0,0,6,12"
                                local:SettingsSearch.Scope="Builtin"
                                local:SettingsSearch.Title="信息卡片">
                            <StackPanel>
                                <TextBlock x:Name="SelectedComponentHeadingText"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SelectedComponentCaptionText"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="未锁定时可直接拖动桌面空白区。"/>
                                <Grid x:Name="BuiltInComponentTitleRow"
                                      Margin="0,10,0,0"
                                      Visibility="Collapsed"
                                      local:SettingsSearch.Scope="Todo"
                                      local:SettingsSearch.Title="待办便签">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="名称"/>
                                    <TextBox x:Name="SelectedComponentTitleEditor"
                                             Grid.Column="1"
                                             MinWidth="220"
                                             MaxWidth="280"
                                             HorizontalAlignment="Left"
                                             MaxLength="60"
                                             AutomationProperties.Name="待办卡片名称"
                                             ToolTip="按回车或离开输入框保存，留空恢复默认名称"
                                             local:SettingsSearch.EntryName="卡片名称"
                                             local:SettingsSearch.Keywords="名称 标题 重命名 改名 待办"
                                             KeyDown="ComponentTitleEditor_KeyDown"
                                             LostFocus="ComponentTitleEditor_LostFocus"/>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="SelectedComponentVisibleCheckBox"
                                              Margin="0,4,14,0"
                                              Content="显示"
                                              AutomationProperties.Name="显示此组件"
                                              local:SettingsSearch.EntryName="显示此组件"
                                              local:SettingsSearch.Keywords="桌面组件 桌面卡片 显示 隐藏 开关"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="ComponentToggle_Changed"
                                              Unchecked="ComponentToggle_Changed"/>
                                    <CheckBox x:Name="SelectedComponentLockedCheckBox"
                                              Margin="0,4,14,0"
                                              Content="锁定位置"
                                              AutomationProperties.Name="锁定卡片位置"
                                              local:SettingsSearch.EntryName="锁定卡片位置"
                                              local:SettingsSearch.Keywords="锁定 位置 拖动"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="ComponentToggle_Changed"
                                              Unchecked="ComponentToggle_Changed"/>
                                    <Button x:Name="ResetComponentPlacementButton"
                                            Margin="0,4,8,0"
                                            Content="恢复默认位置"
                                            AutomationProperties.Name="恢复默认位置"
                                            local:SettingsSearch.EntryName="恢复默认位置"
                                            local:SettingsSearch.Keywords="位置 恢复 默认 重置"
                                            Click="ResetComponentPlacement_Click"/>
                                    <Button x:Name="DeleteComponentButton"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Content="从桌面移除"
                                            AutomationProperties.Name="从桌面移除"
                                            local:SettingsSearch.EntryName="删除此卡片"
                                            local:SettingsSearch.Keywords="删除 移除 从桌面移除 隐藏 位置"
                                            Click="DeleteComponent_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SelectedWidgetHeaderBar"
                                Style="{StaticResource SettingsPanelStyle}"
                                Padding="16,12"
                                Margin="0,0,6,12"
                                Visibility="Collapsed"
                                local:SettingsSearch.Scope="Widget"
                                local:SettingsSearch.Title="便签与文件收纳盒">
                            <StackPanel>
                                <TextBlock x:Name="SelectedWidgetHeadingText"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SelectedWidgetCaptionText"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="未锁定时可直接拖动空白区；修改名称后立即同步到桌面卡片。"/>
                                <Grid x:Name="SelectedWidgetTitleRow" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="名称"/>
                                    <TextBox x:Name="SelectedWidgetTitleEditor"
                                             Grid.Column="1"
                                             MinWidth="220"
                                             MaxWidth="280"
                                             HorizontalAlignment="Left"
                                             MaxLength="60"
                                             AutomationProperties.Name="卡片名称"
                                             ToolTip="按回车或离开输入框保存，留空恢复默认名称"
                                             local:SettingsSearch.EntryName="卡片名称"
                                             local:SettingsSearch.Keywords="名称 标题 重命名 改名 文件收纳盒 分组盒 桌面分组盒 便签"
                                             KeyDown="WidgetTitleEditor_KeyDown"
                                             LostFocus="WidgetTitleEditor_LostFocus"/>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="SelectedWidgetVisibleCheckBox"
                                              Margin="0,4,14,0"
                                              Content="显示"
                                              AutomationProperties.Name="显示此卡片"
                                              local:SettingsSearch.EntryName="显示此卡片"
                                              local:SettingsSearch.Keywords="桌面组件 桌面卡片 显示 隐藏 开关"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Click="SelectedWidgetVisibleCheckBox_Click"/>
                                    <CheckBox x:Name="SelectedWidgetLockedCheckBox"
                                              Margin="0,4,14,0"
                                              Content="锁定位置"
                                              AutomationProperties.Name="锁定所选卡片位置"
                                              local:SettingsSearch.EntryName="锁定卡片位置"
                                              local:SettingsSearch.Keywords="锁定 位置 拖动"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Click="SelectedWidgetLockedCheckBox_Click"/>
                                    <Button x:Name="ResetWidgetPlacementButton"
                                            Margin="0,4,8,0"
                                            Content="恢复默认位置"
                                            AutomationProperties.Name="恢复默认位置"
                                            local:SettingsSearch.EntryName="恢复默认位置"
                                            local:SettingsSearch.Keywords="位置 恢复 默认 重置"
                                            Click="ResetComponentPlacement_Click"/>
                                    <Button x:Name="DeleteWidgetButton"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Content="删除此卡片"
                                            AutomationProperties.Name="删除此卡片"
                                            local:SettingsSearch.EntryName="删除此卡片"
                                            local:SettingsSearch.Keywords="删除 移除 位置"
                                            Click="DeleteComponent_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="ComponentDetailsScrollViewer"
                                      Grid.Row="1"
                                      Style="{StaticResource PageScrollStyle}">
                            <StackPanel Margin="0,0,6,8">
                                <StackPanel x:Name="BuiltInComponentEditorPanel"
                                            local:SettingsSearch.Scope="Builtin"
                                            local:SettingsSearch.Title="信息卡片">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="2,4,0,10" Text="外观与配色"/>
                                <local:SettingsGroup>
                                    <local:SettingsRow x:Name="ComponentUnifiedLookGuideRow"
                                                       Header="统一外观与配色"
                                                       local:SettingsSearch.Keywords="配色 颜色 统一 全局 浅色 深色 无底板">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ComponentQuickFollowGlobalButton"
                                                    Margin="0,0,8,0"
                                                    Visibility="Collapsed"
                                                    Content="恢复跟随"
                                                    AutomationProperties.Name="恢复跟随全局统一配色"
                                                    Click="ComponentFollowSharedLook_Click"/>
                                            <Button x:Name="GoToUnifiedAppearanceButton"
                                                    Content="统一配色设置 →"
                                                    AutomationProperties.Name="前往外观样式页调整全局统一配色"
                                                    Click="GoToUnifiedAppearance_Click"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                </local:SettingsGroup>

                                <StackPanel x:Name="DisplayContentSettingsCard"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="Kind:TimeDate"
                                            local:SettingsSearch.Title="时间与问候">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="时间与问候"/>
                                    <local:SettingsGroup>
                                        <local:SettingsRow Header="问候称呼" Description="显示在问候语里的名字" local:SettingsSearch.Keywords="名字 昵称">
                                            <TextBox x:Name="GreetingNameEditor"
                                                     Width="220"
                                                     AutomationProperties.Name="问候称呼"
                                                     TextChanged="DisplaySettings_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="使用 24 小时制" local:SettingsSearch.Keywords="时间 时钟 12 小时">
                                            <CheckBox x:Name="Use24HourClockCheckBox"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DisplaySettings_Changed"
                                                      Unchecked="DisplaySettings_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="ShowClockDateRow"
                                                           Header="显示日期"
                                                           local:SettingsSearch.Keywords="时间 时钟 日期 星期 隐藏日期">
                                            <CheckBox x:Name="ShowClockDateCheckBox"
                                                      AutomationProperties.Name="显示日期"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DisplaySettings_Changed"
                                                      Unchecked="DisplaySettings_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="ClockLayoutRow"
                                                           Header="时钟版式"
                                                           Description="选择时钟排版样式；已手动选择的字体、字号与文字颜色会继续保留"
                                                           local:SettingsSearch.Keywords="时钟 预设 排版 经典 极简大数字 日期海报 纵向数字">
                                            <ComboBox x:Name="ClockLayoutSelector"
                                                      Width="168"
                                                      AutomationProperties.Name="时钟版式"
                                                      SelectionChanged="ClockLayout_SelectionChanged">
                                                <ComboBoxItem Content="经典" Tag="Classic"/>
                                                <ComboBoxItem Content="极简大数字" Tag="MinimalDigits"/>
                                                <ComboBoxItem Content="日期海报" Tag="DatePoster"/>
                                                <ComboBoxItem Content="纵向数字" Tag="VerticalDigits"/>
                                            </ComboBox>
                                        </local:SettingsRow>
                                    </local:SettingsGroup>
                                    <TextBlock x:Name="DisplaySettingsStatusText"
                                               Margin="2,6,0,0"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="修改后立即生效"/>
                                </StackPanel>

                                <StackPanel x:Name="WeatherContentSettingsCard"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="Kind:Weather"
                                            local:SettingsSearch.Title="天气">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="天气城市" local:SettingsSearch.Keywords="城市 位置 地区"/>
