                                                         Width="110"
                                                         Margin="8,0,0,0"
                                                         AutomationProperties.Name="文字颜色"
                                                         TextChanged="ComponentEditor_TextChanged"/>
                                                <Button Margin="8,0,0,0"
                                                        Content="选择颜色…"
                                                        Tag="Text"
                                                        AutomationProperties.Name="选择卡片文字颜色"
                                                        Click="ComponentColorPicker_Click"/>
