                                <local:SettingsGroup>
                                    <local:SettingsRow x:Name="SelectedWidgetUnifiedLookGuideRow"
                                                       Header="统一外观与配色"
                                                       local:SettingsSearch.Keywords="配色 颜色 统一 全局 浅色 深色 无底板">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SelectedWidgetQuickFollowGlobalButton"
                                                    Margin="0,0,8,0"
                                                    Visibility="Collapsed"
                                                    Content="恢复跟随"
                                                    AutomationProperties.Name="这张卡片快捷恢复跟随全局统一配色"
                                                    Click="SelectedWidgetFollowSharedLook_Click"/>
                                            <Button x:Name="GoToWidgetUnifiedAppearanceButton"
                                                    Content="统一配色设置 →"
                                                    AutomationProperties.Name="前往外观样式页调整全局统一配色"
                                                    Click="GoToUnifiedAppearance_Click"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                </local:SettingsGroup>
                                <StackPanel x:Name="FileBoxViewModePanel"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="FileBox"
                                            local:SettingsSearch.Title="文件收纳盒">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="内容"/>
                                    <local:SettingsGroup>
                                        <local:SettingsRow x:Name="FileBoxViewModeRow"
                                                           Header="显示为"
                                                           Description="把常用文件归类放桌面上，只记路径不搬原文件。列表每行一个项目更省空间；图标用大图便于辨认，切换不影响映射内容"
                                                           local:SettingsSearch.Keywords="桌面分组盒 分组盒 文件盒 文件收纳盒 围栏 Fences 视图 图标 列表">
                                            <Border Style="{StaticResource SegmentHostStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="FileBoxTilesRadio"
                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                 AutomationProperties.Name="图标视图"
                                                                 Checked="FileBoxViewMode_Changed"
                                                                 Content="图标"/>
                                                    <RadioButton x:Name="FileBoxListRadio"
                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                 AutomationProperties.Name="列表视图"
                                                                 Checked="FileBoxViewMode_Changed"
                                                                 Content="列表"/>
                                                </StackPanel>
                                            </Border>
