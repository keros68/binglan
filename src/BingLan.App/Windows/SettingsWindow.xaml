                                                             Width="110"
                                                             Margin="8,0,0,0"
                                                             AutomationProperties.Name="标题栏颜色"
                                                             TextChanged="ComponentEditor_TextChanged"/>
                                                    <Button Margin="8,0,0,0"
                                                            Content="选择颜色…"
                                                            Tag="Header"
                                                            AutomationProperties.Name="选择卡片标题栏颜色"
                                                            Click="ComponentColorPicker_Click"/>
                                                    <Button Margin="6,0,0,0" Content="白" Tag="#FFFFFF" AutomationProperties.Name="标题栏颜色设为白色" Click="QuickHeaderColor_Click"/>
                                                    <Button Margin="6,0,0,0" Content="蓝" Tag="#A0B4E1" AutomationProperties.Name="标题栏颜色设为冰蓝" Click="QuickHeaderColor_Click"/>
                                                </StackPanel>
                                            </local:SettingsRow>
                                            <local:SettingsRow Header="标题栏不透明度">
                                                <StackPanel Orientation="Horizontal">
                                                    <Slider x:Name="SelectedComponentHeaderOpacitySlider"
                                                            Width="190"
                                                            AutomationProperties.Name="标题栏不透明度"
                                                            Minimum="0"
                                                            Maximum="1"
                                                            TickFrequency="0.04"
                                                            ValueChanged="ComponentStyleSlider_ValueChanged"/>
                                                    <TextBlock x:Name="SelectedComponentHeaderOpacityValueText" Style="{StaticResource ValueTextStyle}"/>
                                                </StackPanel>
                                            </local:SettingsRow>
                                        </StackPanel>
                                        <local:SettingsRow Header="玻璃浓度" local:SettingsSearch.Keywords="透明度 不透明">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="SelectedComponentOpacitySlider"
                                                        Width="190"
                                                        AutomationProperties.Name="玻璃浓度"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        TickFrequency="0.04"
                                                        ValueChanged="ComponentStyleSlider_ValueChanged"/>
                                                <TextBlock x:Name="SelectedComponentOpacityValueText" Style="{StaticResource ValueTextStyle}"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="圆角" local:SettingsSearch.Keywords="形状 卡片圆角">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="SelectedComponentCornerRadiusSlider"
                                                        Width="190"
                                                        AutomationProperties.Name="组件圆角"
                                                        Minimum="0"
                                                        Maximum="32"
                                                        TickFrequency="1"
                                                        ValueChanged="ComponentStyleSlider_ValueChanged"/>
                                                <TextBlock x:Name="SelectedComponentCornerRadiusValueText" Style="{StaticResource ValueTextStyle}"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="SelectedComponentDensityRow" Header="信息密度">
                                            <ComboBox x:Name="SelectedComponentDensitySelector"
                                                      Width="160"
                                                      AutomationProperties.Name="信息密度"
                                                      SelectionChanged="ComponentDensity_SelectionChanged">
                                                <ComboBoxItem Content="舒适" Tag="Comfortable"/>
                                                <ComboBoxItem Content="标准" Tag="Standard"/>
                                                <ComboBoxItem Content="紧凑" Tag="Compact"/>
                                            </ComboBox>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="卡片尺寸" local:SettingsSearch.Keywords="宽度 高度 大小">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="宽"/>
                                                <TextBox x:Name="SelectedComponentWidthEditor" Width="80" AutomationProperties.Name="卡片宽度" TextChanged="ComponentEditor_TextChanged"/>
                                                <TextBlock Margin="14,0,6,0" VerticalAlignment="Center" Text="高"/>
                                                <TextBox x:Name="SelectedComponentHeightEditor" Width="80" AutomationProperties.Name="卡片高度" TextChanged="ComponentEditor_TextChanged"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <StackPanel x:Name="SelectedWidgetEditorPanel"
                                        Visibility="Collapsed"
                                        local:SettingsSearch.Scope="Widget"
                                        local:SettingsSearch.Title="便签与分组盒">
                                <TextBlock x:Name="SelectedWidgetHeadingText"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="2,20,0,10" Text="显示与位置"/>
                                <local:SettingsGroup>
                                    <local:SettingsRow Header="锁定卡片位置" Description="未锁定时可直接拖动卡片空白处">
                                        <CheckBox x:Name="SelectedWidgetLockedCheckBox"
                                                  AutomationProperties.Name="锁定所选卡片位置"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="SelectedWidgetLockedCheckBox_Click"/>
                                    </local:SettingsRow>
                                    <local:SettingsRow Header="位置">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ResetWidgetPlacementButton"
                                                    Content="恢复默认位置"
                                                    Click="ResetComponentPlacement_Click"/>
                                            <Button Margin="8,0,0,0"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Content="删除此卡片"
                                                    Click="DeleteComponent_Click"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                </local:SettingsGroup>
                                <StackPanel x:Name="FileBoxViewModePanel"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="FileBox"
                                            local:SettingsSearch.Title="分组盒">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="内容"/>
                                    <local:SettingsGroup>
                                        <local:SettingsRow Header="显示为"
                                                           Description="列表每行一个项目，占用空间更小；图标用大图便于辨认。只改变显示方式，不影响映射内容"
                                                           local:SettingsSearch.Keywords="视图 图标 列表">
                                            <Border Style="{StaticResource SegmentHostStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="FileBoxTilesRadio"
                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                 AutomationProperties.Name="图标视图"
                                                                 Checked="FileBoxViewMode_Changed"
                                                                 Content="图标"/>
                                                    <RadioButton x:Name="FileBoxListRadio"
                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                 AutomationProperties.Name="列表视图"
                                                                 Checked="FileBoxViewMode_Changed"
                                                                 Content="列表"/>
                                                </StackPanel>
                                            </Border>
                                        </local:SettingsRow>
                                    </local:SettingsGroup>
                                </StackPanel>
                                <StackPanel x:Name="FileBoxCollectPanel"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="FileBox"
                                            local:SettingsSearch.Title="分组盒">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="自动整理时收纳" local:SettingsSearch.Keywords="整理 类型 扩展名"/>
                                    <Border Style="{StaticResource SettingsPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,10"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="点击分组盒底部的“自动整理”时，桌面上这些类型的项目会放进这个盒子。几个盒子都勾选同一类型时，放进列表中靠前的盒子。"/>
                                            <WrapPanel x:Name="FileBoxCollectTypes"/>
