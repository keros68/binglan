                                        <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource IceMutedInkBrush}" Text="原文件"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SettingsFaintInkBrush}" Text=" · 对所有分组盒生效"/>
                                    </StackPanel>
                                    <local:SettingsGroup>
                                        <local:SettingsRow Header="分组盒自动刷新"
                                                           Description="自动收纳新的桌面项目，只记录路径，不移动原文件；对所有分组盒生效"
                                                           local:SettingsSearch.Keywords="收纳 刷新">
                                            <CheckBox x:Name="FileBoxAutomationCheckBox"
                                                      AutomationProperties.Name="分组盒自动刷新"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="FileBoxAutomationCheckBox_Changed"
                                                      Unchecked="FileBoxAutomationCheckBox_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="允许从分组盒删除原文件"
                                                           Description="默认关闭；每次删除前确认，并移入回收站；对所有分组盒生效"
                                                           local:SettingsSearch.Keywords="删除 回收站">
                                            <CheckBox x:Name="FileBoxDeleteOriginalsCheckBox"
                                                      AutomationProperties.Name="允许从分组盒删除原文件"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="FileBoxDeleteOriginalsCheckBox_Changed"
                                                      Unchecked="FileBoxDeleteOriginalsCheckBox_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="桌面上的原图标"
                                                           Description="收纳只记录位置，不移动也不隐藏原文件。要隐藏 Windows 桌面图标，请开启“清爽桌面”；退出冰蓝桌面时自动恢复">
                                            <Button x:Name="GoToCleanDesktopButton"
                                                    Content="前往开启清爽桌面"
                                                    Click="GoToCleanDesktop_Click"/>
                                        </local:SettingsRow>
                                    </local:SettingsGroup>
                                </StackPanel>
                                <Expander x:Name="SelectedWidgetOwnLookFold"
                                          Margin="0,24,0,4"
                                          Style="{StaticResource SettingsFoldStyle}"
                                          AutomationProperties.Name="独立外观">
                                    <Expander.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FoldTitleStyle}" Text="独立外观"/>
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="这张卡片自己的颜色、圆角、尺寸和标题字体"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border Padding="18,4,18,14">
                                        <ContentControl x:Name="SelectedWidgetAppearanceHost" Focusable="False"/>
                                    </Border>
                                </Expander>
                            </StackPanel>

                            <TextBlock x:Name="ComponentSettingsStatusText"
                                       Margin="2,10,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="修改后立即生效"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 顶栏底栏 -->
            <ScrollViewer x:Name="BarsPage" Style="{StaticResource PageScrollStyle}" Visibility="Collapsed">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="顶栏底栏"/>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="屏幕顶部和底部的三条栏。点下图中的位置，直接跳到对应设置。"/>

                    <Border x:Name="BarsScreenMap"
                            Height="210"
                            Margin="0,18,0,0"
                            Background="{DynamicResource SettingsMapWallpaperBrush}"
                            CornerRadius="14"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="ScreenMapTopBarButton"
                                    Style="{StaticResource ScreenMapButtonStyle}"
                                    Background="{DynamicResource SettingsMapBarBrush}"
                                    Tag="14,14,0,0"
                                    AutomationProperties.Name="跳到顶端信息条设置"
                                    Click="ScreenMap_Click"
                                    CommandParameter="TopBar">
                                <TextBlock>
                                    <Run Text="顶端信息条"/>
                                    <Run Text="  时间 · 天气 · 搜索" FontSize="11" Foreground="{DynamicResource SettingsMapDeskTextBrush}"/>
                                </TextBlock>
                            </Button>
                            <TextBlock Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource SettingsMapDeskTextBrush}"
                                       Text="桌面"/>
                            <Button x:Name="ScreenMapDockButton"
                                    Grid.Row="2"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ScreenMapButtonStyle}"
                                    Background="{DynamicResource SettingsMapDockBrush}"
                                    Tag="12"
                                    AutomationProperties.Name="跳到冰蓝 Dock 设置"
                                    Click="ScreenMap_Click"
                                    CommandParameter="Dock">
                                <TextBlock Margin="10,1">
                                    <Run Text="冰蓝 Dock"/>
                                    <Run Text="  常用应用" FontSize="11" Foreground="{DynamicResource SettingsMapDeskTextBrush}"/>
                                </TextBlock>
                            </Button>
                            <Button x:Name="ScreenMapTaskbarButton"
                                    Grid.Row="3"
                                    Style="{StaticResource ScreenMapButtonStyle}"
                                    Background="{DynamicResource SettingsMapTaskbarBrush}"
                                    Tag="0,0,14,14"
                                    AutomationProperties.Name="跳到 Windows 任务栏设置"
                                    Click="ScreenMap_Click"
                                    CommandParameter="Taskbar">
                                <TextBlock>
                                    <Run Text="Windows 任务栏"/>
                                    <Run Text="  系统自带" FontSize="11" Foreground="{DynamicResource SettingsMapDeskTextBrush}"/>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel Margin="2,12,0,0" Orientation="Horizontal">
                        <TextBlock Margin="0,1,8,0"
                                   VerticalAlignment="Top"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource IceActionBrush}"
                                   Text="&#xE946;"/>
                        <TextBlock x:Name="BarsRelationText" Style="{StaticResource CaptionStyle}" FontSize="13"/>
                    </StackPanel>

                    <Grid Margin="0,16,0,8">
                        <TextBlock x:Name="BarsModeNoteText"
                                   Margin="0,0,170,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionStyle}"/>
                        <Button x:Name="BarsRestoreModeButton"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                Click="RestoreDesktopMode_Click"/>
                    </Grid>

                    <Expander x:Name="DockSection"
                              Margin="0,4,0,4"
                              IsExpanded="True"
                              Style="{StaticResource SettingsFoldStyle}"
                              AutomationProperties.Name="冰蓝 Dock">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FoldTitleStyle}" Text="冰蓝 Dock"/>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="屏幕底部居中显示固定的应用和正在运行的应用"/>
                                </StackPanel>
                                <CheckBox x:Name="DockEnabledCheckBox"
                                          Grid.Column="1"
                                          Margin="16,0,0,0"
                                          AutomationProperties.Name="显示冰蓝 Dock"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="DockSetting_Changed"
                                          Unchecked="DockSetting_Changed"/>
                            </Grid>
                        </Expander.Header>
                        <StackPanel x:Name="DockPage">
                            <StackPanel x:Name="DockOptionsPanel">
                                <local:SettingsRow Header="显示器" local:SettingsSearch.Keywords="屏幕 多显示器">
                                    <ComboBox x:Name="DockMonitorComboBox"
                                              Width="280"
                                              AutomationProperties.Name="Dock 所在显示器"
                                              SelectionChanged="DockSetting_Changed"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="显示方式"
                                                   Description="始终显示时最大化的窗口停在 Dock 上方，全屏应用运行时 Dock 退到后面；智能隐藏时窗口移到 Dock 位置后隐藏，按唤出方式重新显示"
                                                   local:SettingsSearch.Keywords="自动隐藏 保留底部">
                                    <Border Style="{StaticResource SegmentHostStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="DockReserveRadio"
                                                         GroupName="DockVisibility"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Content="始终显示，保留底部空间"
                                                         AutomationProperties.Name="始终显示，并保留屏幕底部空间"
                                                         Checked="DockSetting_Changed"/>
                                            <RadioButton x:Name="DockSmartHideRadio"
                                                         GroupName="DockVisibility"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Content="智能隐藏"
                                                         AutomationProperties.Name="智能隐藏"
                                                         Checked="DockSetting_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </local:SettingsRow>
                                <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}"
                                                   Header="唤出方式"
                                                   Description="Dock 隐藏后如何重新显示。原生任务栏一直显示时，鼠标停在任务栏上不会唤出 Dock：默认用把手唤出；选“只用屏幕底边”则不显示把手，把鼠标推到屏幕最底边唤出">
                                    <ComboBox x:Name="DockRevealModeComboBox"
                                              Width="220"
                                              AutomationProperties.Name="Dock 唤出方式"
                                              SelectionChanged="DockSetting_Changed">
                                        <ComboBoxItem Content="屏幕底边和把手" Tag="EdgeAndHandle"/>
                                        <ComboBoxItem Content="只用把手" Tag="HandleOnly"/>
                                        <ComboBoxItem Content="只用屏幕底边（不显示把手）" Tag="EdgeOnly"/>
                                    </ComboBox>
                                </local:SettingsRow>
                                <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}"
                                                   Header="最大化窗口时让出底部空间"
                                                   Description="开启后最大化的窗口可以占满整个工作区高度，Dock 暂时隐藏；鼠标移到屏幕底边可临时唤出。仅影响“始终显示，保留底部空间”">
                                    <CheckBox x:Name="DockMaximizeReleaseCheckBox"
                                              AutomationProperties.Name="最大化窗口时让出底部空间"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="DockSetting_Changed"
                                              Unchecked="DockSetting_Changed"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="显示 Windows 开始菜单入口"
                                                   Description="显示在 Dock 左端，点击打开原生开始菜单；此设置只保存在本机，不随主题导入或导出"
                                                   local:SettingsSearch.Keywords="开始菜单">
                                    <CheckBox x:Name="DockStartMenuButtonCheckBox"
                                              AutomationProperties.Name="显示 Windows 开始菜单入口"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="DockSetting_Changed"
                                              Unchecked="DockSetting_Changed"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="显示“显示桌面”按钮"
                                                   Description="显示在 Dock 右端，点击收起所有窗口回到桌面，再点恢复；此设置只保存在本机"
                                                   local:SettingsSearch.Keywords="显示桌面 回到桌面 Win+D">
                                    <CheckBox x:Name="DockShowDesktopButtonCheckBox"
                                              AutomationProperties.Name="显示“显示桌面”按钮"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="DockSetting_Changed"
                                              Unchecked="DockSetting_Changed"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="距底部高度" Description="Dock 底边到屏幕底边的距离；任务栏常显时从任务栏上沿算起">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="DockBottomGapSlider"
                                                Width="200"
                                                Minimum="0"
                                                Maximum="64"
                                                TickFrequency="4"
                                                IsSnapToTickEnabled="True"
                                                AutomationProperties.Name="Dock 距底部高度"
                                                ValueChanged="DockBottomGap_Changed"/>
                                        <TextBlock x:Name="DockBottomGapText" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </local:SettingsRow>
                                <local:SettingsRow Header="图标大小" local:SettingsSearch.Keywords="Dock 大小">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="DockIconSizeSlider"
                                                Width="200"
                                                Minimum="32"
                                                Maximum="64"
                                                TickFrequency="4"
                                                IsSnapToTickEnabled="True"
                                                AutomationProperties.Name="Dock 图标大小"
                                                ValueChanged="DockIconSize_Changed"/>
                                        <TextBlock x:Name="DockIconSizeText" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </local:SettingsRow>
                                <local:SettingsRow Header="自动缩小图标" Description="应用较多放不下时自动缩小图标（最小 28），都放不下时可在 Dock 上滚动查看">
                                    <CheckBox x:Name="DockAutoIconSizeCheckBox"
                                              IsChecked="True"
                                              AutomationProperties.Name="Dock 自动缩小图标"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="DockAutoIconSize_Changed"
                                              Unchecked="DockAutoIconSize_Changed"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="动效" Description="图标放大和弹出的动画" local:SettingsSearch.Keywords="动画">
                                    <ComboBox x:Name="MotionSelector"
                                              Width="160"
                                              AutomationProperties.Name="Dock 动效"
                                              SelectionChanged="StyleSelector_SelectionChanged">
                                        <ComboBoxItem Content="标准" Tag="Standard"/>
                                        <ComboBoxItem Content="减弱" Tag="Reduced"/>
                                        <ComboBoxItem Content="关闭" Tag="Off"/>
                                    </ComboBox>
                                </local:SettingsRow>
                                <local:SettingsRow x:Name="DockLookSummaryRow" Header="外观" local:SettingsSearch.Keywords="Dock 颜色 配色">
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Content="在外观样式页调整 →"
                                            Tag="Dock"
                                            AutomationProperties.Name="在外观样式页调整 Dock 外观"
                                            Click="BarsLookJump_Click"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="固定的应用"
                                                   Description="也可以把程序或快捷方式拖到 Dock 上，或在 Dock 中右键正在运行的应用选择“固定到 Dock”；拖动图标可调整顺序"
                                                   local:SettingsSearch.Keywords="固定 Pin 添加应用">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="添加应用…" Click="AddDockApp_Click"/>
                                        <Button Margin="8,0,0,0" Content="导入任务栏应用" Click="ImportTaskbarPins_Click"/>
                                    </StackPanel>
                                </local:SettingsRow>
                                <Border Style="{StaticResource SettingsBlockStyle}" Background="{DynamicResource SettingsSurfaceHoverBrush}" Padding="34,10,18,12">
                                    <StackPanel>
                                        <ListBox x:Name="DockPinnedList"
                                                 MinHeight="96"
                                                 MaxHeight="300"
                                                 AutomationProperties.Name="固定的应用">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource IceMutedInkBrush}"
                                                                   Text="{Binding Detail}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DockPinnedEmptyText"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="还没有固定的应用。"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="上移" Click="MoveDockAppUp_Click"/>
                                            <Button Margin="8,0,0,0" Content="下移" Click="MoveDockAppDown_Click"/>
                                            <Button Margin="8,0,0,0" Content="取消固定" Click="UnpinDockApp_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <local:SettingsRow Header="不在 Dock 中显示的应用"
                                                   Description="在 Dock 中右键正在运行的应用，选择“不在 Dock 中显示此应用”。适合悬浮条、小工具这类不在任务栏显示的窗口"
                                                   local:SettingsSearch.Keywords="隐藏应用">
                                    <Button Content="恢复显示" Click="UnhideDockApp_Click"/>
                                </local:SettingsRow>
                                <Border Style="{StaticResource SettingsBlockStyle}" Background="{DynamicResource SettingsSurfaceHoverBrush}" Padding="34,10,18,12">
                                    <StackPanel>
                                        <ListBox x:Name="DockHiddenList"
                                                 MinHeight="64"
                                                 MaxHeight="200"
                                                 AutomationProperties.Name="不在 Dock 中显示的应用">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource IceMutedInkBrush}"
                                                                   Text="{Binding Detail}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DockHiddenEmptyText"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="没有隐藏的应用。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DockStatusText"
                                       Margin="18,0,18,12"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="TopBarSection"
                              Margin="0,12,0,4"
                              IsExpanded="True"
                              Style="{StaticResource SettingsFoldStyle}"
                              AutomationProperties.Name="顶端信息条">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FoldTitleStyle}" Text="顶端信息条"/>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="所选显示器顶边的满宽信息条：时间、待办、天气、性能和系统状态，点击模块进入对应设置"/>
                                </StackPanel>
                                <CheckBox x:Name="TopBarEnabledCheckBox"
                                          Grid.Column="1"
                                          Margin="16,0,0,0"
                                          AutomationProperties.Name="显示顶端信息条"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="TopBarSetting_Changed"
                                          Unchecked="TopBarSetting_Changed"/>
                            </Grid>
                        </Expander.Header>
                        <StackPanel x:Name="TopBarPage">
                            <StackPanel x:Name="TopBarOptionsPanel">
                                <local:SettingsRow Header="显示器" local:SettingsSearch.Keywords="屏幕 多显示器">
                                    <ComboBox x:Name="TopBarMonitorComboBox"
                                              Width="280"
                                              AutomationProperties.Name="顶端信息条所在显示器"
                                              SelectionChanged="TopBarSetting_Changed"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="显示方式"
                                                   Description="始终显示时最大化的窗口从信息条下方开始，全屏应用运行时信息条退到后面，顶边被系统任务栏占用（Windows 10）时自动改为智能隐藏；智能隐藏时窗口占用顶部就隐藏，鼠标移到屏幕顶边时显示"
                                                   local:SettingsSearch.Keywords="自动隐藏 预留顶部">
                                    <Border Style="{StaticResource SegmentHostStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="TopBarReserveRadio"
                                                         GroupName="TopBarVisibility"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Content="始终显示，预留顶部空间"
                                                         AutomationProperties.Name="始终显示，并预留屏幕顶部空间"
                                                         Checked="TopBarSetting_Changed"/>
                                            <RadioButton x:Name="TopBarSmartHideRadio"
                                                         GroupName="TopBarVisibility"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Content="智能隐藏"
                                                         AutomationProperties.Name="智能隐藏"
                                                         Checked="TopBarSetting_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </local:SettingsRow>
                                <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="高度">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="TopBarHeightSlider"
                                                Width="200"
                                                Minimum="24"
                                                Maximum="48"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="1"
                                                SmallChange="1"
                                                LargeChange="4"
                                                AutomationProperties.Name="顶端信息条高度"
                                                ValueChanged="TopBarHeight_Changed"/>
                                        <TextBlock x:Name="TopBarHeightText" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </local:SettingsRow>
                                <local:SettingsRow Header="模块" Description="勾选要在信息条上显示的内容"/>
                                <Border Padding="20,4,8,8" Background="{DynamicResource SettingsSurfaceHoverBrush}">
                                    <UniformGrid x:Name="TopBarModulesPanel" Columns="5" SizeChanged="TopBarModules_SizeChanged">
                                        <CheckBox x:Name="TopBarClockCheckBox" Content="时钟与日期" Margin="0,8,12,8"
                                                  AutomationProperties.Name="时钟与日期模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarTodoSummaryCheckBox" Content="待办概要" Margin="0,8,12,8"
                                                  AutomationProperties.Name="待办概要模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarWeatherCheckBox" Content="天气" Margin="0,8,12,8"
                                                  AutomationProperties.Name="天气模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarPerformanceCheckBox" Content="性能" Margin="0,8,12,8"
                                                  AutomationProperties.Name="性能模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarAttentionCheckBox" Content="消息提示" Margin="0,8,12,8"
                                                  AutomationProperties.Name="消息提示模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarInputMethodCheckBox" Content="输入法" Margin="0,8,12,8"
                                                  AutomationProperties.Name="输入法模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarVolumeCheckBox" Content="音量" Margin="0,8,12,8"
                                                  AutomationProperties.Name="音量模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarNetworkCheckBox" Content="网络" Margin="0,8,12,8"
                                                  AutomationProperties.Name="网络模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarBatteryCheckBox" Content="电量" Margin="0,8,12,8"
                                                  AutomationProperties.Name="电量模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarSearchCheckBox" Content="搜索" Margin="0,8,12,8"
                                                  AutomationProperties.Name="搜索模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        <CheckBox x:Name="TopBarTrayOverflowCheckBox" Content="系统托盘" Margin="0,8,12,8"
                                                  AutomationProperties.Name="系统托盘模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                    </UniformGrid>
                                </Border>
                                <local:SettingsRow Header="文件搜索来源"
                                                   Description="默认使用 Windows 已有文件索引；可选使用已安装并运行的完整版 Everything。不可用时自动回退，不修改索引范围，不搜索文件正文"
                                                   local:SettingsSearch.Keywords="Everything 文件索引">
                                    <CheckBox x:Name="TopBarEverythingCheckBox" Content="使用 Everything"
                                              AutomationProperties.Name="使用 Everything 搜索文件"
                                              Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="搜索入口"
                                                   Description="独立搜索框可从左侧手柄拖动、右侧手柄调宽；图标模式点击后展开搜索框">
                                    <ComboBox x:Name="SearchPresentationComboBox" MinWidth="160"
                                              AutomationProperties.Name="搜索入口显示方式" SelectionChanged="SearchPresentation_Changed">
                                        <ComboBoxItem Content="顶栏居中"/>
                                        <ComboBoxItem Content="独立搜索框"/>
                                        <ComboBoxItem Content="顶栏图标"/>
                                    </ComboBox>
                                </local:SettingsRow>
                                <local:SettingsRow Header="搜索热键"
                                                   Description="聚焦或收起顶栏搜索的全局组合键，需至少一个修饰键（Ctrl/Alt/Shift/Win）；关闭搜索模块后热键同时注销"
                                                   local:SettingsSearch.Keywords="快捷键 组合键">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TopBarSearchHotkeyHint"
                                                   MaxWidth="180"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   Foreground="{DynamicResource IceMutedInkBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                        <Button x:Name="TopBarSearchHotkeyButton"
                                                MinWidth="150"
                                                Padding="14,5"
                                                FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                AutomationProperties.Name="搜索热键录制"
                                                Click="TopBarSearchHotkey_Click"
                                                PreviewKeyDown="TopBarSearchHotkey_PreviewKeyDown"
                                                LostKeyboardFocus="TopBarSearchHotkey_LostKeyboardFocus"/>
                                    </StackPanel>
                                </local:SettingsRow>
                                <StackPanel x:Name="SearchAppearancePanel">
                                    <local:SettingsRow Header="独立搜索框配色"
                                                       Description="用于独立搜索框、图标展开后的搜索框及结果列表">
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox x:Name="SearchLookComboBox" MinWidth="150" AutomationProperties.Name="搜索框配色" SelectionChanged="SearchLook_Changed">
                                                <ComboBoxItem Content="深色"/><ComboBoxItem Content="浅色"/>
                                                <ComboBoxItem Content="跟随卡片"/><ComboBoxItem Content="自定义"/>
                                            </ComboBox>
                                            <Button Content="恢复默认" Margin="8,0,0,0" Click="SearchLook_Reset"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                    <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="搜索框底色" Description="文字颜色根据底色自动调整">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="SearchColorPreview" Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Button Content="选择颜色…" AutomationProperties.Name="选择搜索框底色" Click="SearchLook_Color"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                    <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="搜索框不透明度">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="SearchOpacitySlider" Width="200" VerticalAlignment="Center" Minimum="0.05" Maximum="1" SmallChange="0.05" AutomationProperties.Name="搜索框不透明度" ValueChanged="SearchLook_ValueChanged"/>
                                            <TextBlock x:Name="SearchOpacityText" Style="{StaticResource ValueTextStyle}"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                    <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="搜索框圆角">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="SearchCornerSlider" Width="200" VerticalAlignment="Center" Minimum="0" Maximum="24" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="搜索框圆角" ValueChanged="SearchLook_ValueChanged"/>
                                            <TextBlock x:Name="SearchCornerText" Style="{StaticResource ValueTextStyle}"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                </StackPanel>
                            </StackPanel>
                            <local:SettingsRow x:Name="TopBarLookSummaryRow" Header="外观" local:SettingsSearch.Keywords="信息条 颜色 磨砂">
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Content="在外观样式页调整 →"
                                        Tag="TopBar"
                                        AutomationProperties.Name="在外观样式页调整顶端信息条外观"
                                        Click="BarsLookJump_Click"/>
                            </local:SettingsRow>
                            <TextBlock x:Name="TopBarStatusText"
                                       Margin="18,0,18,12"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="TaskbarSection"
                              Margin="0,12,0,4"
                              IsExpanded="True"
                              Style="{StaticResource SettingsFoldStyle}"
                              AutomationProperties.Name="Windows 任务栏">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FoldTitleStyle}" Text="Windows 任务栏"/>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="只改外观和显示方式，退出冰蓝桌面时恢复系统默认"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel x:Name="TaskbarPage">
                            <Border Padding="18,14,18,12">
                                <StackPanel>
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="TaskbarDefaultRadio"
                                                     Margin="0,0,6,0"
                                                     GroupName="TaskbarMode"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="SystemDefault"
                                                     AutomationProperties.Name="保持系统默认"
                                                     Checked="TaskbarMode_Checked"
                                                     local:SettingsSearch.Keywords="任务栏样式 默认">
                                            <StackPanel Margin="2,0,24,0">
                                                <TextBlock FontWeight="Medium" Text="系统默认"/>
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="不做任何调整"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TaskbarTransparentRadio"
                                                     Margin="3,0"
                                                     GroupName="TaskbarMode"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="Transparent"
                                                     AutomationProperties.Name="透明"
                                                     Checked="TaskbarMode_Checked"
                                                     local:SettingsSearch.Keywords="任务栏样式 透明任务栏">
                                            <StackPanel Margin="2,0,24,0">
                                                <TextBlock FontWeight="Medium" Text="透明"/>
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="露出后方背景；Windows 透明效果关闭时自动开启，退出还原"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TaskbarBlurRadio"
                                                     Margin="3,0"
                                                     GroupName="TaskbarMode"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="Blur"
                                                     AutomationProperties.Name="模糊"
                                                     Checked="TaskbarMode_Checked"
                                                     local:SettingsSearch.Keywords="任务栏样式 毛玻璃">
                                            <StackPanel Margin="2,0,24,0">
                                                <TextBlock FontWeight="Medium" Text="模糊"/>
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="系统模糊材质，效果随 Windows 版本变化"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TaskbarSmartHideRadio"
                                                     Margin="6,0,0,0"
                                                     GroupName="TaskbarMode"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="SmartHide"
                                                     AutomationProperties.Name="自动隐藏"
                                                     Checked="TaskbarMode_Checked"
                                                     local:SettingsSearch.Keywords="任务栏样式 隐藏任务栏">
                                            <StackPanel Margin="2,0,24,0">
                                                <TextBlock FontWeight="Medium" Text="自动隐藏"/>
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="由冰蓝桌面接管；切走或退出时恢复到进入前的状态"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock x:Name="TaskbarStatusText"
                                               Margin="2,10,0,0"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource CaptionStyle}"/>
                                    <!-- Windows 自动隐藏开着、而不是冰蓝桌面设置的：说明来源并给出出路。 -->
                                    <StackPanel x:Name="WindowsAutoHidePanel" Margin="2,10,0,0" Visibility="Collapsed">
                                        <TextBlock TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="Windows 当前开启了“自动隐藏任务栏”，这不是冰蓝桌面设置的，所以选“系统默认”不会改动它。"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="改为始终显示" Click="ShowTaskbarAlways_Click"/>
                                            <Button Margin="8,0,0,0" Content="打开 Windows 任务栏设置" Click="OpenWindowsTaskbarSettings_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 只在选“自动隐藏”时显示：两项都只影响任务栏弹出。 -->
                            <StackPanel x:Name="TaskbarPopupPanel" Visibility="Collapsed">
                                <local:SettingsRow Header="鼠标仅从底部两角唤出"
                                                   Description="任务栏自动隐藏时，鼠标碰到底边中间不弹出，移到底边左右两端才弹出；打开开始菜单等系统面板时，Windows 仍可能显示任务栏。全屏时暂停"
                                                   local:SettingsSearch.Keywords="弹出方式">
                                    <CheckBox x:Name="RevealOnlyAtCornersCheckBox"
                                              AutomationProperties.Name="鼠标仅从底部两角唤出任务栏"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Click="RevealOnlyAtCorners_Click"/>
                                </local:SettingsRow>
                                <local:SettingsRow Header="有新消息时不弹出任务栏"
                                                   Description="关闭 Windows 的任务栏应用闪烁，新消息只在 Dock 图标上显示橙色标记"
                                                   local:SettingsSearch.Keywords="弹出方式 闪烁">
                                    <CheckBox x:Name="QuietTaskbarFlashCheckBox"
                                              AutomationProperties.Name="有新消息时不弹出 Windows 任务栏"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Click="QuietTaskbarFlash_Click"/>
                                </local:SettingsRow>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- 通用设置 -->
            <ScrollViewer x:Name="GeneralPage" Style="{StaticResource PageScrollStyle}" Visibility="Collapsed">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="通用设置"/>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="启动与更新"/>
                    <local:SettingsGroup>
                        <local:SettingsRow Header="登录 Windows 时启动冰蓝桌面" local:SettingsSearch.Keywords="开机启动 自启 开机">
                            <CheckBox x:Name="StartupCheckBox"
                                      AutomationProperties.Name="登录 Windows 时启动冰蓝桌面"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="StartupCheckBox_Changed"
                                      Unchecked="StartupCheckBox_Changed"/>
                        </local:SettingsRow>
                        <local:SettingsRow Header="检查更新" local:SettingsSearch.Keywords="更新 版本 升级">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel MaxWidth="320" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppVersionText" HorizontalAlignment="Right" FontSize="13"/>
                                    <TextBlock x:Name="UpdateStatusText"
                                               Margin="0,2,0,0"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               AutomationProperties.LiveSetting="Polite">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button x:Name="CheckUpdatesButton"
                                        VerticalAlignment="Center"
                                        Content="检查更新"
                                        Click="CheckUpdates_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Header="每天自动检查更新"
                                           Description="只向 GitHub 查询最新版本号；发现新版本时提示">
                            <CheckBox x:Name="AutoCheckUpdatesCheckBox"
                                      AutomationProperties.Name="每天自动检查更新"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="AutoCheckUpdates_Changed"
                                      Unchecked="AutoCheckUpdates_Changed"/>
                        </local:SettingsRow>
                        <local:SettingsRow Header="作者 keros68"
                                           Description="github.com/keros68/binglan，欢迎提交 PR">
                            <Button Content="打开仓库"
                                    AutomationProperties.Name="打开项目仓库页面"
                                    Click="OpenRepository_Click"/>
                        </local:SettingsRow>
                    </local:SettingsGroup>
                    <TextBlock x:Name="StartupNoteText"
                               Margin="6,4,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Visibility="Collapsed"/>
                    <Border x:Name="UpdateAvailableCard"
                            Margin="0,8,0,4"
                            Style="{StaticResource SettingsPanelStyle}"
                            BorderBrush="{DynamicResource IceActionBrush}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="UpdateAvailableTitle" FontSize="16" FontWeight="SemiBold"/>
                            <TextBox x:Name="UpdateNotesText"
                                     Margin="0,10,0,0"
                                     MaxHeight="260"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="更新内容"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="InstallUpdateButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="下载并安装"
                                        Click="InstallUpdate_Click"/>
                                <Button Margin="8,0,0,0" Content="查看发布页" Click="OpenReleasePage_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="InstallUpdateNoteText"
                                       Margin="0,10,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="安装时冰蓝桌面会暂时退出，装完自动重新打开。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="备份" local:SettingsSearch.Keywords="恢复 还原 备份全部"/>
                    <Border Style="{StaticResource SettingsPanelStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="备份包含全部桌面组件、个人内容和设置，保存在数据目录的 Backups 文件夹。恢复后冰蓝桌面会重新启动。"/>
                            <ListBox x:Name="BackupList"
                                     MinHeight="96"
                                     MaxHeight="150"
                                     AutomationProperties.Name="已有备份"
                                     DisplayMemberPath="Label"/>
                            <TextBlock x:Name="BackupEmptyText"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="还没有备份。"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource AccentButtonStyle}" Content="立即备份" Click="CreateBackup_Click"/>
                                <Button Margin="8,0,0,0" Content="从备份恢复…" Click="RestoreBackup_Click"/>
                                <Button Margin="8,0,0,0" Content="删除备份" Click="DeleteBackup_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="BackupStatusText"
                                       Margin="0,10,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="隐私与数据" local:SettingsSearch.Keywords="数据目录 联网 定位"/>
                    <Border Style="{StaticResource SettingsPanelStyle}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontWeight="Medium" Text="待办、便签、文件映射、Dock 固定应用和各项设置只保存在本机："/>
                            <TextBlock x:Name="DataDirectoryText"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="· 只有搜索天气城市和刷新天气时联网，发送搜索关键词或所选城市坐标；不使用 IP、GPS 或 Wi-Fi 定位。"/>
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="· 检查更新时只向 GitHub 查询最新版本号。"/>
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="· 不收集使用数据，不上传待办、文件路径、应用列表或窗口标题。"/>
                            <Button Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Content="打开数据目录"
                                    Click="OpenDataDirectory_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="退出"/>
                    <local:SettingsGroup>
                        <local:SettingsRow Header="退出冰蓝桌面"
                                           Description="关闭所有卡片和 Dock，并把任务栏与桌面图标恢复为系统默认">
                            <Button x:Name="ExitAppButton" Content="退出" AutomationProperties.Name="退出冰蓝桌面" Click="ExitApp_Click"/>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="UninstallRow"
                                           Header="卸载冰蓝桌面"
                                           Description="冰蓝桌面会先退出，再打开卸载程序；卸载时可选择保留个人数据"
                                           local:SettingsSearch.Keywords="删除 移除">
                            <Button x:Name="UninstallButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="卸载…"
                                    AutomationProperties.Name="卸载冰蓝桌面"
                                    Click="Uninstall_Click"/>
                        </local:SettingsRow>
                    </local:SettingsGroup>
                    <TextBlock x:Name="UninstallStatusText"
                               Margin="6,4,0,0"
                               Style="{StaticResource CaptionStyle}"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
