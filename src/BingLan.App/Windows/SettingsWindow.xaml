                                                <TextBlock Width="92" VerticalAlignment="Center" Text="其他扩展名"/>
                                                <TextBox x:Name="FileBoxExtraExtensionsEditor"
                                                         Width="320"
                                                         AutomationProperties.Name="其他扩展名"
                                                         ToolTip="用空格或逗号分隔，例如：psd ai dwg"
                                                         LostFocus="FileBoxCollect_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="FileBoxDesktopHintPanel"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="FileBox"
                                            local:SettingsSearch.Title="分组盒">
