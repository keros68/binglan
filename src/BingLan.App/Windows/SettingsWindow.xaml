                                            <ComboBox x:Name="TodoWeekCountPicker"
                                                      Width="160"
                                                      AutomationProperties.Name="周历显示周数"
                                                      SelectionChanged="TodoWeekCount_SelectionChanged">
                                                <ComboBoxItem Content="1 周"/>
                                                <ComboBoxItem Content="2 周"/>
                                                <ComboBoxItem Content="3 周"/>
                                                <ComboBoxItem Content="4 周"/>
                                                <ComboBoxItem Content="5 周"/>
                                            </ComboBox>
                                        </local:SettingsRow>
                                    </local:SettingsGroup>
                                </StackPanel>

                                <Expander x:Name="ComponentOwnLookFold"
                                          Margin="0,24,0,4"
                                          Style="{StaticResource SettingsFoldStyle}"
                                          AutomationProperties.Name="独立外观">
                                    <Expander.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FoldTitleStyle}" Text="独立外观"/>
