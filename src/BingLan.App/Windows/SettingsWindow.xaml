                                                    <Border x:Name="SelectedComponentHeaderChip"
                                                            Width="30"
                                                            Height="30"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="6"
                                                            BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                                                            BorderThickness="1"/>
