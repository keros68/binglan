                                    <StackPanel x:Name="DockAdvancedBehaviorPanel">
                                        <local:SettingsRow Header="显示 Windows 开始菜单入口"
                                                           Description="点击打开 Windows 开始菜单"
                                                           local:SettingsSearch.Keywords="开始菜单">
                                            <CheckBox x:Name="DockStartMenuButtonCheckBox"
                                                      AutomationProperties.Name="显示 Windows 开始菜单入口"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DockSetting_Changed"
                                                      Unchecked="DockSetting_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="显示冰蓝总览卡入口"
                                                           Description="快速找应用、翻常用文件夹的全局面板；启用时关闭此项仍可从冰蓝托盘打开"
                                                           local:SettingsSearch.Keywords="冰蓝总览卡 总览卡 启动台 启动面板 Launcher 应用启动">
                                            <CheckBox x:Name="DockLauncherButtonCheckBox"
                                                      AutomationProperties.Name="显示冰蓝总览卡入口"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DockSetting_Changed"
                                                      Unchecked="DockSetting_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="显示“显示桌面”按钮"
                                                           Description="点击收起窗口并显示桌面，再点一次恢复窗口"
                                                           local:SettingsSearch.Keywords="显示桌面 回到桌面 Win+D">
                                            <CheckBox x:Name="DockShowDesktopButtonCheckBox"
                                                      AutomationProperties.Name="显示“显示桌面”按钮"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DockSetting_Changed"
                                                      Unchecked="DockSetting_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="自动缩小图标" Description="应用较多放不下时自动缩小图标（最小 28），都放不下时可在 Dock 上滚动查看">
                                            <CheckBox x:Name="DockAutoIconSizeCheckBox"
                                                      IsChecked="True"
                                                      AutomationProperties.Name="Dock 自动缩小图标"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DockAutoIconSize_Changed"
                                                      Unchecked="DockAutoIconSize_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="DockHoverMagnificationScaleRow"
                                                           Header="放大强度"
                                                           Description="图标最大放大倍数（1.2–1.7 倍，默认 1.5 倍）"
                                                           local:SettingsSearch.Keywords="Dock 放大强度 倍数">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="DockHoverMagnificationScaleSlider"
                                                        Width="200"
                                                        Minimum="1.2"
                                                        Maximum="1.7"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        AutomationProperties.Name="Dock 悬停放大强度"
                                                        ValueChanged="DockHoverMagnificationScale_Changed"/>
                                                <TextBlock x:Name="DockHoverMagnificationScaleText" Style="{StaticResource ValueTextStyle}"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="DockGapRow" Header="距底部高度" Description="Dock 底边到屏幕底边的距离；任务栏常显时从任务栏上沿算起">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="DockBottomGapSlider"
                                                        Width="200"
                                                        Minimum="0"
                                                        Maximum="64"
                                                        TickFrequency="4"
                                                        IsSnapToTickEnabled="True"
                                                        AutomationProperties.Name="Dock 距底部高度"
                                                        ValueChanged="DockBottomGap_Changed"/>
                                                <TextBlock x:Name="DockBottomGapText" Style="{StaticResource ValueTextStyle}"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="动效" Description="图标放大和弹出的动画" local:SettingsSearch.Keywords="动画">
                                            <ComboBox x:Name="MotionSelector"
                                                      Width="160"
                                                      AutomationProperties.Name="Dock 动效"
                                                      SelectionChanged="StyleSelector_SelectionChanged">
                                                <ComboBoxItem Content="标准" Tag="Standard"/>
                                                <ComboBoxItem Content="减弱" Tag="Reduced"/>
                                                <ComboBoxItem Content="关闭" Tag="Off"/>
                                            </ComboBox>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="DockMaximizeReleaseRow"
                                                           Header="最大化窗口时临时隐藏并释放底部空间"
                                                           Description="开启后，最大化窗口时 Dock 会临时隐藏并释放底部空间，鼠标移到屏幕底边或把手可临时唤出；希望最大化时也始终显示 Dock 请关闭此项"
                                                           local:SettingsSearch.Keywords="让出底部空间 释放底部空间 临时隐藏">
                                            <CheckBox x:Name="DockMaximizeReleaseCheckBox"
                                                      AutomationProperties.Name="最大化窗口时临时隐藏并释放底部空间"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DockSetting_Changed"
                                                      Unchecked="DockSetting_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="DockAutoHideAlwaysRow"
                                                           Header="始终自动隐藏"
                                                           Description="仅智能隐藏下有效。开启后 Dock 平时一直收起，只有鼠标碰到屏幕边缘或把手时才出现；关闭时只在被窗口挡住时收起"
                                                           local:SettingsSearch.Keywords="自动隐藏 一直隐藏 总是弹出 自己弹出">
                                            <CheckBox x:Name="DockAutoHideAlwaysCheckBox"
                                                      AutomationProperties.Name="Dock 始终自动隐藏"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DockSetting_Changed"
                                                      Unchecked="DockSetting_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="DockBounceOnAttentionRow"
                                                           Header="有新消息时图标弹跳"
                                                           Description="应用闪烁提醒时（如聊天软件来消息），它在 Dock 上的图标弹跳几下；Dock 已收起时，把手会闪动。遵循“动画”档位与系统动画开关，同一应用 8 秒内至多弹跳一次"
                                                           local:SettingsSearch.Keywords="弹跳 跳动 新消息 通知 提醒 闪烁">
                                            <CheckBox x:Name="DockBounceOnAttentionCheckBox"
                                                      AutomationProperties.Name="有新消息时图标弹跳"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DockSetting_Changed"
                                                      Unchecked="DockSetting_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="DockRevealOnAttentionRow"
                                                           Header="有新消息时临时弹出 Dock"
                                                           Description="仅智能隐藏下有效。开启后，应用闪烁提醒时（如聊天软件来消息）已收起的 Dock 会弹出几秒；关闭时标记只显示在图标上，下次出现 Dock 时可见"
                                                           local:SettingsSearch.Keywords="新消息 闪烁 弹出 提醒 微信">
                                            <CheckBox x:Name="DockRevealOnAttentionCheckBox"
                                                      AutomationProperties.Name="有新消息时临时弹出 Dock"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DockSetting_Changed"
                                                      Unchecked="DockSetting_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="唤出方式"
                                                           Description="Dock 隐藏后如何重新显示。原生任务栏一直显示时，鼠标停在任务栏上不会唤出 Dock：默认用把手唤出；选“只用屏幕底边”则不显示把手，把鼠标推到屏幕最底边唤出">
                                            <ComboBox x:Name="DockRevealModeComboBox"
                                                      Width="220"
                                                      AutomationProperties.Name="Dock 唤出方式"
                                                      SelectionChanged="DockSetting_Changed">
                                                <ComboBoxItem Content="屏幕底边和把手" Tag="EdgeAndHandle"/>
                                                <ComboBoxItem Content="只用把手" Tag="HandleOnly"/>
                                                <ComboBoxItem Content="只用屏幕底边（不显示把手）" Tag="EdgeOnly"/>
                                            </ComboBox>
                                        </local:SettingsRow>
                                    </StackPanel>
                                    <local:SettingsRow Header="不在 Dock 中显示的应用"
                                                       Description="在 Dock 中右键正在运行的应用，选择“不在 Dock 中显示此应用”。适合悬浮条、小工具这类不在任务栏显示的窗口"
                                                       local:SettingsSearch.Keywords="隐藏应用">
                                        <Button Content="恢复显示" Click="UnhideDockApp_Click"/>
                                    </local:SettingsRow>
                                    <Border Style="{StaticResource SettingsBlockStyle}" Background="{DynamicResource SettingsSurfaceHoverBrush}" Padding="34,10,18,12">
                                        <StackPanel>
                                            <ListBox x:Name="DockHiddenList"
                                                     MinHeight="64"
                                                     MaxHeight="200"
                                                     AutomationProperties.Name="不在 Dock 中显示的应用">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"/>
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                                                       Text="{Binding Detail}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="DockHiddenEmptyText"
                                                       Margin="0,8,0,0"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="没有隐藏的应用。"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="DockStatusText"
                                       Margin="6,6,6,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 顶部信息条 -->
            <ScrollViewer x:Name="TopBarPage"
                          Style="{StaticResource PageScrollStyle}"
                          Visibility="Collapsed"
                          local:SettingsSearch.Keywords="顶栏与底栏 顶栏底栏 顶端信息条">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="顶部信息条"/>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="屏幕最上方的状态栏：显示哪些模块、常驻还是智能隐藏、多高。"/>
                        </StackPanel>
                        <Button x:Name="TopBarRestoreModeButton"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Click="RestoreDesktopMode_Click"/>
                    </Grid>
                    <StackPanel x:Name="TopBarSection" Margin="0,12,0,0">
                        <local:SettingsGroup>
                                <local:SettingsRow Header="显示顶部信息条"
                                                   Description="屏幕最上方的状态栏（时间、天气、网速、音量等），点击模块进入对应设置"
                                                   local:SettingsSearch.Keywords="顶栏与底栏 顶栏底栏 顶端信息条 顶部信息条 顶栏 信息条 状态栏 菜单栏 开关">
                                    <CheckBox x:Name="TopBarEnabledCheckBox"
                                              AutomationProperties.Name="显示顶部信息条"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="TopBarSetting_Changed"
                                              Unchecked="TopBarSetting_Changed"/>
                                </local:SettingsRow>
                                <StackPanel x:Name="TopBarOptionsPanel">
                                    <local:SettingsRow Header="显示器" local:SettingsSearch.Keywords="屏幕 多显示器">
                                        <ComboBox x:Name="TopBarMonitorComboBox"
                                                  Width="280"
                                                  AutomationProperties.Name="顶部信息条所在显示器"
                                                  SelectionChanged="TopBarSetting_Changed"/>
                                    </local:SettingsRow>
                                    <local:SettingsRow Header="显示方式"
                                                       Description="始终显示时预留顶部空间，全屏应用优先显示。顶边被 Windows 任务栏占用时改为智能隐藏，并让开任务栏的唤出区域"
                                                       local:SettingsSearch.Keywords="自动隐藏 预留顶部">
                                        <Border Style="{StaticResource SegmentHostStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="TopBarReserveRadio"
                                                             GroupName="TopBarVisibility"
                                                             Style="{StaticResource SegmentRadioStyle}"
                                                             Content="始终显示，预留顶部空间"
                                                             AutomationProperties.Name="始终显示，并预留屏幕顶部空间"
                                                             Checked="TopBarSetting_Changed"/>
                                                <RadioButton x:Name="TopBarSmartHideRadio"
                                                             GroupName="TopBarVisibility"
                                                             Style="{StaticResource SegmentRadioStyle}"
                                                             Content="智能隐藏"
                                                             AutomationProperties.Name="智能隐藏"
                                                             Checked="TopBarSetting_Changed"/>
                                            </StackPanel>
                                        </Border>
                                    </local:SettingsRow>
                                    <local:SettingsRow Header="模块"
                                                       Description="勾选要在顶部信息条显示的内容；全局搜索热键可在“冰蓝总览卡”页设置"/>
                                    <Border Padding="20,4,8,8" Background="{DynamicResource SettingsSurfaceHoverBrush}">
                                        <UniformGrid x:Name="TopBarModulesPanel" Columns="5" SizeChanged="TopBarModules_SizeChanged">
                                            <CheckBox x:Name="TopBarClockCheckBox" Content="时钟与日期" Margin="0,8,12,8"
                                                      AutomationProperties.Name="时钟与日期模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarTodoSummaryCheckBox" Content="待办概要" Margin="0,8,12,8"
                                                      AutomationProperties.Name="待办概要模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarWeatherCheckBox" Content="天气" Margin="0,8,12,8"
                                                      AutomationProperties.Name="天气模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarPerformanceCheckBox" Content="性能" Margin="0,8,12,8"
                                                      AutomationProperties.Name="性能模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarAttentionCheckBox" Content="消息提示" Margin="0,8,12,8"
                                                      AutomationProperties.Name="消息提示模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarInputMethodCheckBox" Content="输入法" Margin="0,8,12,8"
                                                      AutomationProperties.Name="输入法模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarVolumeCheckBox" Content="音量" Margin="0,8,12,8"
                                                      AutomationProperties.Name="音量模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarNetworkCheckBox" Content="网络" Margin="0,8,12,8"
                                                      AutomationProperties.Name="网络模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarBatteryCheckBox" Content="电量" Margin="0,8,12,8"
                                                      AutomationProperties.Name="电量模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarSearchCheckBox" Content="搜索" Margin="0,8,12,8"
                                                      AutomationProperties.Name="搜索模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                            <CheckBox x:Name="TopBarTrayOverflowCheckBox" Content="系统托盘" Margin="0,8,12,8"
                                                      AutomationProperties.Name="系统托盘模块" Checked="TopBarSetting_Changed" Unchecked="TopBarSetting_Changed"/>
                                        </UniformGrid>
                                    </Border>
                                    <local:SettingsRow x:Name="TopBarShowWifiNameRow"
                                                       Header="在顶栏显示 Wi-Fi 名称"
                                                       Description="关闭时只显示信号格和“WLAN”，悬停仍可查看名称和信号强度；录屏或直播时建议关闭"
                                                       local:SettingsSearch.Keywords="Wi-Fi SSID 网络名称 隐私 录屏">
                                        <CheckBox x:Name="TopBarShowWifiNameCheckBox"
                                                  AutomationProperties.Name="在顶栏显示 Wi-Fi 名称"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="TopBarSetting_Changed"
                                                  Unchecked="TopBarSetting_Changed"/>
                                    </local:SettingsRow>
                                </StackPanel>
                            </local:SettingsGroup>

                            <local:SettingsGroup Margin="0,14,0,4" local:SettingsSearch.Exclude="True">
                                <local:SettingsRow x:Name="TopBarLookSummaryRow" Header="外观：跟随全局">
                                    <Button x:Name="TopBarLookJumpButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="去调整 ›"
                                            Tag="TopBar"
                                            AutomationProperties.Name="去外观样式页调整顶部信息条外观"
                                            Click="AppearanceSummaryJump_Click"/>
                                </local:SettingsRow>
                            </local:SettingsGroup>

                            <Expander x:Name="TopBarAdvancedFold"
                                      Margin="0,12,0,4"
                                      IsExpanded="False"
                                      Style="{StaticResource SettingsFoldStyle}"
                                      AutomationProperties.Name="高度">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FoldTitleStyle}" Text="高度"/>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="顶部信息条高度（24–48 DIP）"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <StackPanel x:Name="TopBarAdvancedBehaviorPanel">
                                        <local:SettingsRow Header="高度" local:SettingsSearch.Keywords="顶端信息条高度 顶部信息条高度 顶栏高度 顶端信息条">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="TopBarHeightSlider"
                                                        Width="200"
                                                        Minimum="24"
                                                        Maximum="48"
                                                        IsSnapToTickEnabled="True"
                                                        TickFrequency="1"
                                                        SmallChange="1"
                                                        LargeChange="4"
                                                        AutomationProperties.Name="顶部信息条高度"
                                                        ValueChanged="TopBarHeight_Changed"/>
                                                <TextBlock x:Name="TopBarHeightText" Style="{StaticResource ValueTextStyle}"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="TopBarStatusText"
                                       Margin="6,6,6,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Windows 任务栏 -->
            <ScrollViewer x:Name="TaskbarPage"
                          Style="{StaticResource PageScrollStyle}"
                          Visibility="Collapsed"
                          local:SettingsSearch.Keywords="顶栏与底栏 顶栏底栏">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Windows 任务栏"/>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="系统任务栏的外观和隐藏方式：保持默认、透明、模糊或自动隐藏。"/>
                        </StackPanel>
                        <Button x:Name="TaskbarRestoreModeButton"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Click="RestoreDesktopMode_Click"/>
                    </Grid>
                    <StackPanel x:Name="TaskbarSection" Margin="0,12,0,0">
                        <local:SettingsGroup>
                                <Border Padding="18,14,18,12">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,10" Style="{StaticResource CaptionStyle}"
                                                   Text="只改外观和显示方式，退出冰蓝桌面时自动恢复系统默认。"/>
                                        <UniformGrid Columns="4">
                                            <RadioButton x:Name="TaskbarDefaultRadio"
                                                         Margin="0,0,6,0"
                                                         GroupName="TaskbarMode"
                                                         Style="{StaticResource ChoiceCardStyle}"
                                                         Tag="SystemDefault"
                                                         AutomationProperties.Name="保持系统默认"
                                                         Checked="TaskbarMode_Checked"
                                                         local:SettingsSearch.Keywords="顶栏与底栏 顶栏底栏 任务栏样式 默认">
                                                <StackPanel Margin="2,0,24,0">
                                                    <TextBlock FontWeight="Medium" Text="系统默认"/>
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="不做任何调整"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="TaskbarTransparentRadio"
                                                         Margin="3,0"
                                                         GroupName="TaskbarMode"
                                                         Style="{StaticResource ChoiceCardStyle}"
                                                         Tag="Transparent"
                                                         AutomationProperties.Name="透明"
                                                         Checked="TaskbarMode_Checked"
                                                         local:SettingsSearch.Keywords="任务栏样式 透明任务栏">
                                                <StackPanel Margin="2,0,24,0">
                                                    <TextBlock FontWeight="Medium" Text="透明"/>
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="露出后方背景；Windows 透明效果关闭时自动开启，退出还原"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="TaskbarBlurRadio"
                                                         Margin="3,0"
                                                         GroupName="TaskbarMode"
                                                         Style="{StaticResource ChoiceCardStyle}"
                                                         Tag="Blur"
                                                         AutomationProperties.Name="模糊"
                                                         Checked="TaskbarMode_Checked"
                                                         local:SettingsSearch.Keywords="任务栏样式 毛玻璃">
                                                <StackPanel Margin="2,0,24,0">
                                                    <TextBlock FontWeight="Medium" Text="模糊"/>
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="系统模糊材质，效果随 Windows 版本变化"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="TaskbarSmartHideRadio"
                                                         Margin="6,0,0,0"
                                                         GroupName="TaskbarMode"
                                                         Style="{StaticResource ChoiceCardStyle}"
                                                         Tag="SmartHide"
                                                         AutomationProperties.Name="自动隐藏"
                                                         Checked="TaskbarMode_Checked"
                                                         local:SettingsSearch.Keywords="任务栏样式 隐藏任务栏">
                                                <StackPanel Margin="2,0,24,0">
                                                    <TextBlock FontWeight="Medium" Text="自动隐藏"/>
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="由冰蓝桌面接管；切走或退出时恢复到进入前的状态"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>
                                        <TextBlock x:Name="TaskbarStatusText"
                                                   Margin="2,10,0,0"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="TaskbarPositionText" Margin="2,4,0,0"
                                                   Visibility="Collapsed" Style="{StaticResource CaptionStyle}"/>
                                        <!-- Windows 自动隐藏开着、而不是冰蓝桌面设置的：说明来源并给出出路。 -->
                                        <StackPanel x:Name="WindowsAutoHidePanel" Margin="2,10,0,0" Visibility="Collapsed">
                                            <TextBlock TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="Windows 当前开启了“自动隐藏任务栏”，这不是冰蓝桌面设置的，所以选“系统默认”不会改动它。"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Content="改为始终显示" Click="ShowTaskbarAlways_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Margin="2,10,0,0" HorizontalAlignment="Left"
                                                Content="打开 Windows 任务栏设置" Click="OpenWindowsTaskbarSettings_Click"/>
                                    </StackPanel>
                                </Border>
                                <!-- 只在选“自动隐藏”时显示：两项都只影响任务栏弹出。 -->
                                <StackPanel x:Name="TaskbarPopupPanel" Visibility="Collapsed">
                                    <local:SettingsRow Header="鼠标触边唤出"
                                                       Description="仅对底部自动隐藏的任务栏生效。选“禁止鼠标触边唤出”时，仍可按 Win 键或点击 Dock 开始按钮打开任务栏；全屏游戏、视频等窗口中暂停"
                                                       local:SettingsSearch.Keywords="弹出方式 两角 禁止唤出 彻底隐藏">
                                        <ComboBox x:Name="TaskbarEdgeRevealComboBox"
                                                  Width="200"
                                                  AutomationProperties.Name="任务栏鼠标触边唤出方式"
                                                  SelectionChanged="TaskbarEdgeReveal_SelectionChanged">
                                            <ComboBoxItem Content="底部任意位置（默认）" Tag="AnyEdge"/>
                                            <ComboBoxItem Content="仅底部两角" Tag="CornersOnly"/>
                                            <ComboBoxItem Content="禁止鼠标触边唤出" Tag="Disabled"/>
                                        </ComboBox>
                                    </local:SettingsRow>
                                    <local:SettingsRow Header="有新消息时不弹出任务栏"
                                                       Description="关闭 Windows 的任务栏应用闪烁，新消息只在 Dock 图标上显示橙色标记"
                                                       local:SettingsSearch.Keywords="弹出方式 闪烁">
                                        <CheckBox x:Name="QuietTaskbarFlashCheckBox"
                                                  AutomationProperties.Name="有新消息时不弹出 Windows 任务栏"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="QuietTaskbarFlash_Click"/>
                                    </local:SettingsRow>
                                </StackPanel>
                            </local:SettingsGroup>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 通用设置 -->
            <ScrollViewer x:Name="GeneralPage" Style="{StaticResource PageScrollStyle}" Visibility="Collapsed">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="通用设置"/>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="开机启动、检查更新、全局快捷键、备份与数据管理。"/>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="启动与更新"/>
                    <local:SettingsGroup>
                        <local:SettingsRow Header="登录 Windows 时启动冰蓝桌面" local:SettingsSearch.Keywords="开机启动 自启 开机">
                            <CheckBox x:Name="StartupCheckBox"
                                      AutomationProperties.Name="登录 Windows 时启动冰蓝桌面"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="StartupCheckBox_Changed"
                                      Unchecked="StartupCheckBox_Changed"/>
                        </local:SettingsRow>
                        <local:SettingsRow Header="检查更新" local:SettingsSearch.Keywords="更新 版本 升级">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel MaxWidth="320" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppVersionText" HorizontalAlignment="Right" FontSize="13"/>
                                    <TextBlock x:Name="UpdateStatusText"
                                               Margin="0,2,0,0"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               AutomationProperties.LiveSetting="Polite">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button x:Name="CheckUpdatesButton"
                                        VerticalAlignment="Center"
                                        Content="检查更新"
                                        Click="CheckUpdates_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Header="每天自动检查更新"
                                           Description="只向 GitHub 查询最新版本号；发现新版本时提示">
                            <CheckBox x:Name="AutoCheckUpdatesCheckBox"
                                      AutomationProperties.Name="每天自动检查更新"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="AutoCheckUpdates_Changed"
                                      Unchecked="AutoCheckUpdates_Changed"/>
                        </local:SettingsRow>
                    </local:SettingsGroup>
                    <TextBlock x:Name="StartupNoteText"
                               Margin="6,4,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Visibility="Collapsed"/>
                    <Border x:Name="UpdateAvailableCard"
                            Margin="0,8,0,4"
                            Style="{StaticResource SettingsPanelStyle}"
                            BorderBrush="{DynamicResource IceActionBrush}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="UpdateAvailableTitle" FontSize="16" FontWeight="SemiBold"/>
                            <TextBox x:Name="UpdateNotesText"
                                     Margin="0,10,0,0"
                                     MaxHeight="260"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="更新内容"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="InstallUpdateButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="下载并安装"
                                        Click="InstallUpdate_Click"/>
                                <Button Margin="8,0,0,0" Content="查看发布页" Click="OpenReleasePage_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="InstallUpdateNoteText"
                                       Margin="0,10,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="安装时冰蓝桌面会暂时退出，装完自动重新打开。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="快捷键" local:SettingsSearch.Keywords="热键 组合键 速览 Peek 常用文件夹 隐藏组件 快速待办"/>
                    <local:SettingsGroup x:Name="HotkeysSettingsGroup">
                        <local:SettingsRow Header="打开或收起冰蓝总览卡"
                                           Description="快速找应用、翻常用文件夹的全局面板；在「冰蓝总览卡」页录制或清空呼出快捷键（默认 Ctrl+Alt+F）"
                                           local:SettingsSearch.Keywords="冰蓝总览卡 总览卡 启动台 启动面板 Launcher 快捷键 搜索热键">
                            <Button Content="调整 →"
                                    AutomationProperties.Name="前往冰蓝总览卡设置快捷键"
                                    Click="OpenLauncherHotkeys_Click"/>
                        </local:SettingsRow>
                        <local:SettingsRow Header="打开常用文件夹"
                                           Description="不回桌面直接打开常用文件夹（默认不设）"
                                           local:SettingsSearch.Keywords="常用文件夹 常用位置 总览卡 文件 快捷键">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LauncherFilesHotkeyHint"
                                           MaxWidth="160"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource IceMutedInkBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="LauncherFilesHotkeyButton"
                                        Tag="LauncherFiles"
                                        MinWidth="140"
                                        Padding="14,5"
                                        FontFamily="{StaticResource UiFont}"
                                        AutomationProperties.Name="打开常用文件夹快捷键"
                                        Click="GlobalHotkey_Click"
                                        PreviewKeyDown="GlobalHotkey_PreviewKeyDown"
                                        LostKeyboardFocus="GlobalHotkey_LostKeyboardFocus"/>
                                <Button Tag="LauncherFiles"
                                        Margin="6,0,0,0"
                                        Padding="10,5"
                                        Content="清空"
                                        AutomationProperties.Name="清空常用文件夹快捷键"
                                        Click="GlobalHotkeyClear_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Header="临时浮起文件收纳盒"
                                           Description="不回桌面，按快捷键把桌面的文件盒浮到当前窗口上层拿文件或拖文件，松开、按 Esc 或点击空白处自动退回"
                                           local:SettingsSearch.Keywords="临时速览桌面分组盒 临时速览 速览 Peek 唤出 分组盒 桌面分组盒 文件盒 文件收纳盒 围栏 Fences 拖拽 快捷键">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PeekBoxesHotkeyHint"
                                           MaxWidth="160"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource IceMutedInkBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="PeekBoxesHotkeyButton"
                                        Tag="PeekFileBoxes"
                                        MinWidth="140"
                                        Padding="14,5"
                                        FontFamily="{StaticResource UiFont}"
                                        AutomationProperties.Name="临时浮起文件收纳盒快捷键"
                                        Click="GlobalHotkey_Click"
                                        PreviewKeyDown="GlobalHotkey_PreviewKeyDown"
                                        LostKeyboardFocus="GlobalHotkey_LostKeyboardFocus"/>
                                <Button Tag="PeekFileBoxes"
                                        Margin="6,0,0,0"
                                        Padding="10,5"
                                        Content="清空"
                                        AutomationProperties.Name="清空临时浮起文件收纳盒快捷键"
                                        Click="GlobalHotkeyClear_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                    </local:SettingsGroup>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="退出"/>
                    <local:SettingsGroup>
                        <local:SettingsRow Header="退出冰蓝桌面"
                                           Description="关闭所有卡片和 Dock，并把任务栏与桌面图标恢复为系统默认">
                            <Button x:Name="ExitAppButton" Content="退出" AutomationProperties.Name="退出冰蓝桌面" Click="ExitApp_Click"/>
                        </local:SettingsRow>
                    </local:SettingsGroup>

                    <Expander x:Name="GeneralMoreFold"
                              Margin="0,20,0,4"
                              IsExpanded="False"
                              Style="{StaticResource SettingsFoldStyle}"
                              AutomationProperties.Name="更多选项">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FoldTitleStyle}" Text="更多选项"/>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="更多快捷键、备份与恢复、隐私与数据、关于与卸载"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <local:SettingsRow Header="隐藏或显示全部桌面组件"
                                               Description="一键隐藏或恢复所有桌面卡片，适合录屏、投屏或看壁纸（默认不设）"
                                               local:SettingsSearch.Keywords="隐藏组件 显示组件 清场 快捷键">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ToggleWidgetsHotkeyHint"
                                               MaxWidth="160"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource IceMutedInkBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="ToggleWidgetsHotkeyButton"
                                            Tag="ToggleWidgets"
                                            MinWidth="140"
                                            Padding="14,5"
                                            FontFamily="{StaticResource UiFont}"
                                            AutomationProperties.Name="隐藏或显示全部桌面组件快捷键"
                                            Click="GlobalHotkey_Click"
                                            PreviewKeyDown="GlobalHotkey_PreviewKeyDown"
                                            LostKeyboardFocus="GlobalHotkey_LostKeyboardFocus"/>
                                    <Button Tag="ToggleWidgets"
                                            Margin="6,0,0,0"
                                            Padding="10,5"
                                            Content="清空"
                                            AutomationProperties.Name="清空隐藏组件快捷键"
                                            Click="GlobalHotkeyClear_Click"/>
                                </StackPanel>
                            </local:SettingsRow>
                            <local:SettingsRow Header="快速新建一条待办"
                                               Description="不返回桌面，直接唤起待办卡并聚焦新条目输入框（默认不设）"
                                               local:SettingsSearch.Keywords="待办 新建待办 快捷记录 快捷键">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="QuickTodoHotkeyHint"
                                               MaxWidth="160"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource IceMutedInkBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="QuickTodoHotkeyButton"
                                            Tag="QuickTodo"
                                            MinWidth="140"
                                            Padding="14,5"
                                            FontFamily="{StaticResource UiFont}"
                                            AutomationProperties.Name="快速新建待办快捷键"
                                            Click="GlobalHotkey_Click"
                                            PreviewKeyDown="GlobalHotkey_PreviewKeyDown"
                                            LostKeyboardFocus="GlobalHotkey_LostKeyboardFocus"/>
                                    <Button Tag="QuickTodo"
                                            Margin="6,0,0,0"
                                            Padding="10,5"
                                            Content="清空"
                                            AutomationProperties.Name="清空快速待办快捷键"
                                            Click="GlobalHotkeyClear_Click"/>
                                </StackPanel>
                            </local:SettingsRow>
                            <local:SettingsRow Header="临时切回原生桌面图标"
                                               Description="仅在开启「隐藏 Windows 桌面图标」时生效，临时显示原生桌面图标并隐藏卡片，再按一次恢复（默认不设）"
                                               local:SettingsSearch.Keywords="清爽桌面 隐藏桌面图标 桌面图标 原生桌面 快捷键">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ToggleDesktopIconsHotkeyHint"
                                               MaxWidth="160"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource IceMutedInkBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="ToggleDesktopIconsHotkeyButton"
                                            Tag="ToggleDesktopIcons"
                                            MinWidth="140"
                                            Padding="14,5"
                                            FontFamily="{StaticResource UiFont}"
                                            AutomationProperties.Name="临时切回原生桌面图标快捷键"
                                            Click="GlobalHotkey_Click"
                                            PreviewKeyDown="GlobalHotkey_PreviewKeyDown"
                                            LostKeyboardFocus="GlobalHotkey_LostKeyboardFocus"/>
                                    <Button Tag="ToggleDesktopIcons"
                                            Margin="6,0,0,0"
                                            Padding="10,5"
                                            Content="清空"
                                            AutomationProperties.Name="清空原生桌面图标快捷键"
                                            Click="GlobalHotkeyClear_Click"/>
                                </StackPanel>
                            </local:SettingsRow>

                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="18,18,18,8" Text="备份" local:SettingsSearch.Keywords="恢复 还原 备份全部"/>
                            <Border Margin="18,0,18,12" Style="{StaticResource SettingsPanelStyle}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,10"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="备份包含全部桌面组件、个人内容和设置，保存在数据目录的 Backups 文件夹。恢复后冰蓝桌面会重新启动。"/>
                                    <ListBox x:Name="BackupList"
                                             MinHeight="96"
                                             MaxHeight="150"
                                             AutomationProperties.Name="已有备份"
                                             DisplayMemberPath="Label"/>
                                    <TextBlock x:Name="BackupEmptyText"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="还没有备份。"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="立即备份" Click="CreateBackup_Click"/>
                                        <Button Margin="8,0,0,0" Content="从备份恢复…" Click="RestoreBackup_Click"/>
                                        <Button Margin="8,0,0,0" Content="删除备份" Click="DeleteBackup_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="BackupStatusText"
                                               Margin="0,10,0,0"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="18,12,18,8" Text="隐私与数据" local:SettingsSearch.Keywords="数据目录 联网 定位"/>
                            <Border Margin="18,0,18,12" Style="{StaticResource SettingsPanelStyle}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontWeight="Medium" Text="待办、便签、文件映射、Dock 固定应用和各项设置只保存在本机："/>
                                    <TextBlock x:Name="DataDirectoryText"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Margin="0,12,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="· 只有搜索天气城市和刷新天气时联网，发送搜索关键词或所选城市坐标；不使用 IP、GPS 或 Wi-Fi 定位。"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="· 检查更新时只向 GitHub 查询最新版本号。"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="· 不收集使用数据，不上传待办、文件路径、应用列表或窗口标题。"/>
                                    <Button Margin="0,14,0,0"
                                            HorizontalAlignment="Left"
                                            Content="打开数据目录"
                                            Click="OpenDataDirectory_Click"/>
                                </StackPanel>
                            </Border>

                            <local:SettingsRow Header="作者 keros68"
                                               Description="github.com/keros68/binglan，欢迎提交 PR">
                                <Button Content="打开仓库"
                                        AutomationProperties.Name="打开项目仓库页面"
                                        Click="OpenRepository_Click"/>
                            </local:SettingsRow>
                            <local:SettingsRow x:Name="UninstallRow"
                                               Header="卸载冰蓝桌面"
                                               Description="冰蓝桌面会先退出，再打开卸载程序；卸载时可选择保留个人数据"
                                               local:SettingsSearch.Keywords="删除 移除">
                                <Button x:Name="UninstallButton"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Content="卸载…"
                                        AutomationProperties.Name="卸载冰蓝桌面"
                                        Click="Uninstall_Click"/>
                            </local:SettingsRow>
                            <TextBlock x:Name="UninstallStatusText"
                                       Margin="18,4,18,10"
                                       Style="{StaticResource CaptionStyle}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
