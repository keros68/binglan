                                                <Button Margin="6,0,0,0" Content="黑" Tag="#000000" AutomationProperties.Name="文字颜色设为黑色" Click="QuickTextColor_Click"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="玻璃颜色">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="SelectedComponentBackgroundChip"
                                                        Width="30"
                                                        Height="30"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="6"
                                                        BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                                                        BorderThickness="1"/>
                                                <TextBox x:Name="SelectedComponentBackgroundColorEditor"
                                                         Width="110"
                                                         Margin="8,0,0,0"
                                                         AutomationProperties.Name="玻璃颜色"
                                                         TextChanged="ComponentEditor_TextChanged"/>
                                                <Button Margin="8,0,0,0"
                                                        Content="选择颜色…"
                                                        Tag="Background"
                                                        AutomationProperties.Name="选择卡片玻璃颜色"
                                                        Click="ComponentColorPicker_Click"/>
                                                <Button Margin="6,0,0,0" Content="白" Tag="#FFFFFF" AutomationProperties.Name="玻璃颜色设为白色" Click="QuickBackgroundColor_Click"/>
                                                <Button Margin="6,0,0,0" Content="蓝" Tag="#A0B4E1" AutomationProperties.Name="玻璃颜色设为蓝色" Click="QuickBackgroundColor_Click"/>
                                            </StackPanel>
                                        </local:SettingsRow>
