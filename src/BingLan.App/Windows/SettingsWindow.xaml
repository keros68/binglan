                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FoldTitleStyle}" Text="独立外观"/>
                                            <TextBlock x:Name="ComponentOwnLookSummaryText" Style="{StaticResource CaptionStyle}"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <Border x:Name="ComponentOwnLookIntroRow"
                                                Padding="18,12"
                                                Background="{DynamicResource SettingsSurfaceHoverBrush}"
                                                local:SettingsSearch.Exclude="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Text="默认跟随全局外观，需要时在此给这张卡片单独设置"/>
                                                <Button x:Name="ComponentViewGlobalAppearanceButton"
                                                        Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Content="查看全局外观 ›"
                                                        AutomationProperties.Name="查看全局外观"
                                                        Click="GoToUnifiedAppearance_Click"/>
                                            </Grid>
                                        </Border>
                                        <local:SettingsRow x:Name="ComponentFollowSharedLookRow"
                                                           Header="恢复跟随全局外观"
