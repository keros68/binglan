                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="Medium" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource SettingsCoordinateTextBrush}" Text="{Binding CoordinateText}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <TextBlock x:Name="CitySearchStatusText"
                                                           VerticalAlignment="Center"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           Style="{StaticResource CaptionStyle}"/>
                                                <Button x:Name="ApplyCityButton"
                                                        HorizontalAlignment="Right"
                                                        IsEnabled="False"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Content="使用所选城市"
                                                        Click="ApplyCity_Click"/>
                                            </Grid>
                                            <TextBlock Grid.Row="4"
                                                       Margin="0,12,0,0"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="只按你选的城市查询，不定位。国内省市区县来自内置离线城市库；境外地名联网使用 OpenStreetMap（© OpenStreetMap 贡献者）。天气数据来自 Open-Meteo。"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="QuickPlacesSettingsCard"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="Kind:QuickLaunch"
                                            local:SettingsSearch.Title="快捷入口">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="快捷入口内容"/>
                                    <Border Style="{StaticResource SettingsPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,10"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Text="选中一项后可换图标、改名称和位置；位置可以是文件夹、程序或文件。最多 12 个。"/>
                                            <ListBox x:Name="QuickPlaceList"
                                                     MaxHeight="210"
                                                     AutomationProperties.Name="快捷入口列表"
                                                     SelectionChanged="QuickPlaceList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontFamily="{StaticResource SettingsIconFont}" FontSize="16"
                                                                       VerticalAlignment="Center" Text="{Binding Glyph}"/>
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Target}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource IceMutedInkBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="添加" Click="QuickPlaceAdd_Click"/>
                                                <Button Margin="8,0,0,0" Content="删除" Click="QuickPlaceRemove_Click"/>
                                                <Button Margin="8,0,0,0" Content="上移" Click="QuickPlaceUp_Click"/>
                                                <Button Margin="8,0,0,0" Content="下移" Click="QuickPlaceDown_Click"/>
                                                <Button Margin="8,0,0,0" Content="恢复默认" Click="QuickPlaceReset_Click"/>
                                            </WrapPanel>
                                            <Grid x:Name="QuickPlaceEditor" Margin="0,14,0,0" IsEnabled="False">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="图标"/>
                                                <ComboBox x:Name="QuickPlaceIconPicker"
                                                          Grid.Column="1"
                                                          AutomationProperties.Name="快捷入口图标"
                                                          SelectionChanged="QuickPlaceIcon_SelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Width="26" FontFamily="{StaticResource SettingsIconFont}"
                                                                           FontSize="15" VerticalAlignment="Center" Text="{Binding Glyph}"/>
                                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="名称"/>
                                                <TextBox x:Name="QuickPlaceNameEditor"
                                                         Grid.Row="1"
                                                         Grid.Column="1"
                                                         Margin="0,8,0,0"
                                                         MaxLength="20"
                                                         AutomationProperties.Name="快捷入口名称"
                                                         LostFocus="QuickPlaceName_Commit"
                                                         KeyDown="QuickPlaceEditor_KeyDown"/>
                                                <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="位置"/>
                                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="QuickPlaceTargetEditor"
                                                             AutomationProperties.Name="快捷入口位置"
                                                             ToolTip="文件夹、程序或文件的路径；按回车或离开输入框后生效"
                                                             LostFocus="QuickPlaceTarget_Commit"
                                                             KeyDown="QuickPlaceEditor_KeyDown"/>
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="选文件夹…" Click="QuickPlaceChooseFolder_Click"/>
                                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="选程序或文件…" Click="QuickPlaceChooseFile_Click"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 所有待办卡片都走内置组件分支，周历设置只在选中待办时显示。 -->
                                <StackPanel x:Name="TodoSettingsPanel"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="Todo"
                                            local:SettingsSearch.Title="待办便签">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="周历"/>
                                    <local:SettingsGroup>
                                        <local:SettingsRow Header="周历显示周数"
                                                           Description="周历视图一次展示几周（1~5 周，默认 4 周），修改立即生效"
                                                           local:SettingsSearch.Keywords="日历 周">
                                            <ComboBox x:Name="TodoWeekCountPicker"
                                                      Width="160"
                                                      AutomationProperties.Name="周历显示周数"
                                                      SelectionChanged="TodoWeekCount_SelectionChanged">
                                                <ComboBoxItem Content="1 周"/>
                                                <ComboBoxItem Content="2 周"/>
                                                <ComboBoxItem Content="3 周"/>
                                                <ComboBoxItem Content="4 周"/>
                                                <ComboBoxItem Content="5 周"/>
                                            </ComboBox>
                                        </local:SettingsRow>
                                    </local:SettingsGroup>
                                </StackPanel>

                                <Expander x:Name="ComponentMoreFold"
                                          Margin="0,20,0,4"
                                          IsExpanded="False"
                                          Style="{StaticResource SettingsFoldStyle}"
                                          AutomationProperties.Name="更多选项">
                                    <Expander.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FoldTitleStyle}" Text="更多选项"/>
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="时间下方的细线"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <local:SettingsRow x:Name="ClockDividerRow"
                                                           Visibility="Collapsed"
                                                           Header="时间下方的细线"
                                                           Description="两端渐隐"
                                                           local:SettingsSearch.Scope="Kind:TimeDate"
                                                           local:SettingsSearch.Title="时间与问候"
                                                           local:SettingsSearch.Keywords="细线 分隔线 粗细 时钟">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="ClockDividerThicknessSlider"
                                                        Width="140"
                                                        Minimum="1"
                                                        Maximum="6"
                                                        SmallChange="0.5"
                                                        LargeChange="1"
                                                        IsSnapToTickEnabled="True"
                                                        TickFrequency="0.5"
                                                        AutomationProperties.Name="细线粗细"
                                                        ValueChanged="ClockDivider_Changed"/>
                                                <TextBlock x:Name="ClockDividerThicknessText" Margin="10,0,20,0" Style="{StaticResource ValueTextStyle}"/>
                                                <CheckBox x:Name="ClockDividerCheckBox"
                                                          AutomationProperties.Name="时间下方显示两端渐隐的细线"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="ClockDivider_Changed"
                                                          Unchecked="ClockDivider_Changed"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="ComponentOwnLookFold"
                                          Margin="0,12,0,4"
                                          Style="{StaticResource SettingsFoldStyle}"
