                                        </local:SettingsRow>
                                        <local:SettingsRow Header="这张卡片的外观">
                                            <Border Style="{StaticResource SegmentHostStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ComponentLookLightRadio"
                                                                 GroupName="ComponentLook"
                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                 Tag="Light"
                                                                 Content="浅色玻璃"
                                                                 AutomationProperties.Name="卡片外观浅色玻璃"
                                                                 Checked="ComponentLook_Changed"/>
                                                    <RadioButton x:Name="ComponentLookDarkRadio"
                                                                 GroupName="ComponentLook"
                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                 Tag="Dark"
                                                                 Content="深色玻璃"
                                                                 AutomationProperties.Name="卡片外观深色玻璃"
                                                                 Checked="ComponentLook_Changed"/>
                                                    <RadioButton x:Name="ComponentLookClearRadio"
                                                                 GroupName="ComponentLook"
                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                 Tag="Clear"
                                                                 Content="无底板"
                                                                 AutomationProperties.Name="卡片外观无底板"
                                                                 Checked="ComponentLook_Changed"/>
                                                </StackPanel>
                                            </Border>
                                        </local:SettingsRow>
                                        <local:SettingsRow x:Name="SelectedComponentFontRow" Header="字体" local:SettingsSearch.Keywords="字形">
                                            <ComboBox x:Name="SelectedComponentFontPicker"
                                                      Width="240"
                                                      AutomationProperties.Name="卡片字体"
                                                      IsTextSearchEnabled="True"
                                                      MaxDropDownHeight="280"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      SelectionChanged="ComponentFont_SelectionChanged"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="字号缩放" local:SettingsSearch.Keywords="字号 大小">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="SelectedComponentFontScaleSlider"
                                                        Width="190"
