                                            <WrapPanel x:Name="ComponentPaletteSwatches"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="文字颜色">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="SelectedComponentTextColorChip"
                                                        Width="30"
                                                        Height="30"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="6"
                                                        BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                                                        BorderThickness="1"/>
