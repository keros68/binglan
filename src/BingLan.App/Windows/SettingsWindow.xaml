<Window x:Class="BingLan.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BingLan.App.Windows"
        Title="冰蓝桌面设置"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="Manual"
        Background="{DynamicResource IcePageBrush}"
        Foreground="{DynamicResource IceInkBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ContextMenu x:Key="ComponentListItemContextMenu">
                <MenuItem Header="重命名"
                          Click="ComponentListRenameMenuItem_Click"/>
            </ContextMenu>

            <Style x:Key="ComponentListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
                <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ContextMenu" Value="{StaticResource ComponentListItemContextMenu}"/>
                <EventSetter Event="ContextMenuOpening" Handler="ComponentListItem_ContextMenuOpening"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Lift" Background="{DynamicResource SettingsAccentSoftBrush}" CornerRadius="8" Visibility="Collapsed"/>
                                <Border x:Name="Card" Padding="13,6,10,6" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter/>
                                </Border>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        Background="{DynamicResource IceActionBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Lift" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Card" Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SettingsSelectedTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 列表、模块网格等成块内容：上方一条分隔线，左右与设置行对齐。 -->
            <Style x:Key="SettingsBlockStyle" TargetType="Border">
                <Setter Property="Padding" Value="18,12,18,14"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsSurfaceBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
            </Style>
            <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>
            <Style x:Key="PageStackStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="36,28,36,40"/>
                <Setter Property="MaxWidth" Value="960"/>
            </Style>

            <LinearGradientBrush x:Key="ModePreviewGlassBarBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#55FFFFFF"/>
                <GradientStop Offset="1" Color="#33FFFFFF"/>
            </LinearGradientBrush>
            <Style x:Key="ModePreviewStyle" TargetType="Border">
                <Setter Property="Height" Value="112"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource SettingsMapWallpaperBrush}"/>
            </Style>
            <Style x:Key="ModePreviewDockStyle" TargetType="Border">
                <Setter Property="Width" Value="94"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,0,0,17"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Background" Value="#E8FFFFFF"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="SettingsRoot" Background="{DynamicResource SettingsWindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 标题区：应用名与设置搜索 -->
        <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}" BorderThickness="0,0,0,1"/>
        <TextBlock Margin="24,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Foreground="{DynamicResource IceInkBrush}"
                   Text="设置"/>
        <Grid Grid.Column="1" MaxWidth="420" Margin="24,0" VerticalAlignment="Center">
            <TextBox x:Name="SettingsSearchBox"
                     Padding="30,4,9,4"
                     Background="{DynamicResource SettingsSurfaceHoverBrush}"
                     BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                     AutomationProperties.Name="搜索设置"
                     AutomationProperties.HelpText="Ctrl+F 聚焦；上下方向键选择结果，Enter 打开"
                     TextChanged="SettingsSearchBox_TextChanged"
                     PreviewKeyDown="SettingsSearchBox_PreviewKeyDown"
                     GotKeyboardFocus="SettingsSearchBox_GotKeyboardFocus"
                     LostKeyboardFocus="SettingsSearchBox_LostKeyboardFocus"/>
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontFamily="{StaticResource SettingsIconFont}"
                       FontSize="13"
                       Foreground="{DynamicResource SettingsFaintInkBrush}"
                       Text="&#xE721;"/>
            <TextBlock x:Name="SettingsSearchPlaceholder"
                       Margin="31,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="13"
                       Foreground="{DynamicResource SettingsFaintInkBrush}"
                       Text="搜索设置，例如 透明、圆角、热键"/>
            <Popup x:Name="SettingsSearchPopup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=SettingsSearchBox}"
                   StaysOpen="True"
                   Focusable="False">
                <Border Width="{Binding ActualWidth, ElementName=SettingsSearchBox}"
                        Margin="0,6,0,0"
                        Padding="4"
                        Background="{DynamicResource SettingsPopupBrush}"
                        BorderBrush="{DynamicResource SettingsPopupBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <ListBox x:Name="SettingsSearchResults"
                                 MaxHeight="340"
                                 Padding="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 AutomationProperties.Name="搜索结果"
                                 PreviewMouseLeftButtonUp="SettingsSearchResults_PreviewMouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Foreground="{DynamicResource IceMutedInkBrush}" FontSize="12" Text="{Binding Path, Mode=OneWay}"/>
                                        <Run Foreground="{DynamicResource IceMutedInkBrush}" FontSize="12" Text=" › "/>
                                        <Run FontWeight="Medium" Text="{Binding Name, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="SettingsSearchEmptyText"
                                   Margin="10,8"
                                   Style="{StaticResource CaptionStyle}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- 左侧导航 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SettingsNavigationBrush}"
                BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14,10,14">
                <StackPanel Margin="12,8,12,0" DockPanel.Dock="Bottom">
                    <Button x:Name="NavUpdateBadgeButton"
                            Margin="0,0,0,6"
                            MinHeight="28"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="查看新版本并更新"
                            Click="NavUpdateBadge_Click"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource IceActionTextBrush}"/>
                            <TextBlock x:Name="NavUpdateBadgeText"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="NavVersionText"
                               FontSize="12"
                               Foreground="{DynamicResource SettingsFaintInkBrush}"/>
                </StackPanel>
                <ListBox x:Name="SettingsNavigationList"
                         AutomationProperties.Name="设置类别"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         PreviewKeyDown="SettingsNavigationList_PreviewKeyDown"
                         SelectionChanged="SettingsNavigationList_SelectionChanged">
                    <ListBoxItem Tag="Scheme" AutomationProperties.Name="桌面方案">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <Path Style="{StaticResource NavigationIconStyle}" Data="{StaticResource NavIcon.Scheme}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="桌面方案"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Components" AutomationProperties.Name="桌面卡片">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <Path Style="{StaticResource NavigationIconStyle}" Data="{StaticResource NavIcon.Cards}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="桌面卡片"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="TopBarNavItem" Tag="TopBar" AutomationProperties.Name="顶部信息条">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <Path Style="{StaticResource NavigationIconStyle}" Data="{StaticResource NavIcon.TopBar}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="顶部信息条"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Dock" AutomationProperties.Name="冰蓝 Dock">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <Path Style="{StaticResource NavigationIconStyle}" Data="{StaticResource NavIcon.Dock}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="冰蓝 Dock"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Taskbar" AutomationProperties.Name="Windows 任务栏">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <Path Style="{StaticResource NavigationIconStyle}" Data="{StaticResource NavIcon.Taskbar}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="Windows 任务栏"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Launcher" AutomationProperties.Name="冰蓝总览卡">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <Path Style="{StaticResource NavigationIconStyle}" Data="{StaticResource NavIcon.Launcher}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="冰蓝总览卡"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Appearance" AutomationProperties.Name="外观样式">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <Path Style="{StaticResource NavigationIconStyle}" Data="{StaticResource NavIcon.Look}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="外观样式"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavGroupFooterSeparator"
                                 Style="{StaticResource NavigationGroupSeparatorStyle}"/>
                    <ListBoxItem Tag="General" AutomationProperties.Name="通用设置">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <Path Style="{StaticResource NavigationIconStyle}" Data="{StaticResource NavIcon.General}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="通用设置"/>
                            <Ellipse x:Name="GeneralNavUpdateDot"
                                     Width="7"
                                     Height="7"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource IceActionBrush}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <!-- 桌面方案 -->
            <ScrollViewer x:Name="SchemePage" Style="{StaticResource PageScrollStyle}">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="桌面方案"/>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="选一套方案，一次设好冰蓝 Dock、顶部信息条和 Windows 任务栏。之后可在左侧的 Dock、顶部信息条、Windows 任务栏页里单独微调。"/>
                    <StackPanel x:Name="SchemeQuickActionsPanel" local:SettingsSearch.Exclude="True">
                        <TextBlock x:Name="SchemeQuickActionsHeading"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="2,12,0,8"
                                   Text="我想…"/>
                        <WrapPanel x:Name="SchemeQuickActionsWrapPanel"/>
                        <TextBlock x:Name="SchemeQuickActionsStatusText"
                                   Margin="2,2,0,0"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource CaptionStyle}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <UniformGrid Margin="0,10,0,0" Columns="3">
                        <RadioButton x:Name="WindowsNativeModeRadio"
                                     AutomationProperties.Name="Windows 原生桌面模式"
                                     Margin="0,0,8,0"
                                     GroupName="DesktopMode"
                                     Style="{StaticResource ChoiceCardStyle}"
                                     Tag="WindowsNative"
                                     Checked="DesktopMode_Checked">
                            <StackPanel>
                                <Border Style="{StaticResource ModePreviewStyle}">
                                    <Grid>
                                        <TextBlock Text="11:24" Foreground="White" FontSize="24" FontWeight="Light" Margin="16,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Border Height="16" VerticalAlignment="Bottom" Background="#FF22303F">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Border Width="8" Height="8" Margin="4" Background="#77B9E8"/>
                                                <Border Width="8" Height="8" Margin="4" Background="#D8E5EF"/>
                                                <Border Width="8" Height="8" Margin="4" Background="#D8E5EF"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="4,0" FontWeight="SemiBold" Text="Windows 原生"/>
                                <TextBlock Margin="4,2,4,0" Style="{StaticResource CaptionStyle}" Text="保留系统任务栏，不显示 Dock"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="IceBlueHybridModeRadio"
                                     AutomationProperties.Name="冰蓝混合桌面模式"
                                     Margin="4,0"
                                     GroupName="DesktopMode"
                                     Style="{StaticResource ChoiceCardStyle}"
                                     Tag="IceBlueHybrid"
                                     Checked="DesktopMode_Checked">
                            <StackPanel>
                                <Border Style="{StaticResource ModePreviewStyle}">
                                    <Grid>
                                        <TextBlock Text="11:24" Foreground="White" FontSize="24" FontWeight="Light" Margin="16,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Border Style="{StaticResource ModePreviewDockStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#5B8FC2"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#86A9C9"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#ACC3D8"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#86A9C9"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Height="10" VerticalAlignment="Bottom" Background="{StaticResource ModePreviewGlassBarBrush}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="4,0" FontWeight="SemiBold" Text="冰蓝混合"/>
                                <TextBlock Margin="4,2,4,0" Style="{StaticResource CaptionStyle}" Text="悬浮 Dock 搭配透明任务栏"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AppleStyleModeRadio"
                                     AutomationProperties.Name="苹果式桌面模式"
                                     Margin="8,0,0,0"
                                     GroupName="DesktopMode"
                                     Style="{StaticResource ChoiceCardStyle}"
                                     Tag="AppleStyle"
                                     Checked="DesktopMode_Checked">
                            <StackPanel>
                                <Border Style="{StaticResource ModePreviewStyle}">
                                    <Grid>
                                        <Border Height="13" VerticalAlignment="Top" Background="#B52B3440"/>
                                        <TextBlock Text="11:24" Foreground="White" FontSize="24" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource ModePreviewDockStyle}" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#5B8FC2"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#86A9C9"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#ACC3D8"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#86A9C9"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="4,0" FontWeight="SemiBold" Text="苹果式"/>
                                <TextBlock Margin="4,2,4,0" Style="{StaticResource CaptionStyle}" Text="顶部信息条与悬浮 Dock，任务栏自动隐藏"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Border x:Name="DesktopModeDriftPanel"
                            Margin="0,14,0,0"
                            Padding="14,8,8,8"
                            Background="{DynamicResource SettingsWarnBrush}"
                            CornerRadius="12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DesktopModeStatusText"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SettingsWarnTextBrush}"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="RestoreDesktopModeButton"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Visibility="Collapsed"
                                    Click="RestoreDesktopMode_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="当前状态"/>
                    <local:SettingsGroup x:Name="SchemeSummaryGroup" local:SettingsSearch.Exclude="True">
                        <local:SettingsRow x:Name="SchemeDockRow" Header="冰蓝 Dock">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SchemeDockDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SchemeDockStateText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" FontSize="13"/>
                                <Border x:Name="SchemeDockCustomTag" Style="{StaticResource SettingsTagStyle}" Visibility="Collapsed">
                                    <TextBlock Text="已自定义"/>
                                </Border>
                                <Button x:Name="SchemeDockAdjustButton"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="调整 →"
                                        Tag="Dock"
                                        AutomationProperties.Name="调整冰蓝 Dock"
                                        Click="BarsJump_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="SchemeTopBarRow" Header="顶部信息条">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SchemeTopBarDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SchemeTopBarStateText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" FontSize="13"/>
                                <Border x:Name="SchemeTopBarCustomTag" Style="{StaticResource SettingsTagStyle}" Visibility="Collapsed">
                                    <TextBlock Text="已自定义"/>
                                </Border>
                                <Button x:Name="SchemeTopBarAdjustButton"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="调整 →"
                                        Tag="TopBar"
                                        AutomationProperties.Name="调整顶部信息条"
                                        Click="BarsJump_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="SchemeTaskbarRow" Header="Windows 任务栏">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SchemeTaskbarDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SchemeTaskbarStateText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" FontSize="13"/>
                                <Border x:Name="SchemeTaskbarCustomTag" Style="{StaticResource SettingsTagStyle}" Visibility="Collapsed">
                                    <TextBlock Text="已自定义"/>
                                </Border>
                                <Button x:Name="SchemeTaskbarAdjustButton"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="调整 →"
                                        Tag="Taskbar"
                                        AutomationProperties.Name="调整 Windows 任务栏"
                                        Click="BarsJump_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                    </local:SettingsGroup>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="桌面"/>
                    <local:SettingsGroup>
                        <local:SettingsRow x:Name="CleanDesktopRow"
                                           Header="隐藏 Windows 桌面图标"
                                           Description="只显示冰蓝卡片和文件收纳盒，桌面更干净；关闭或退出软件自动恢复原图标"
                                           local:SettingsSearch.Keywords="清爽桌面 隐藏桌面图标 桌面图标 图标">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CleanDesktopStatusText"
                                           MaxWidth="240"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource CaptionStyle}"/>
                                <Button x:Name="CleanDesktopRetryButton"
                                        Margin="0,0,12,0"
                                        Content="重新恢复"
                                        Visibility="Collapsed"
                                        Click="CleanDesktopRetry_Click"/>
                                <CheckBox x:Name="CleanDesktopCheckBox"
                                          AutomationProperties.Name="隐藏 Windows 桌面图标"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="CleanDesktopCheckBox_Changed"
                                          Unchecked="CleanDesktopCheckBox_Changed"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="DoubleClickDesktopRow"
                                           Header="双击桌面空白处切换桌面图标"
                                           Description="默认关闭，仅在桌面空白处双击时生效"
                                           local:SettingsSearch.Keywords="双击 桌面空白 隐藏图标 桌面图标 清爽桌面 双击桌面">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DoubleClickDesktopStatusText"
                                           MaxWidth="240"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource CaptionStyle}"/>
                                <CheckBox x:Name="DoubleClickDesktopCheckBox"
                                          AutomationProperties.Name="双击桌面空白处切换桌面图标"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="DoubleClickDesktopCheckBox_Changed"
                                          Unchecked="DoubleClickDesktopCheckBox_Changed"/>
                            </StackPanel>
                        </local:SettingsRow>
                    </local:SettingsGroup>
                </StackPanel>
            </ScrollViewer>

            <!-- 外观样式 -->
            <ScrollViewer x:Name="AppearancePage"
                          Style="{StaticResource PageScrollStyle}"
                          Visibility="Collapsed"
                          local:SettingsSearch.Keywords="Dock 外观 顶栏颜色 总览卡透明 外观与材质 独立外观">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="外观样式"/>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="所有桌面卡片、冰蓝总览卡、Dock 和顶部信息条默认跟随这里的共享外观；也可以在下方“各部分外观”单独调整。"/>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="材质与颜色"/>
                    <local:SettingsGroup>
