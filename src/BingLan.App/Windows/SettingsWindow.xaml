<Window x:Class="BingLan.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BingLan.App.Windows"
        Title="冰蓝桌面设置"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource IcePageBrush}"
        Foreground="{DynamicResource IceInkBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ComponentListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
                <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Lift" Background="{DynamicResource SettingsNavSelectedBrush}" CornerRadius="8" Visibility="Collapsed"/>
                                <Border x:Name="Card" Padding="10,8" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsSurfaceHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Lift" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Card" Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SettingsNavSelectedTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 列表、模块网格等成块内容：上方一条分隔线，左右与设置行对齐。 -->
            <Style x:Key="SettingsBlockStyle" TargetType="Border">
                <Setter Property="Padding" Value="18,12,18,14"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsSurfaceBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
            </Style>
            <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>
            <Style x:Key="PageStackStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="36,28,36,40"/>
                <Setter Property="MaxWidth" Value="960"/>
            </Style>

            <LinearGradientBrush x:Key="ModePreviewGlassBarBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#55FFFFFF"/>
                <GradientStop Offset="1" Color="#33FFFFFF"/>
            </LinearGradientBrush>
            <Style x:Key="ModePreviewStyle" TargetType="Border">
                <Setter Property="Height" Value="112"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource SettingsMapWallpaperBrush}"/>
            </Style>
            <Style x:Key="ModePreviewDockStyle" TargetType="Border">
                <Setter Property="Width" Value="94"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,0,0,17"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Background" Value="#E8FFFFFF"/>
            </Style>

            <!-- 屏幕示意图上的可点区域：悬停或键盘焦点时显示白色描边。 -->
            <Style x:Key="ScreenMapButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource SettingsMapTextBrush}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MapSurface" Padding="12,7" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="2"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MapSurface" Property="BorderBrush" Value="{DynamicResource SettingsMapTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="MapSurface" Property="BorderBrush" Value="{DynamicResource SettingsMapTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="SettingsRoot" Background="{DynamicResource SettingsWindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 标题区：应用名与设置搜索 -->
        <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}" BorderThickness="0,0,0,1"/>
        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
            <Image Width="22"
                   Height="22"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="/BingLan;component/Assets/Brand/binglan-icon.png"/>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="冰蓝桌面设置"/>
        </StackPanel>
        <Grid Grid.Column="1" MaxWidth="420" Margin="24,0" VerticalAlignment="Center">
            <TextBox x:Name="SettingsSearchBox"
                     Padding="30,4,9,4"
                     Background="{DynamicResource SettingsSurfaceHoverBrush}"
                     BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                     AutomationProperties.Name="搜索设置"
                     AutomationProperties.HelpText="Ctrl+F 聚焦；上下方向键选择结果，Enter 打开"
                     TextChanged="SettingsSearchBox_TextChanged"
                     PreviewKeyDown="SettingsSearchBox_PreviewKeyDown"
                     GotKeyboardFocus="SettingsSearchBox_GotKeyboardFocus"
                     LostKeyboardFocus="SettingsSearchBox_LostKeyboardFocus"/>
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontFamily="{StaticResource SettingsIconFont}"
                       FontSize="13"
                       Foreground="{DynamicResource SettingsFaintInkBrush}"
                       Text="&#xE721;"/>
            <TextBlock x:Name="SettingsSearchPlaceholder"
                       Margin="31,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="13"
                       Foreground="{DynamicResource SettingsFaintInkBrush}"
                       Text="搜索设置，例如 透明、圆角、热键"/>
            <Popup x:Name="SettingsSearchPopup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=SettingsSearchBox}"
                   StaysOpen="True"
                   Focusable="False">
                <Border Width="{Binding ActualWidth, ElementName=SettingsSearchBox}"
                        Margin="0,6,0,0"
                        Padding="4"
                        Background="{DynamicResource SettingsPopupBrush}"
                        BorderBrush="{DynamicResource SettingsPopupBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <ListBox x:Name="SettingsSearchResults"
                                 MaxHeight="340"
                                 Padding="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 AutomationProperties.Name="搜索结果"
                                 PreviewMouseLeftButtonUp="SettingsSearchResults_PreviewMouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Foreground="{DynamicResource IceMutedInkBrush}" FontSize="12" Text="{Binding Path, Mode=OneWay}"/>
                                        <Run Foreground="{DynamicResource IceMutedInkBrush}" FontSize="12" Text=" › "/>
                                        <Run FontWeight="Medium" Text="{Binding Name, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="SettingsSearchEmptyText"
                                   Margin="10,8"
                                   Style="{StaticResource CaptionStyle}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- 左侧导航 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SettingsNavigationBrush}"
                BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14,10,14">
                <TextBlock x:Name="NavVersionText"
                           Margin="12,0,0,0"
                           DockPanel.Dock="Bottom"
                           FontSize="12"
                           Foreground="{DynamicResource SettingsFaintInkBrush}"/>
                <ListBox x:Name="SettingsNavigationList"
                         AutomationProperties.Name="设置类别"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         SelectionChanged="SettingsNavigationList_SelectionChanged"
                         SelectedIndex="0">
                    <ListBoxItem Tag="Scheme" AutomationProperties.Name="桌面方案">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <TextBlock Style="{StaticResource NavigationGlyphStyle}" Text="&#xE7F4;"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="桌面方案"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Appearance" AutomationProperties.Name="外观样式">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <TextBlock Style="{StaticResource NavigationGlyphStyle}" Text="&#xE790;"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="外观样式"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Components" AutomationProperties.Name="桌面组件">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <TextBlock Style="{StaticResource NavigationGlyphStyle}" Text="&#xE8A9;"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="桌面组件"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Bars" AutomationProperties.Name="顶栏底栏">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <TextBlock Style="{StaticResource NavigationGlyphStyle}" Text="&#xE7C4;"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="顶栏底栏"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="General" AutomationProperties.Name="通用设置">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource NavigationTileStyle}">
                                <TextBlock Style="{StaticResource NavigationGlyphStyle}" Text="&#xE713;"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="通用设置"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <!-- 桌面方案 -->
            <ScrollViewer x:Name="SchemePage" Style="{StaticResource PageScrollStyle}">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="桌面方案"/>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="选一套方案，一次设好 Dock、顶端信息条和任务栏。之后可在“顶栏底栏”里单独微调。"/>
                    <UniformGrid Margin="0,18,0,0" Columns="3">
                        <RadioButton x:Name="WindowsNativeModeRadio"
                                     AutomationProperties.Name="Windows 原生桌面模式"
                                     Margin="0,0,8,0"
                                     GroupName="DesktopMode"
                                     Style="{StaticResource ChoiceCardStyle}"
                                     Tag="WindowsNative"
                                     Checked="DesktopMode_Checked">
                            <StackPanel>
                                <Border Style="{StaticResource ModePreviewStyle}">
                                    <Grid>
                                        <TextBlock Text="11:24" Foreground="White" FontSize="24" FontWeight="Light" Margin="16,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Border Height="16" VerticalAlignment="Bottom" Background="#FF22303F">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Border Width="8" Height="8" Margin="4" Background="#77B9E8"/>
                                                <Border Width="8" Height="8" Margin="4" Background="#D8E5EF"/>
                                                <Border Width="8" Height="8" Margin="4" Background="#D8E5EF"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="4,0" FontWeight="SemiBold" Text="Windows 原生"/>
                                <TextBlock Margin="4,2,4,0" Style="{StaticResource CaptionStyle}" Text="保留系统任务栏，不显示 Dock"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="IceBlueHybridModeRadio"
                                     AutomationProperties.Name="冰蓝混合桌面模式"
                                     Margin="4,0"
                                     GroupName="DesktopMode"
                                     Style="{StaticResource ChoiceCardStyle}"
                                     Tag="IceBlueHybrid"
                                     Checked="DesktopMode_Checked">
                            <StackPanel>
                                <Border Style="{StaticResource ModePreviewStyle}">
                                    <Grid>
                                        <TextBlock Text="11:24" Foreground="White" FontSize="24" FontWeight="Light" Margin="16,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Border Style="{StaticResource ModePreviewDockStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#5B8FC2"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#86A9C9"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#ACC3D8"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#86A9C9"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Height="10" VerticalAlignment="Bottom" Background="{StaticResource ModePreviewGlassBarBrush}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="4,0" FontWeight="SemiBold" Text="冰蓝混合"/>
                                <TextBlock Margin="4,2,4,0" Style="{StaticResource CaptionStyle}" Text="悬浮 Dock 搭配透明任务栏"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AppleStyleModeRadio"
                                     AutomationProperties.Name="苹果式桌面模式"
                                     Margin="8,0,0,0"
                                     GroupName="DesktopMode"
                                     Style="{StaticResource ChoiceCardStyle}"
                                     Tag="AppleStyle"
                                     Checked="DesktopMode_Checked">
                            <StackPanel>
                                <Border Style="{StaticResource ModePreviewStyle}">
                                    <Grid>
                                        <Border Height="13" VerticalAlignment="Top" Background="#B52B3440"/>
                                        <TextBlock Text="11:24" Foreground="White" FontSize="24" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource ModePreviewDockStyle}" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#5B8FC2"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#86A9C9"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#ACC3D8"/>
                                                <Ellipse Width="9" Height="9" Margin="5" Fill="#86A9C9"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="4,0" FontWeight="SemiBold" Text="苹果式"/>
                                <TextBlock Margin="4,2,4,0" Style="{StaticResource CaptionStyle}" Text="顶部信息条与悬浮 Dock，任务栏自动隐藏"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Border x:Name="DesktopModeDriftPanel"
                            Margin="0,14,0,0"
                            Padding="14,8,8,8"
                            Background="{DynamicResource SettingsWarnBrush}"
                            CornerRadius="12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DesktopModeStatusText"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SettingsWarnTextBrush}"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="RestoreDesktopModeButton"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Visibility="Collapsed"
                                    Click="RestoreDesktopMode_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="当前状态"/>
                    <local:SettingsGroup x:Name="SchemeSummaryGroup" local:SettingsSearch.Exclude="True">
                        <local:SettingsRow x:Name="SchemeDockRow" Header="冰蓝 Dock">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SchemeDockDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SchemeDockStateText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" FontSize="13"/>
                                <Border x:Name="SchemeDockCustomTag" Style="{StaticResource SettingsTagStyle}" Visibility="Collapsed">
                                    <TextBlock Text="已自定义"/>
                                </Border>
                                <Button x:Name="SchemeDockAdjustButton"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="调整 →"
                                        Tag="Dock"
                                        AutomationProperties.Name="调整冰蓝 Dock"
                                        Click="BarsJump_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="SchemeTopBarRow" Header="顶端信息条">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SchemeTopBarDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SchemeTopBarStateText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" FontSize="13"/>
                                <Border x:Name="SchemeTopBarCustomTag" Style="{StaticResource SettingsTagStyle}" Visibility="Collapsed">
                                    <TextBlock Text="已自定义"/>
                                </Border>
                                <Button x:Name="SchemeTopBarAdjustButton"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="调整 →"
                                        Tag="TopBar"
                                        AutomationProperties.Name="调整顶端信息条"
                                        Click="BarsJump_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="SchemeTaskbarRow" Header="Windows 任务栏">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SchemeTaskbarDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SchemeTaskbarStateText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" FontSize="13"/>
                                <Border x:Name="SchemeTaskbarCustomTag" Style="{StaticResource SettingsTagStyle}" Visibility="Collapsed">
                                    <TextBlock Text="已自定义"/>
                                </Border>
                                <Button x:Name="SchemeTaskbarAdjustButton"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="调整 →"
                                        Tag="Taskbar"
                                        AutomationProperties.Name="调整 Windows 任务栏"
                                        Click="BarsJump_Click"/>
                            </StackPanel>
                        </local:SettingsRow>
                    </local:SettingsGroup>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="桌面"/>
                    <local:SettingsGroup>
                        <local:SettingsRow x:Name="CleanDesktopRow"
                                           Header="清爽桌面"
                                           Description="隐藏 Windows 桌面图标，只显示冰蓝桌面组件；退出时自动恢复"
                                           local:SettingsSearch.Keywords="隐藏桌面图标 图标">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CleanDesktopStatusText"
                                           MaxWidth="240"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource CaptionStyle}"/>
                                <Button x:Name="CleanDesktopRetryButton"
                                        Margin="0,0,12,0"
                                        Content="重新恢复"
                                        Visibility="Collapsed"
                                        Click="CleanDesktopRetry_Click"/>
                                <CheckBox x:Name="CleanDesktopCheckBox"
                                          AutomationProperties.Name="隐藏 Windows 桌面图标"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="CleanDesktopCheckBox_Changed"
                                          Unchecked="CleanDesktopCheckBox_Changed"/>
                            </StackPanel>
                        </local:SettingsRow>
                    </local:SettingsGroup>
                </StackPanel>
            </ScrollViewer>

            <!-- 外观样式 -->
            <ScrollViewer x:Name="AppearancePage" Style="{StaticResource PageScrollStyle}" Visibility="Collapsed">
                <StackPanel Style="{StaticResource PageStackStyle}">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="外观样式"/>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="所有卡片、Dock 和顶端信息条默认跟随这里的设置；也可以在“桌面组件”里为单张卡片设置独立外观。"/>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="材质与颜色"/>
                    <local:SettingsGroup>
                        <local:SettingsRow Header="试选外观" Description="先在示例中对比，确认后应用">
                            <Button x:Name="AppearancePreviewButton" Content="试选外观…"
                                    AutomationProperties.Name="试选外观" Click="AppearancePreview_Click"/>
                        </local:SettingsRow>
                        <local:SettingsRow Header="材质" Description="应用到所有卡片" local:SettingsSearch.Keywords="玻璃 透明">
                            <Border Style="{StaticResource SegmentHostStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="GlassLightRadio"
                                                 GroupName="GlassMode"
                                                 Style="{StaticResource SegmentRadioStyle}"
                                                 Tag="Light"
                                                 Content="浅色玻璃"
                                                 Checked="Glass_Changed"/>
                                    <RadioButton x:Name="GlassDarkRadio"
                                                 GroupName="GlassMode"
                                                 Style="{StaticResource SegmentRadioStyle}"
                                                 Tag="Dark"
                                                 Content="深色玻璃"
                                                 Checked="Glass_Changed"/>
                                    <RadioButton x:Name="GlassClearRadio"
                                                 GroupName="GlassMode"
                                                 Style="{StaticResource SegmentRadioStyle}"
                                                 Tag="Clear"
                                                 Content="无底板"
                                                 Checked="Glass_Changed"/>
                                </StackPanel>
                            </Border>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="GlassPalettePanel" Style="{StaticResource NestedSettingsRowStyle}" Header="配色"
                                           local:SettingsSearch.Keywords="颜色 主题色">
                            <WrapPanel x:Name="GlassPaletteSwatches"/>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="ItemSurfacePanel"
                                           Style="{StaticResource NestedSettingsRowStyle}"
                                           Header="内部底色"
                                           Description="卡片里的行、按钮和日期格；浅色玻璃时可用">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SegmentHostStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ItemSurfaceLightRadio"
                                                     GroupName="ItemSurfaceTone"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     Content="浅色"
                                                     AutomationProperties.Name="内部底色浅色"
                                                     Checked="ItemSurfaceTone_Changed"/>
                                        <RadioButton x:Name="ItemSurfaceDarkRadio"
                                                     GroupName="ItemSurfaceTone"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     Content="深色"
                                                     ToolTip="适合白色文字"
                                                     AutomationProperties.Name="内部底色深色"
                                                     Checked="ItemSurfaceTone_Changed"/>
                                    </StackPanel>
                                </Border>
                                <Slider x:Name="ItemSurfaceStrengthSlider"
                                        Width="150"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Minimum="0"
                                        Maximum="0.8"
                                        SmallChange="0.02"
                                        LargeChange="0.1"
                                        AutomationProperties.Name="内部底色浓度"
                                        ValueChanged="ItemSurfaceStrength_Changed"/>
                                <TextBlock x:Name="ItemSurfaceStrengthText" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow x:Name="GlassDensityPanel"
                                           Style="{StaticResource NestedSettingsRowStyle}"
                                           Header="玻璃浓度"
                                           Description="无底板时不可用"
                                           local:SettingsSearch.Keywords="透明度 不透明 磨砂">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="GlassDensitySlider"
                                        Width="200"
                                        Minimum="0.05"
                                        Maximum="0.96"
                                        SmallChange="0.02"
                                        LargeChange="0.1"
                                        AutomationProperties.Name="玻璃浓度"
                                        ValueChanged="GlassDensity_Changed"/>
                                <TextBlock x:Name="GlassDensityText" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>
                        </local:SettingsRow>
                    </local:SettingsGroup>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="文字"/>
                    <local:SettingsGroup>
                        <local:SettingsRow Header="文字颜色" Description="无底板时自动加上柔和文字阴影" local:SettingsSearch.Keywords="字体颜色">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SegmentHostStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TextInkAutoRadio"
                                                     GroupName="TextInk"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     Content="跟随外观"
                                                     Checked="Glass_Changed"/>
                                        <RadioButton x:Name="TextInkWhiteRadio"
                                                     GroupName="TextInk"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     Content="白色"
                                                     ToolTip="适合深色壁纸"
                                                     AutomationProperties.Name="白色文字"
                                                     Checked="Glass_Changed"/>
                                        <RadioButton x:Name="TextInkDarkRadio"
                                                     GroupName="TextInk"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     Content="深色"
                                                     ToolTip="适合浅色壁纸"
                                                     AutomationProperties.Name="深色文字"
                                                     Checked="Glass_Changed"/>
                                        <RadioButton x:Name="TextInkCustomRadio"
                                                     GroupName="TextInk"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     Content="自定义"
                                                     Checked="Glass_Changed"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="CustomTextColorButton"
                                        Margin="8,0,0,0"
                                        Padding="10,5"
                                        AutomationProperties.Name="选择文字颜色"
                                        ToolTip="选择文字颜色"
                                        Click="CustomTextColor_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="CustomTextColorChip"
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                CornerRadius="7"
                                                BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                                                BorderThickness="1"/>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="选色…"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Header="文字阴影"
                                           Description="让卡片上的文字和图标在复杂壁纸上更清楚"
                                           local:SettingsSearch.Keywords="描边 投影">
                            <ComboBox x:Name="CardShadowSelector"
                                      Width="160"
                                      AutomationProperties.Name="文字阴影"
                                      SelectionChanged="StyleSelector_SelectionChanged">
                                <ComboBoxItem Content="无" Tag="None"/>
                                <ComboBoxItem Content="柔和" Tag="Soft"/>
                                <ComboBoxItem Content="明显" Tag="Strong"/>
                            </ComboBox>
                        </local:SettingsRow>
                    </local:SettingsGroup>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="排列与细节"/>
                    <local:SettingsGroup>
                        <local:SettingsRow Header="吸附间距"
                                           Description="拖动卡片靠近其他卡片时保留的距离"
                                           local:SettingsSearch.Keywords="间距">
                            <ComboBox x:Name="CardSpacingSelector"
                                      Width="160"
                                      AutomationProperties.Name="吸附间距"
                                      SelectionChanged="StyleSelector_SelectionChanged">
                                <ComboBoxItem Content="紧凑（8）" Tag="8"/>
                                <ComboBoxItem Content="标准（16）" Tag="16"/>
                                <ComboBoxItem Content="宽松（24）" Tag="24"/>
                            </ComboBox>
                        </local:SettingsRow>
                        <local:SettingsRow Header="网格对齐"
                                           Description="拖动卡片时显示网格并对齐到格点，代替就近卡片对齐；按住 Alt 拖动可临时自由移动"
                                           local:SettingsSearch.Keywords="吸附 对齐">
                            <CheckBox x:Name="GridSnapCheckBox"
                                      AutomationProperties.Name="网格对齐"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="GridSnapCheckBox_Changed"
                                      Unchecked="GridSnapCheckBox_Changed"/>
                        </local:SettingsRow>
                        <local:SettingsRow Header="标题栏按钮仅在鼠标移上时显示"
                                           Description="待办和分组盒的按钮在悬停或键盘选中时显示，位置保持不变"
                                           local:SettingsSearch.Keywords="悬停 隐藏按钮">
                            <CheckBox x:Name="HeaderToolsOnHoverCheckBox"
                                      AutomationProperties.Name="标题栏按钮仅在鼠标移上时显示"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="HeaderToolsOnHoverCheckBox_Changed"
                                      Unchecked="HeaderToolsOnHoverCheckBox_Changed"/>
                        </local:SettingsRow>
                    </local:SettingsGroup>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="未跟随全局的部分"/>
                    <local:SettingsGroup x:Name="AppearanceOverridesGroup" local:SettingsSearch.Exclude="True"/>

                    <Expander x:Name="AppearanceBarsLookFold"
                              Margin="0,24,0,4"
                              Style="{StaticResource SettingsFoldStyle}"
                              AutomationProperties.Name="Dock 与顶端信息条外观">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FoldTitleStyle}" Text="Dock 与顶端信息条外观"/>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="默认跟随上面的全局外观，也可以单独设置颜色和浓度"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <local:SettingsRow x:Name="DockLookSettingsRow" Header="Dock 外观">
                                <Border Style="{StaticResource SegmentHostStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="DockFollowLookRadio"
                                                     GroupName="DockLook"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     Content="跟随卡片外观"
                                                     Checked="DockLook_Changed"/>
                                        <RadioButton x:Name="DockCustomLookRadio"
                                                     GroupName="DockLook"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     Content="自定义"
                                                     Checked="DockLook_Changed"/>
                                    </StackPanel>
                                </Border>
                            </local:SettingsRow>
                            <StackPanel x:Name="DockCustomLookPanel">
                                <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="Dock 配色">
                                    <WrapPanel x:Name="DockPaletteSwatches"/>
                                </local:SettingsRow>
                                <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="Dock 颜色">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="DockColorPreview"
                                                VerticalAlignment="Center"
                                                Width="30"
                                                Height="30"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource SettingsControlBorderBrush}"/>
                                        <TextBox x:Name="DockColorEditor"
                                                 Width="110"
                                                 Margin="8,0,0,0"
                                                 AutomationProperties.Name="Dock 颜色"
                                                 LostFocus="DockColorEditor_Commit"
                                                 KeyDown="DockColorEditor_KeyDown"/>
                                        <Button Margin="8,0,0,0" Content="选择颜色…" AutomationProperties.Name="选择 Dock 颜色" Click="DockChooseColor_Click"/>
                                    </StackPanel>
                                </local:SettingsRow>
                                <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="Dock 玻璃浓度">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="DockOpacitySlider"
                                                Width="200"
                                                Minimum="0.05"
                                                Maximum="0.96"
                                                SmallChange="0.02"
                                                LargeChange="0.1"
                                                AutomationProperties.Name="Dock 玻璃浓度"
                                                ValueChanged="DockOpacity_Changed"/>
                                        <TextBlock x:Name="DockOpacityText" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </local:SettingsRow>
                            </StackPanel>
                            <StackPanel x:Name="TopBarLookPanel">
                                <local:SettingsRow Header="顶端信息条磨砂玻璃"
                                                   Description="深色表面下对壁纸做真实模糊（接近 macOS 菜单栏质感）；关闭后用半透明纯色。浅色材质不受影响">
                                    <CheckBox x:Name="TopBarFrostedCheckBox"
                                              AutomationProperties.Name="磨砂玻璃"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="TopBarSetting_Changed"
                                              Unchecked="TopBarSetting_Changed"/>
                                </local:SettingsRow>
                                <local:SettingsRow x:Name="TopBarLookSettingsRow" Header="顶端信息条外观">
                                    <Border Style="{StaticResource SegmentHostStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="TopBarFollowLookRadio"
                                                         GroupName="TopBarLook"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Content="跟随卡片外观"
                                                         Checked="TopBarLook_Changed"/>
                                            <RadioButton x:Name="TopBarCustomLookRadio"
                                                         GroupName="TopBarLook"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Content="自定义"
                                                         Checked="TopBarLook_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </local:SettingsRow>
                                <StackPanel x:Name="TopBarCustomLookPanel">
                                    <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="顶端信息条颜色">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="TopBarColorPreview"
                                                    VerticalAlignment="Center"
                                                    Width="30"
                                                    Height="30"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource SettingsControlBorderBrush}"/>
                                            <TextBox x:Name="TopBarColorEditor"
                                                     Width="110"
                                                     Margin="8,0,0,0"
                                                     AutomationProperties.Name="顶端信息条颜色"
                                                     LostFocus="TopBarColorEditor_Commit"
                                                     KeyDown="TopBarColorEditor_KeyDown"/>
                                            <Button Margin="8,0,0,0" Content="选择颜色…" AutomationProperties.Name="选择顶端信息条颜色" Click="TopBarChooseColor_Click"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                    <local:SettingsRow Style="{StaticResource NestedSettingsRowStyle}" Header="顶端信息条不透明度">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="TopBarOpacitySlider"
                                                    Width="200"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    SmallChange="0.02"
                                                    LargeChange="0.1"
                                                    AutomationProperties.Name="顶端信息条不透明度"
                                                    ValueChanged="TopBarOpacity_Changed"/>
                                            <TextBlock x:Name="TopBarOpacityText" Style="{StaticResource ValueTextStyle}"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AppearanceLayoutFold"
                              Margin="0,12,0,4"
                              Style="{StaticResource SettingsFoldStyle}"
                              AutomationProperties.Name="布局预设与主题">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FoldTitleStyle}" Text="布局预设与主题"/>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="布局预设 · 主题包 · 从 Rainmeter 导入"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <local:SettingsRow Header="布局预设"
                                               Description="改变桌面卡片的摆放位置，选好后点击“应用布局”"
                                               local:SettingsSearch.Keywords="布局 摆放">
                                <Button x:Name="ApplyLayoutButton"
                                        MinWidth="110"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="应用布局"
                                        Click="ApplyLayout_Click"/>
                            </local:SettingsRow>
                            <Border Padding="18,0,18,14">
                                <StackPanel>
                                    <Border Height="230"
                                            Margin="0,0,0,12"
                                            Background="{DynamicResource SettingsPreviewBrush}"
                                            BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Image x:Name="PresetPreviewImage" Stretch="Uniform"/>
                                    </Border>
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="QuietInformationPresetRadio"
                                                     AutomationProperties.Name="静谧信息层布局"
                                                     Margin="0,0,6,0"
                                                     GroupName="LayoutPreset"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="QuietInformation"
                                                     Checked="PresetRadio_Checked">
                                            <StackPanel>
                                                <Border Height="80" CornerRadius="5" ClipToBounds="True">
                                                    <Image x:Name="QuietPresetThumb" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12.5" Text="静谧信息层"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="GlacierWorkbenchPresetRadio"
                                                     AutomationProperties.Name="冰川工作台布局"
                                                     Margin="3,0"
                                                     GroupName="LayoutPreset"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="GlacierWorkbench"
                                                     Checked="PresetRadio_Checked">
                                            <StackPanel>
                                                <Border Height="80" CornerRadius="5" ClipToBounds="True">
                                                    <Image x:Name="GlacierPresetThumb" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12.5" Text="冰川工作台"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TransparentApplePresetRadio"
                                                     AutomationProperties.Name="通透苹果桌面布局"
                                                     Margin="3,0"
                                                     GroupName="LayoutPreset"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="TransparentApple"
                                                     Checked="PresetRadio_Checked">
                                            <StackPanel>
                                                <Border Height="80" CornerRadius="5" ClipToBounds="True">
                                                    <Image x:Name="ApplePresetThumb" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12.5" Text="通透苹果桌面"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="CenterClockPresetRadio"
                                                     AutomationProperties.Name="居中时钟布局"
                                                     Margin="6,0,0,0"
                                                     GroupName="LayoutPreset"
                                                     Style="{StaticResource ChoiceCardStyle}"
                                                     Tag="CenterClock"
                                                     Checked="PresetRadio_Checked">
                                            <StackPanel>
                                                <Border Height="80" CornerRadius="5" ClipToBounds="True">
                                                    <Image x:Name="CenterClockPresetThumb" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12.5" Text="居中时钟"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock x:Name="LayoutStatusText"
                                               Margin="2,10,0,0"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                            </Border>
                            <local:SettingsRow Header="主题包"
                                               Description="包含颜色、材质、圆角、字号、相对布局和 Dock 应用槽位；不含姓名、城市、待办和文件映射"
                                               local:SettingsSearch.Keywords="导出 导入 分享">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导出主题…" Click="ExportTheme_Click"/>
                                    <Button Margin="8,0,0,0" Content="导入主题…" Click="ImportTheme_Click"/>
                                </StackPanel>
                            </local:SettingsRow>
                            <TextBlock x:Name="ThemeStatusText"
                                       Margin="18,0,18,10"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionStyle}"/>
                            <local:SettingsRow Header="从 Rainmeter 皮肤导入"
                                               Description="只读取字体、颜色和圆角，导入后不保持关联"
                                               local:SettingsSearch.Keywords="雨滴 皮肤">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RainmeterImportStatusText"
                                               MaxWidth="220"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource CaptionStyle}"/>
                                    <Button Content="选择皮肤…"
                                            AutomationProperties.Name="从 Rainmeter 皮肤导入外观"
                                            Click="ImportRainmeterLook_Click"/>
                                </StackPanel>
                            </local:SettingsRow>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- 桌面组件 -->
            <Grid x:Name="ComponentsPage" Margin="36,28,36,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="桌面组件"/>
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="选择一张卡片，在右侧调整显示、内容和外观；修改立即生效。"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" Orientation="Horizontal">
                        <Button x:Name="AddTodoButton" AutomationProperties.Name="新建待办便签" Click="AddTodo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonGlyphStyle}" Text="&#xE710;"/>
                                <TextBlock Text="待办便签"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddNoteButton" Margin="8,0,0,0" AutomationProperties.Name="新建普通便签" Click="AddNote_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonGlyphStyle}" Text="&#xE710;"/>
                                <TextBlock Text="普通便签"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddFileBoxButton" Margin="8,0,0,0" AutomationProperties.Name="新建桌面分组盒" Click="AddFileBox_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonGlyphStyle}" Text="&#xE710;"/>
                                <TextBlock Text="桌面分组盒"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="DesktopComponentList"
                             VerticalAlignment="Top"
                             AutomationProperties.Name="桌面组件列表"
                             Padding="6"
                             Background="{DynamicResource SettingsSurfaceBrush}"
                             BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                             ItemContainerStyle="{StaticResource ComponentListItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="DesktopComponentList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="Medium"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="7,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SettingsBadgeBrush}"
                                            CornerRadius="8">
                                        <TextBlock FontSize="11"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource SettingsBadgeTextBrush}"
                                                   Text="{Binding Status}"/>
                                    </Border>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,2,0,0"
                                               FontSize="11.5"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource IceMutedInkBrush}"
                                               Text="{Binding TypeName}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer x:Name="ComponentDetailsScrollViewer"
                                  Grid.Column="2"
                                  Style="{StaticResource PageScrollStyle}">
                        <StackPanel Margin="0,0,6,8">
                            <StackPanel x:Name="BuiltInComponentEditorPanel"
                                        local:SettingsSearch.Scope="Builtin"
                                        local:SettingsSearch.Title="信息卡片">
                                <TextBlock x:Name="SelectedComponentHeadingText"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="未锁定时可直接拖动桌面空白区。"/>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="2,20,0,10" Text="显示与位置"/>
                                <local:SettingsGroup>
                                    <local:SettingsRow Header="显示此组件">
                                        <CheckBox x:Name="SelectedComponentVisibleCheckBox"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="ComponentToggle_Changed"
                                                  Unchecked="ComponentToggle_Changed"/>
                                    </local:SettingsRow>
                                    <local:SettingsRow Header="锁定卡片位置" Description="未锁定时可直接拖动卡片空白处">
                                        <CheckBox x:Name="SelectedComponentLockedCheckBox"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="ComponentToggle_Changed"
                                                  Unchecked="ComponentToggle_Changed"/>
                                    </local:SettingsRow>
                                    <local:SettingsRow Header="位置">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="恢复默认位置" Click="ResetComponentPlacement_Click"/>
                                            <Button x:Name="DeleteComponentButton"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Content="删除此卡片"
                                                    Click="DeleteComponent_Click"/>
                                        </StackPanel>
                                    </local:SettingsRow>
                                </local:SettingsGroup>

                                <StackPanel x:Name="DisplayContentSettingsCard"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="Kind:TimeDate"
                                            local:SettingsSearch.Title="时间与问候">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="时间与问候"/>
                                    <local:SettingsGroup>
                                        <local:SettingsRow Header="问候称呼" Description="显示在问候语里的名字" local:SettingsSearch.Keywords="名字 昵称">
                                            <TextBox x:Name="GreetingNameEditor"
                                                     Width="220"
                                                     AutomationProperties.Name="问候称呼"
                                                     TextChanged="DisplaySettings_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="使用 24 小时制" local:SettingsSearch.Keywords="时间 时钟 12 小时">
                                            <CheckBox x:Name="Use24HourClockCheckBox"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DisplaySettings_Changed"
                                                      Unchecked="DisplaySettings_Changed"/>
                                        </local:SettingsRow>
                                        <local:SettingsRow Header="时间下方的细线" Description="两端渐隐">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="ClockDividerThicknessSlider"
                                                        Width="140"
                                                        Minimum="1"
                                                        Maximum="6"
                                                        SmallChange="0.5"
                                                        LargeChange="1"
                                                        IsSnapToTickEnabled="True"
                                                        TickFrequency="0.5"
                                                        AutomationProperties.Name="细线粗细"
                                                        ValueChanged="ClockDivider_Changed"/>
                                                <TextBlock x:Name="ClockDividerThicknessText" Margin="10,0,20,0" Style="{StaticResource ValueTextStyle}"/>
                                                <CheckBox x:Name="ClockDividerCheckBox"
                                                          AutomationProperties.Name="时间下方显示两端渐隐的细线"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="ClockDivider_Changed"
                                                          Unchecked="ClockDivider_Changed"/>
                                            </StackPanel>
                                        </local:SettingsRow>
                                    </local:SettingsGroup>
                                    <TextBlock x:Name="DisplaySettingsStatusText"
                                               Margin="2,6,0,0"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="修改后立即生效"/>
                                </StackPanel>

                                <StackPanel x:Name="WeatherContentSettingsCard"
                                            Visibility="Collapsed"
                                            local:SettingsSearch.Scope="Kind:Weather"
