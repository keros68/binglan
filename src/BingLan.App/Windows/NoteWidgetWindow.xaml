<local:WidgetWindowBase x:Class="BingLan.App.Windows.NoteWidgetWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:BingLan.App.Windows"
                        Title="便签"
                        Width="306"
                        Height="266"
                        MinWidth="226"
                        MinHeight="166"
                        WindowStyle="None"
                        ResizeMode="CanResize"
                        AllowsTransparency="True"
                        Background="Transparent"
                        ShowInTaskbar="False"
                        FontFamily="{StaticResource UiFont}"
                        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid x:Name="BodySurface"
          Background="{Binding WidgetBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
          ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarSurface"
                    Height="48"
                    Margin="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    CornerRadius="{Binding HeaderCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                <Grid>
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TitleAccentTag"
                                    Width="4"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{Binding WidgetHeaderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                            <TextBox x:Name="TitleEditor"
                                     Grid.Column="1"
                                     Style="{StaticResource DesktopContentTitleStyle}"
                                     Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                     FontFamily="{Binding WidgetTitleFontFamily, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                     FontWeight="{Binding WidgetTitleFontWeight, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                     FontStyle="{Binding WidgetTitleFontStyle, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                     TextChanged="TitleEditor_TextChanged"/>
                        </Grid>
                    <Button x:Name="SettingsButton"
                            Grid.Column="1"
                            AutomationProperties.Name="打开便签设置"
                            Style="{StaticResource WidgetSettingsButtonStyle}"
                            Width="30"
                            Height="28"
                            Margin="0,0,2,0"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="{StaticResource CardFont.Subhead}"
                            Content="•••"
                            ToolTip="设置"
                            Click="Settings_Click"/>
                    <Button Grid.Column="2"
                            x:Name="FormatToggle"
                            AutomationProperties.Name="正文样式"
                            Style="{StaticResource WidgetSettingsButtonStyle}"
                            Width="30"
                            Height="28"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="{StaticResource CardFont.Body}"
                            Content="Aa"
                            ToolTip="正文样式"
                            Click="FormatToggle_Click"/>
                    </Grid>
                    <Border x:Name="TitleDivider"
                            Height="1"
                            Margin="16,0,16,0"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Background="{Binding WidgetDividerBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                </Grid>
            </Border>

            <Border x:Name="FormatBar"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Margin="10,6,10,0"
                    Padding="6,4"
                    Background="{DynamicResource WidgetItemSurfaceBrush}"
                    CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                <Border.Resources>
                    <Style TargetType="ToggleButton">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource CardRadius.Control}"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Border x:Name="StateOverlay"
                                                    IsHitTestVisible="False"
                                                    Background="Transparent"
                                                    CornerRadius="{StaticResource CardRadius.Control}"/>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource CardInteractiveSelectedBrush}"/>
                                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource CardSelectionBorderBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CardInteractiveHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="StateOverlay" Property="Background" Value="{DynamicResource CardInteractivePressedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource CardFocusBorderBrush}"/>
                                            <Setter TargetName="ToggleBorder" Property="BorderThickness" Value="1.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <WrapPanel VerticalAlignment="Center">
                    <ComboBox x:Name="BodyFontPicker"
                              Width="118"
                              Height="24"
                              Margin="0,2,4,2"
                              VerticalContentAlignment="Center"
                              FontSize="{StaticResource CardFont.Caption}"
                              ToolTip="正文字体"
                              SelectionChanged="BodyFontPicker_SelectionChanged"/>
                    <ComboBox x:Name="BodyFontSizePicker"
                              Width="50"
                              Height="24"
                              Margin="0,2,4,2"
                              VerticalContentAlignment="Center"
                              FontSize="{StaticResource CardFont.Caption}"
                              IsEditable="True"
                              ToolTip="字号"
                              SelectionChanged="BodyFontSizePicker_SelectionChanged"
                              LostFocus="BodyFontSizePicker_LostFocus"
                              KeyDown="BodyFontSizePicker_KeyDown"/>
                    <TextBox x:Name="BodyColorEditor"
                             Width="62"
                             Height="24"
                             Margin="0,2,4,2"
                             VerticalContentAlignment="Center"
                             FontSize="{StaticResource CardFont.Caption}"
                             Foreground="{DynamicResource WidgetInputTextBrush}"
                             CaretBrush="{DynamicResource WidgetInputTextBrush}"
                             ToolTip="正文颜色 #RRGGBB"
                             LostFocus="BodyColorEditor_LostFocus"
                             KeyDown="BodyColorEditor_KeyDown"/>
                    <ToggleButton x:Name="BodyBoldToggle"
                                  Width="26"
                                  Height="24"
                                  Margin="0,2,2,2"
                                  Padding="0"
                                  FontSize="{StaticResource CardFont.Meta}"
                                  FontWeight="Bold"
                                  Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                  Background="{DynamicResource WidgetSubtleControlBrush}"
                                  BorderBrush="{DynamicResource WidgetSubtleControlBorderBrush}"
                                  Content="B"
                                  ToolTip="粗体"
                                  Click="BodyBoldToggle_Click"/>
                    <ToggleButton x:Name="BodyItalicToggle"
                                  Width="26"
                                  Height="24"
                                  Margin="0,2,4,2"
                                  Padding="0"
                                  FontSize="{StaticResource CardFont.Meta}"
                                  FontStyle="Italic"
                                  Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                  Background="{DynamicResource WidgetSubtleControlBrush}"
                                  BorderBrush="{DynamicResource WidgetSubtleControlBorderBrush}"
                                  Content="I"
                                  ToolTip="斜体"
                                  Click="BodyItalicToggle_Click"/>
                    <ToggleButton x:Name="AlignLeftToggle"
                                  Width="26"
                                  Height="24"
                                  Margin="0,2,2,2"
                                  Padding="0"
                                  FontSize="{StaticResource CardFont.Caption}"
                                  Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                  Background="{DynamicResource WidgetSubtleControlBrush}"
                                  BorderBrush="{DynamicResource WidgetSubtleControlBorderBrush}"
                                  Content="左"
                                  ToolTip="左对齐"
                                  Click="AlignmentToggle_Click"/>
                    <ToggleButton x:Name="AlignCenterToggle"
                                  Width="26"
                                  Height="24"
                                  Margin="0,2,2,2"
                                  Padding="0"
                                  FontSize="{StaticResource CardFont.Caption}"
                                  Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                  Background="{DynamicResource WidgetSubtleControlBrush}"
                                  BorderBrush="{DynamicResource WidgetSubtleControlBorderBrush}"
                                  Content="中"
                                  ToolTip="居中对齐"
                                  Click="AlignmentToggle_Click"/>
                    <ToggleButton x:Name="AlignRightToggle"
                                  Width="26"
                                  Height="24"
                                  Margin="0,2,0,2"
                                  Padding="0"
                                  FontSize="{StaticResource CardFont.Caption}"
                                  Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                  Background="{DynamicResource WidgetSubtleControlBrush}"
                                  BorderBrush="{DynamicResource WidgetSubtleControlBorderBrush}"
                                  Content="右"
                                  ToolTip="右对齐"
                                  Click="AlignmentToggle_Click"/>
                </WrapPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="10,6,10,10"
                    Padding="10,8"
                    Background="{DynamicResource WidgetNoteBodySurfaceBrush}"
                    CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                <TextBox x:Name="BodyEditor"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         CaretBrush="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                         FontSize="{StaticResource CardFont.Body}"
                         TextChanged="BodyEditor_TextChanged"
                         LostFocus="BodyEditor_LostFocus">
                    <TextBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource CardScrollViewerStyle}"/>
                    </TextBox.Resources>
                </TextBox>
            </Border>
        </Grid>
        <Border x:Name="Surface"
                Background="Transparent"
                BorderBrush="{Binding WidgetBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                BorderThickness="{Binding WidgetBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                CornerRadius="{Binding SurfaceCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                IsHitTestVisible="False"/>
    </Grid>
</local:WidgetWindowBase>
