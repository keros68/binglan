<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:BingLan.App.Windows">
    <FontFamily x:Key="SettingsIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="SettingsFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource IceInkBrush}" BorderThickness="2" CornerRadius="8"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="Margin" Value="2,24,0,10"/>
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
    </Style>
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
    </Style>

    <Style x:Key="SettingsPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Background" Value="{DynamicResource SettingsSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsSurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style TargetType="local:SettingsRow">
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="GlyphBrush" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SettingsRow">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Divider" Height="1" Margin="58,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource SettingsSurfaceBorderBrush}"/>
                        <Grid x:Name="Body" Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GlyphTile" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Background="Transparent">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource SettingsIconFont}" FontSize="17"
                                           Foreground="{DynamicResource IceMutedInkBrush}" Text="{TemplateBinding Glyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DescriptionText" Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="{TemplateBinding Description}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="">
                            <Setter TargetName="GlyphTile" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Divider" Property="Margin" Value="18,0,0,0"/>
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Body" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NestedSettingsRowStyle" TargetType="local:SettingsRow" BasedOn="{StaticResource {x:Type local:SettingsRow}}">
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Glyph" Value=" "/>
        <Setter Property="GlyphBrush" Value="Transparent"/>
        <Setter Property="MinHeight" Value="52"/>
    </Style>
    <Style TargetType="local:SettingsGroup">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SettingsGroup">
                    <Border Background="{DynamicResource SettingsSurfaceBrush}" BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Border ClipToBounds="True">
                            <ItemsPresenter Margin="0,-1,0,0"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="15,5"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource SettingsToggleOffBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource IceActionTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource IceActionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Border x:Name="Box" Width="20" Height="20" VerticalAlignment="Center" Background="{DynamicResource SettingsControlBrush}"
                                BorderBrush="{DynamicResource SettingsToggleOffBrush}" BorderThickness="1" CornerRadius="4">
                            <TextBlock x:Name="Mark" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource SettingsIconFont}"
                                       FontSize="12" Foreground="{DynamicResource IceActionTextBrush}" Text="&#xE73E;" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Border x:Name="Track" Width="42" Height="24" VerticalAlignment="Center" Background="{DynamicResource SettingsSegmentTrackBrush}"
                                BorderBrush="{DynamicResource SettingsControlBorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource SettingsToggleOffBrush}"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource IceActionTextBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Ring" Width="20" Height="20" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{DynamicResource SettingsControlBrush}" BorderBrush="{DynamicResource SettingsToggleOffBrush}" BorderThickness="1" CornerRadius="10"/>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Ring" Property="BorderThickness" Value="6"/>
                            <Setter TargetName="Ring" Property="Background" Value="{DynamicResource IceActionTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegmentHostStyle" TargetType="Border">
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource SettingsSegmentTrackBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="SegmentRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment" Padding="13,6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource SettingsSurfaceBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChoiceCardStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Card" Padding="12" Background="{DynamicResource SettingsSurfaceBrush}"
                                BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}" BorderThickness="2" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Badge" Width="22" Height="22" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{DynamicResource IceActionBrush}" CornerRadius="11" Visibility="Collapsed">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource SettingsIconFont}"
                                       FontSize="11" Foreground="{DynamicResource IceActionTextBrush}" Text="&#xE73E;"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SettingsToggleOffBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Field" Property="BorderThickness" Value="1,1,1,2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBoxToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{DynamicResource SettingsControlBrush}" BorderBrush="{DynamicResource SettingsControlBorderBrush}" BorderThickness="1" CornerRadius="7">
                        <TextBlock Margin="0,0,11,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="11" Foreground="{DynamicResource IceMutedInkBrush}" Text="&#xE70D;"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboBoxToggleStyle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="11,0,32,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0" Padding="4" Background="{DynamicResource SettingsControlBrush}"
                                    BorderBrush="{DynamicResource SettingsControlBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsSurfaceHoverBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsNavSelectedTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SliderFilledTemplate" TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource IceActionBrush}" CornerRadius="2"/></ControlTemplate>
    <ControlTemplate x:Key="SliderRemainderTemplate" TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource SettingsTrackBrush}" CornerRadius="2"/></ControlTemplate>
    <ControlTemplate x:Key="SliderThumbTemplate" TargetType="Thumb">
        <Grid Width="20" Height="20">
            <Ellipse Fill="{DynamicResource SettingsControlBrush}" Stroke="{DynamicResource SettingsControlBorderBrush}" StrokeThickness="1"/>
            <Ellipse x:Name="Core" Width="10" Height="10" Fill="{DynamicResource IceActionBrush}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Core" Property="Width" Value="12"/><Setter TargetName="Core" Property="Height" Value="12"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" Template="{StaticResource SliderFilledTemplate}"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Template="{StaticResource SliderThumbTemplate}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" Template="{StaticResource SliderRemainderTemplate}"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource SettingsToggleOffBrush}" CornerRadius="3" Opacity="0.45"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Margin="2" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource ScrollBarThumbStyle}"/></Track.Thumb></Track></ControlTemplate></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="10"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Margin="2"><Track.Thumb><Thumb Style="{StaticResource ScrollBarThumbStyle}"/></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsSurfaceHoverBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsNavSelectedTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavigationItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Item" Padding="12,0" Background="Transparent" CornerRadius="8">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource IceActionBrush}" CornerRadius="2" Visibility="Collapsed"/>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsSegmentTrackBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsNavSelectedTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavigationTileStyle" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="NavigationGlyphStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource SettingsIconFont}"/>
        <Setter Property="FontSize" Value="17"/>
    </Style>
    <Style x:Key="ButtonGlyphStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource SettingsIconFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="AppearanceTabStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Margin" Value="0,0,28,0"/>
        <Setter Property="Padding" Value="0,10"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tab" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource IceActionBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
