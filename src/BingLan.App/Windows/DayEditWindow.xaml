<Window x:Class="BingLan.App.Windows.DayEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="当日待办"
        Width="360"
        Height="430"
        MinWidth="300"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Foreground="#FF243146">
    <!-- Standalone popup: every color below is opaque on purpose. The card's
         translucent theme brushes only work over the wallpaper, while this window
         must stay readable over any desktop (K3 review, 2026-10-22). -->
    <Border CornerRadius="10"
            Background="#FFF4F6FB"
            BorderBrush="#FFC9D2E6"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Margin="10,10,10,0"
                    Padding="14,9"
                    CornerRadius="6"
                    Background="#FFB8C4EA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DateTitle"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#FF243146"/>
                    <Button Grid.Column="1"
                            AutomationProperties.Name="保存当日待办"
                            Width="30"
                            Height="28"
                            Padding="0"
                            Foreground="#FFFFFFFF"
                            BorderThickness="0"
                            FontSize="15"
                            Content="✓"
                            ToolTip="保存并关闭"
                            Click="Commit_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF4C63B6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF5E74C9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1"
                    Height="1"
                    Margin="10,8,10,0"
                    Background="#FFD8DEEC"/>
            <TextBox x:Name="Editor"
                     Grid.Row="2"
                     Margin="10,8,10,10"
                     AutomationProperties.Name="当日待办内容"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     FontSize="13"
                     Padding="10,8"
                     Background="#FFFFFFFF"
                     Foreground="#FF243146"
                     CaretBrush="#FF243146"
                     SelectionBrush="#FFB8C4EA"
                     BorderBrush="#FFD8DEEC"
                     BorderThickness="1"
                     PreviewKeyDown="Editor_PreviewKeyDown"/>
        </Grid>
    </Border>
</Window>
