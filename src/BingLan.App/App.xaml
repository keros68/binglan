<Application x:Class="BingLan.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F7FBFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8D4E7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A6B8FF"/>
        <SolidColorBrush x:Key="IcePageBrush" Color="#EEF7FD"/>
        <SolidColorBrush x:Key="IcePanelBrush" Color="#E8FFFFFF"/>
        <SolidColorBrush x:Key="IcePanelStrokeBrush" Color="#7292A9BD"/>
        <SolidColorBrush x:Key="IceInkBrush" Color="#203047"/>
        <SolidColorBrush x:Key="IceMutedInkBrush" Color="#667A8E"/>
        <SolidColorBrush x:Key="IceActionBrush" Color="#1677E8"/>
        <SolidColorBrush x:Key="IceActionTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SettingsInputBrush" Color="#F8FFFFFF"/>
        <SolidColorBrush x:Key="SettingsInputBorderBrush" Color="#8EA9BBCB"/>
        <SolidColorBrush x:Key="SettingsButtonBrush" Color="#D8E7F3FC"/>
        <SolidColorBrush x:Key="SettingsButtonBorderBrush" Color="#7292A9BD"/>
        <SolidColorBrush x:Key="SettingsNavigationBrush" Color="#BFEAF5FC"/>
        <SolidColorBrush x:Key="SettingsStrokeBrush" Color="#72AFC6D8"/>
        <SolidColorBrush x:Key="SettingsPreviewBrush" Color="#CEE4F2FA"/>
        <SolidColorBrush x:Key="SettingsCardBrush" Color="#B7FFFFFF"/>
        <SolidColorBrush x:Key="SettingsPanelBorderBrush" Color="#8FFFFFFF"/>
        <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#6FABC2D3"/>
        <SolidColorBrush x:Key="SettingsCardHoverBrush" Color="#DBFFFFFF"/>
        <SolidColorBrush x:Key="SettingsCardSelectedBrush" Color="#D7DFF0FF"/>
        <SolidColorBrush x:Key="SettingsCardSelectedTextBrush" Color="#203047"/>
        <SolidColorBrush x:Key="SettingsCardSelectedBorderBrush" Color="#A06C91C9"/>
        <SolidColorBrush x:Key="SettingsPreviewBorderBrush" Color="#7597B0C4"/>
        <SolidColorBrush x:Key="SettingsComponentNavigationBrush" Color="#CDEAF5FC"/>
        <SolidColorBrush x:Key="SettingsComponentBorderBrush" Color="#7FAFC6D8"/>
        <SolidColorBrush x:Key="SettingsBadgeBrush" Color="#63D9E8F4"/>
        <SolidColorBrush x:Key="SettingsBadgeTextBrush" Color="#516A82"/>
        <SolidColorBrush x:Key="SettingsResultBrush" Color="#AFFFFFFF"/>
        <SolidColorBrush x:Key="SettingsResultBorderBrush" Color="#7892A9BD"/>
        <SolidColorBrush x:Key="SettingsCoordinateTextBrush" Color="#718497"/>
        <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#C7FFFFFF"/>
        <SolidColorBrush x:Key="SettingsSurfaceHoverBrush" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="SettingsSurfaceBorderBrush" Color="#2230455C"/>
        <SolidColorBrush x:Key="SettingsControlBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SettingsControlHoverBrush" Color="#F1F6FB"/>
        <SolidColorBrush x:Key="SettingsControlBorderBrush" Color="#3A30455C"/>
        <SolidColorBrush x:Key="SettingsToggleOffBrush" Color="#5F7387"/>
        <SolidColorBrush x:Key="SettingsTrackBrush" Color="#3330455C"/>
        <SolidColorBrush x:Key="SettingsSegmentTrackBrush" Color="#1C30455C"/>
        <SolidColorBrush x:Key="SettingsNavSelectedBrush" Color="#2E1677E8"/>
        <SolidColorBrush x:Key="SettingsNavSelectedTextBrush" Color="#16283D"/>
        <SolidColorBrush x:Key="SettingsChoiceSelectedBrush" Color="#E6F2F8FF"/>
        <SolidColorBrush x:Key="SettingsIconBlueBrush" Color="#2F7CF6"/>
        <SolidColorBrush x:Key="SettingsIconIndigoBrush" Color="#5B5FE8"/>
        <SolidColorBrush x:Key="SettingsIconPurpleBrush" Color="#9A5BE0"/>
        <SolidColorBrush x:Key="SettingsIconPinkBrush" Color="#E5517A"/>
        <SolidColorBrush x:Key="SettingsIconOrangeBrush" Color="#F08A24"/>
        <SolidColorBrush x:Key="SettingsIconGreenBrush" Color="#2EA85A"/>
        <SolidColorBrush x:Key="SettingsIconTealBrush" Color="#16A0B0"/>
        <SolidColorBrush x:Key="SettingsIconGrayBrush" Color="#7F8C99"/>
        <SolidColorBrush x:Key="SettingsIconGlyphBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DockSurfaceBrush" Color="#D6EAF5FC"/>
        <!-- The hidden-dock handle sits alone on the wallpaper; it keeps a light blue
             of its own (the ice-blue accent lightened) so it reads on any background. -->
        <SolidColorBrush x:Key="DockHandleBrush" Color="#F2AACEF8"/>
        <SolidColorBrush x:Key="DockSurfaceBorderBrush" Color="#BFFFFFFF"/>
        <SolidColorBrush x:Key="DockActiveDotBrush" Color="#E0559EF3"/>
        <!-- The lively blue of the performance bars and download rate. -->
        <SolidColorBrush x:Key="PerformanceAccentBrush" Color="#F51EA9FF"/>
        <SolidColorBrush x:Key="DockRunningDotBrush" Color="#C21F3A55"/>
        <SolidColorBrush x:Key="WidgetItemSurfaceBrush" Color="#7AFFFFFF"/>
        <SolidColorBrush x:Key="WidgetCaretBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WidgetDefaultButtonBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="WidgetDefaultButtonBorderBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="WidgetSubtleControlBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="WidgetSubtleControlBorderBrush" Color="#52FFFFFF"/>
        <SolidColorBrush x:Key="WidgetControlBrush" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="WidgetControlBorderBrush" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="WidgetInputTextBrush" Color="#243146"/>
        <SolidColorBrush x:Key="WidgetTileHoverBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="WidgetTileFocusBrush" Color="#3DFFFFFF"/>
        <Thickness x:Key="WidgetTileBorderThickness">0</Thickness>
        <SolidColorBrush x:Key="WidgetButtonHoverBrush" Color="#32FFFFFF"/>
        <SolidColorBrush x:Key="WidgetButtonPressedBrush" Color="#48FFFFFF"/>
        <SolidColorBrush x:Key="AppearanceInkBrush" Color="#203047"/>
        <SolidColorBrush x:Key="AppearanceMutedInkBrush" Color="#607386"/>
        <SolidColorBrush x:Key="AppearanceInputBrush" Color="#58FFFFFF"/>
        <SolidColorBrush x:Key="AppearanceInputBorderBrush" Color="#4B74869A"/>
        <SolidColorBrush x:Key="AppearanceInputTextBrush" Color="#243146"/>
        <SolidColorBrush x:Key="AppearanceTrackBrush" Color="#7A34465C"/>
        <SolidColorBrush x:Key="AppearanceTrackRemainderBrush" Color="#2434465C"/>
        <SolidColorBrush x:Key="AppearanceThumbBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="AppearanceThumbBorderBrush" Color="#72869AAB"/>
        <SolidColorBrush x:Key="AppearanceDividerBrush" Color="#36748698"/>
        <SolidColorBrush x:Key="AppearanceSecondaryButtonTextBrush" Color="#34465C"/>
        <SolidColorBrush x:Key="AppearanceSecondaryButtonBrush" Color="#4CFFFFFF"/>
        <SolidColorBrush x:Key="AppearanceSecondaryButtonBorderBrush" Color="#55FFFFFF"/>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WidgetCaretBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WidgetDefaultButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WidgetDefaultButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource WidgetButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource WidgetButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Combo boxes are often taller than their text; keep the text centred and inset. -->
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,3,8,3"/>
        </Style>

        <Style x:Key="WidgetTitleStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DesktopContentTitleStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource WidgetTitleStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTitleEditing, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="Focusable" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card lists scroll with a thin bar over the content that shows only under the mouse. -->
        <Style x:Key="CardScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource PrimaryTextBrush}"
                                                    Opacity="0.35"
                                                    CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource CardScrollBarStyle}"
                                       Opacity="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetSettingsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWidgetSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- The entry shows under the mouse; keyboard users select the card by focusing it. -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Title-bar tools: always shown, or only under the mouse / while the card is selected. -->
        <Style x:Key="WidgetHeaderToolButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HeaderToolsOnHover, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/>
                        <Condition Binding="{Binding IsWidgetSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
