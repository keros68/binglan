<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BingLan</AssemblyName>
    <RootNamespace>BingLan.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\BingLan.ico</ApplicationIcon>
    <!-- 常驻桌面小组件：保留并发 GC 以将单次 Gen2 最大 STW 控制在 10 ms 内，关闭 PGO 省去插桩代码；保守内存模式通过 RuntimeHostConfigurationOption 写入 runtimeconfig.json 生效。 -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <TrayContextNativeOutput>$(BaseIntermediateOutputPath)tray-context/$(Configuration)/$(RuntimeIdentifier)</TrayContextNativeOutput>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <ProjectReference Include="../BingLan.Core/BingLan.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Brand\BingLan.ico" />
    <Resource Include="Assets\Brand\binglan-icon.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/THIRD-PARTY-NOTICES.md" Link="第三方组件说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\BingLan.Taskbar.Xaml\bin\Release\BingLan.Taskbar.Xaml.dll"
             Link="BingLan.Taskbar.Xaml.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\BingLan.Composition\bin\Release\BingLan.Composition.dll"
             Link="BingLan.Composition.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(TrayContextNativeOutput)/BingLan.TrayContextNative.dll"
             Link="BingLan.TrayContextNative.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildTaskbarXaml" BeforeTargets="PrepareForBuild"
          Inputs="..\BingLan.Taskbar.Xaml\TaskbarXaml.cpp;..\BingLan.Taskbar.Xaml\build.ps1"
          Outputs="..\BingLan.Taskbar.Xaml\bin\Release\BingLan.Taskbar.Xaml.dll">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\BingLan.Taskbar.Xaml\build.ps1&quot;" />
  </Target>
  <Target Name="BuildComposition" BeforeTargets="PrepareForBuild"
          Inputs="..\BingLan.Composition\BackdropComposition.cpp;..\BingLan.Composition\build.ps1"
          Outputs="..\BingLan.Composition\bin\Release\BingLan.Composition.dll">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\BingLan.Composition\build.ps1&quot;" />
  </Target>
  <Target Name="BuildTrayContextNative" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="Tray/native/TrayContextNative.cpp;Tray/native/TrayContextNative.h;Tray/native/build.ps1"
          Outputs="$(TrayContextNativeOutput)/BingLan.TrayContextNative.dll">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Tray/native/build.ps1&quot; -OutputDirectory &quot;$(TrayContextNativeOutput)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
