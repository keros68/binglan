<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BingLan</AssemblyName>
    <RootNamespace>BingLan.App</RootNamespace>
    <ApplicationIcon>Assets\Brand\BingLan.ico</ApplicationIcon>
    <!-- 常驻桌面小组件：非并发 GC 少一组后台 GC 线程与分配缓冲，关闭 PGO 省去插桩代码；实测私有内存约少 9 MB。 -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BingLan.Core/BingLan.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Brand\BingLan.ico" />
    <Resource Include="Assets\Brand\binglan-icon.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/THIRD-PARTY-NOTICES.md" Link="第三方组件说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\BingLan.Taskbar.Xaml\bin\Release\BingLan.Taskbar.Xaml.dll"
             Link="BingLan.Taskbar.Xaml.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildTaskbarXaml" BeforeTargets="PrepareForBuild"
          Inputs="..\BingLan.Taskbar.Xaml\TaskbarXaml.cpp;..\BingLan.Taskbar.Xaml\build.ps1"
          Outputs="..\BingLan.Taskbar.Xaml\bin\Release\BingLan.Taskbar.Xaml.dll">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\BingLan.Taskbar.Xaml\build.ps1&quot;" />
  </Target>
</Project>
