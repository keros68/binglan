<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>Program</StartupObject>
    <StartupObject Condition="'$(TrayCompatibilityPreview)' == 'true'">TrayCompatibilityPreviewProgram</StartupObject>
    <OutputType Condition="'$(TrayCompatibilityPreview)' == 'true'">WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BingLan.App/BingLan.App.csproj" />
    <ProjectReference Include="../../src/BingLan.Core/BingLan.Core.csproj" />
  </ItemGroup>
</Project>
